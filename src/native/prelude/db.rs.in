// --- Postgres runtime (async) -----------------------------------------------
//
// Only included when the program declares at least one dbcontext / entity.
// Pulls `tokio-postgres` + `deadpool-postgres` deps in the generated Cargo.toml.
//
// Notes:
//   * One global `deadpool_postgres::Pool`; per-call `pool.get().await` checks
//     out a client; `prepare_cached` reuses statements per-client.
//   * Column readers cover BOOL, INT2/4/8, FLOAT4/8, TEXT/VARCHAR/BPCHAR/NAME.
//     UUID, TIMESTAMP, JSONB surface as `V::Null` — switch to TEXT or wait for
//     the uuid/chrono follow-up.

use std::sync::OnceLock;

static DB_POOL: OnceLock<deadpool_postgres::Pool> = OnceLock::new();

fn jwc_db_connection_string() -> String {
    if let Ok(u) = std::env::var("DATABASE_URL") { return u; }
    if let Ok(u) = std::env::var("JWC_DATABASE_URL") { return u; }
    let host = std::env::var("PG_HOST").unwrap_or_else(|_| "localhost".into());
    let port = std::env::var("PG_PORT").unwrap_or_else(|_| "5432".into());
    let user = std::env::var("PG_USER").unwrap_or_else(|_| "postgres".into());
    let pwd = std::env::var("PG_PASSWORD").unwrap_or_default();
    let db = std::env::var("PG_DATABASE").unwrap_or_else(|_| "postgres".into());
    format!("host={} port={} user={} password={} dbname={}", host, port, user, pwd, db)
}

async fn jwc_db_init() {
    jwc_db_init_with(None).await
}

/// `url_override` is the argument the program passed to
/// `setConnectionString(...)`, if any.
///
/// The native `jwc_b_setConnectionString` used to take no arguments at
/// all: codegen emitted the supplied URL and the generated crate failed
/// to compile with E0061, so no native program could name its database
/// in source. The interpreter has always accepted the argument (it
/// exports it as `DATABASE_URL`), which is why this only showed up when
/// a project that ran fine under `jwc run` was built with `--native`.
async fn jwc_db_init_with(url_override: Option<String>) {
    if DB_POOL.get().is_some() { return; }
    let url = url_override.unwrap_or_else(jwc_db_connection_string);
    let pg_cfg: tokio_postgres::Config = url
        .parse()
        .unwrap_or_else(|e| panic!("setConnectionString: invalid Postgres URL: {}", e));
    let mgr_cfg = deadpool_postgres::ManagerConfig {
        recycling_method: deadpool_postgres::RecyclingMethod::Fast,
    };
    let mgr = deadpool_postgres::Manager::from_config(pg_cfg, tokio_postgres::NoTls, mgr_cfg);
    // Default 64 matches the bundled interpreter's pool tuning; override via
    // `JWC_DB_POOL_SIZE` for memory-constrained deployments.
    let max_size: usize = std::env::var("JWC_DB_POOL_SIZE")
        .ok()
        .and_then(|s| s.parse().ok())
        .unwrap_or(64);
    let pool = deadpool_postgres::Pool::builder(mgr)
        .max_size(max_size)
        .build()
        .unwrap_or_else(|e| panic!("setConnectionString: pool build failed: {}", e));
    let _ = DB_POOL.set(pool);
}

async fn jwc_b_setConnectionString(v: V) -> V {
    // A bare `setConnectionString()` keeps the env fallback chain
    // (DATABASE_URL, JWC_DATABASE_URL, then the PG_* parts). Object-literal
    // configs are not wired up here yet — rejected rather than silently
    // ignored, since ignoring the argument is what made this a bug.
    let url = match v {
        V::Null => None,
        V::Str(s) => Some(s.into_owned()),
        _ => panic!("setConnectionString(arg): native builds take a URL string or no argument"),
    };
    jwc_db_init_with(url).await;
    V::Null
}

/// snake_case spelling of the same built-in. Codegen maps a call to
/// `jwc_b_<name>` verbatim, so the alias needs a function of its own —
/// mirrors `jwc_b_set_context` beside `jwc_b_setContext`.
async fn jwc_b_set_connection_string(v: V) -> V {
    jwc_b_setConnectionString(v).await
}

async fn jwc_db_get() -> deadpool_postgres::Object {
    let pool = DB_POOL
        .get()
        .expect("DB used before setConnectionString() — call setConnectionString() in main()");
    pool.get()
        .await
        .unwrap_or_else(|e| panic!("failed to check out a DB connection: {}", e))
}

type DbParams = Vec<Box<dyn tokio_postgres::types::ToSql + Sync + Send>>;

async fn jwc_db_query(sql: &str, params: DbParams) -> Vec<V> {
    let rows = jwc_db_query_rows(sql, params).await;
    rows.iter().map(jwc_row_to_v).collect()
}

/// Run a query whose single column is a `::text`-cast JSON document and parse
/// it into a `V`. Mirrors the interpreter's eager-load / complex-select path:
/// the SQL wraps the inner select in `row_to_json(r)::text` (a `first` query
/// yields 0 or 1 rows) or `json_agg(...)::text` (a list query always yields one
/// row holding the array). No row → `V::Null`; unparseable text → `V::Null`.
#[allow(dead_code)]
async fn jwc_db_query_json(sql: &str, params: DbParams) -> V {
    let rows = jwc_db_query_rows(sql, params).await;
    match rows.first() {
        Some(row) => row
            .try_get::<_, Option<String>>(0)
            .ok()
            .flatten()
            .map(|t| jwc_from_json(&t).unwrap_or(V::Null))
            .unwrap_or(V::Null),
        None => V::Null,
    }
}

/// Raw-row variant of `jwc_db_query`. Used by the monomorphized struct
/// path (Phase 1) so generated code can map each row straight into a
/// concrete `JwcEnt_<Name>` (via the struct's `jwc_from_row` ctor)
/// without going through the dynamic `V::Object` detour. The dynamic
/// `jwc_db_query` stays as a one-line wrapper for callers that still
/// want the FxHashMap shape; per-entity callsites switch over a slice
/// at a time.
#[allow(dead_code)]
async fn jwc_db_query_rows(sql: &str, params: DbParams) -> Vec<tokio_postgres::Row> {
    let refs: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> =
        params.iter().map(|b| b.as_ref() as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    let client = jwc_db_get().await;
    let stmt = client
        .prepare_cached(sql)
        .await
        .unwrap_or_else(|e| panic!("prepare failed: {}\nSQL: {}", e, sql));
    client
        .query(&stmt, &refs)
        .await
        .unwrap_or_else(|e| panic!("query failed: {}\nSQL: {}", e, sql))
}

// --- transactions (writes.md §5) ---------------------------------------------
//
// The connection is **pinned** for the duration of the block. Every statement
// inside reads the pin: without it the `BEGIN` lands on one pooled connection
// and the statements on whichever others the pool hands out, so the block
// would commit nothing and roll back nothing. `engine::TX_CONN` is the
// interpreter's half of exactly this.

type JwcTxCell = Arc<tokio::sync::Mutex<Option<deadpool_postgres::Object>>>;

tokio::task_local! {
    static JWC_TX_CONN: JwcTxCell;
}

fn jwc_tx_pin() -> Option<JwcTxCell> {
    JWC_TX_CONN.try_with(|c| c.clone()).ok()
}

/// `BEGIN` on a connection taken out of the pool and held.
async fn jwc_tx_begin() -> Result<JwcTxCell, JwcThrown> {
    let conn = jwc_db_get().await;
    if let Err(e) = conn.batch_execute("BEGIN").await {
        panic!("BEGIN failed: {}", e);
    }
    Ok(Arc::new(tokio::sync::Mutex::new(Some(conn))))
}

/// `COMMIT` when the block left normally, `ROLLBACK` otherwise. The
/// connection returns to the pool either way, when the cell drops.
async fn jwc_tx_end(cell: JwcTxCell, commit: bool) {
    let mut held = cell.lock().await;
    if let Some(conn) = held.take() {
        if commit {
            if let Err(e) = conn.batch_execute("COMMIT").await {
                panic!("COMMIT failed: {}", e);
            }
        } else {
            let _ = conn.batch_execute("ROLLBACK").await;
        }
    }
}

// --- the statement boundary the two backends share ---------------------------
//
// `exec.rs::run_sql_with` is the interpreter's half of this. Both take the
// same `Built` from `query_sql` — the same SQL text, the same parameter list,
// the same shape — so the only thing that could differ is what happens to the
// row that comes back. This is that code, transcribed.

/// `sql::Shape`, flattened for codegen: 0 `None`, 1 `First`, 2 `Rows`.
const JWC_SHAPE_NONE: u8 = 0;
const JWC_SHAPE_FIRST: u8 = 1;
const JWC_SHAPE_ROWS: u8 = 2;

/// Run one compiled statement and shape the result exactly as
/// `exec.rs::run_sql_with` does.
///
/// `record` is `false` for a query with no `as { }` projection: the text
/// Postgres produced reaches the response verbatim, which is what keeps
/// `Raw` raw (types.md §5.1, §5.3). `true` parses it so fields can be read —
/// and reorders it, because a parsed object is a hash map and the projection
/// order is what the response promises.
async fn jwc_db_run(
    sql: &str,
    params: DbParams,
    shape: u8,
    record: bool,
    fields: &'static [&'static str],
) -> JwcResult {
    if shape == JWC_SHAPE_NONE {
        jwc_db_try_exec(sql, params).await.map_err(|e| jwc_db_error(e, sql))?;
        return Ok(V::Null);
    }
    let rows = jwc_db_try_query(sql, params).await.map_err(|e| jwc_db_error(e, sql))?;
    let text: Option<String> = match rows.first() {
        None => None,
        Some(row) => match row.try_get::<_, Option<String>>(0) {
            Ok(t) => t,
            // `exec.rs` refuses to swallow this: every statement this layer
            // sends projects a single text column, so a non-text first column
            // is a generator bug and reporting "no rows" would hide it.
            Err(e) => panic!("query returned a non-text first column: {}\nSQL: {}", e, sql),
        },
    };
    let wrap = |t: String| -> V {
        if record {
            match jwc_from_json(&t) {
                Ok(j) => jwc_reorder(j, fields),
                Err(_) => V::RawJson(t.into()),
            }
        } else {
            V::RawJson(t.into())
        }
    };
    Ok(match shape {
        JWC_SHAPE_FIRST => match text {
            None => V::Null,
            Some(t) if t == "null" => V::Null,
            Some(t) => wrap(t),
        },
        // JWC_SHAPE_ROWS
        _ => wrap(text.unwrap_or_else(|| "[]".into())),
    })
}

/// Rebuild a parsed record in projection order, recursing into arrays —
/// `exec.rs::reorder`. A field the projection names but the document does not
/// carry is dropped, not nulled, which is what `filter_map` does there.
fn jwc_reorder(v: V, order: &'static [&'static str]) -> V {
    match v {
        V::Object(m) => {
            let mut names: Vec<JwcStr> = Vec::with_capacity(order.len());
            let mut values: Vec<V> = Vec::with_capacity(order.len());
            for k in order {
                if let Some(val) = m.get(*k) {
                    names.push(Cow::Borrowed(*k));
                    values.push(val.clone());
                }
            }
            v_record(Arc::new(names), values)
        }
        V::Array(items) => v_arr(items.iter().cloned().map(|i| jwc_reorder(i, order)).collect()),
        other => other,
    }
}

/// Non-panicking `query`, so a constraint violation can become the declared
/// error it is instead of a 500.
async fn jwc_db_try_query(
    sql: &str,
    params: DbParams,
) -> Result<Vec<tokio_postgres::Row>, tokio_postgres::Error> {
    let refs: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> =
        params.iter().map(|b| b.as_ref() as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    if let Some(cell) = jwc_tx_pin() {
        let mut held = cell.lock().await;
        if let Some(conn) = held.as_mut() {
            let stmt = conn.prepare_cached(sql).await?;
            return conn.query(&stmt, &refs).await;
        }
    }
    let client = jwc_db_get().await;
    let stmt = client.prepare_cached(sql).await?;
    client.query(&stmt, &refs).await
}

/// constraint name -> declared message. Codegen emits this from the schema
/// model, the same source `db::install_messages` reads.
static JWC_CONSTRAINT_MESSAGES: &[(&str, &str)] = JWC_CONSTRAINT_MESSAGES_TABLE;

/// `db::classify` + `exec::map_db_error`, together.
///
/// errors.md §6 — a violated constraint that carries a message becomes a
/// declared error; one that does not stays a fault, which here means a panic
/// and therefore a 500.
#[cold]
fn jwc_db_error(e: tokio_postgres::Error, sql: &str) -> JwcThrown {
    let Some(db) = e.as_db_error() else {
        panic!("{}\nSQL: {}", e, sql);
    };
    let code = db.code().code();
    if code == "23503" {
        return JwcThrown {
            error: "BadRequest",
            status: 400,
            message: "referenced row does not exist".to_string(),
            body: None,
        };
    }
    if matches!(code, "23505" | "23514" | "23502") {
        let name = db.constraint().unwrap_or_default();
        if let Some((_, msg)) = JWC_CONSTRAINT_MESSAGES.iter().find(|(n, _)| *n == name) {
            // 23505 is `unique_violation`; the other two are the author's
            // own check / not-null, which are bad input, not a conflict.
            let (error, status) = if code == "23505" {
                ("Conflict", 409u16)
            } else {
                ("BadRequest", 400u16)
            };
            return JwcThrown { error, status, message: (*msg).to_string(), body: None };
        }
        panic!("constraint {} violated\nSQL: {}", name, sql);
    }
    panic!("{}\nSQL: {}", db.message(), sql);
}

async fn jwc_db_exec(sql: &str, params: DbParams) -> u64 {
    jwc_db_try_exec(sql, params)
        .await
        .unwrap_or_else(|e| panic!("{}\nSQL: {}", e, sql))
}

/// Non-panicking `execute`. A failing statement on a request path should
/// unwind into the route's panic guard and become a 500, which is what
/// `jwc_db_exec` above preserves — but the log writer's drain loop is a
/// spawned task with no guard above it, so a panic there kills the writer
/// for the rest of the process's life and every later `log_insert` silently
/// drops. Telemetry failures have to be catchable.
async fn jwc_db_try_exec(sql: &str, params: DbParams) -> Result<u64, tokio_postgres::Error> {
    let refs: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> =
        params.iter().map(|b| b.as_ref() as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    if let Some(cell) = jwc_tx_pin() {
        let mut held = cell.lock().await;
        if let Some(conn) = held.as_mut() {
            let stmt = conn.prepare_cached(sql).await?;
            return conn.execute(&stmt, &refs).await;
        }
    }
    let client = jwc_db_get().await;
    let stmt = client.prepare_cached(sql).await?;
    client.execute(&stmt, &refs).await
}

fn jwc_row_to_v(row: &tokio_postgres::Row) -> V {
    use tokio_postgres::types::Type;
    let mut m: JwcObj = JwcObj::default();
    for (i, col) in row.columns().iter().enumerate() {
        let name = col.name().to_string();
        let ty = col.type_();
        let v: V = match *ty {
            Type::BOOL => row
                .try_get::<_, Option<bool>>(i)
                .ok()
                .flatten()
                .map(V::Bool)
                .unwrap_or(V::Null),
            Type::INT2 => row
                .try_get::<_, Option<i16>>(i)
                .ok()
                .flatten()
                .map(|n| V::Int(n as i64))
                .unwrap_or(V::Null),
            Type::INT4 => row
                .try_get::<_, Option<i32>>(i)
                .ok()
                .flatten()
                .map(|n| V::Int(n as i64))
                .unwrap_or(V::Null),
            Type::INT8 => row
                .try_get::<_, Option<i64>>(i)
                .ok()
                .flatten()
                .map(V::Int)
                .unwrap_or(V::Null),
            Type::FLOAT4 => row
                .try_get::<_, Option<f32>>(i)
                .ok()
                .flatten()
                .map(|n| V::Float(n as f64))
                .unwrap_or(V::Null),
            Type::FLOAT8 => row
                .try_get::<_, Option<f64>>(i)
                .ok()
                .flatten()
                .map(V::Float)
                .unwrap_or(V::Null),
            // Without this arm a NUMERIC column fell through to `_ => V::Null`
            // below: money read back as null with no error anywhere.
            Type::NUMERIC => row
                .try_get::<_, Option<rust_decimal::Decimal>>(i)
                .ok()
                .flatten()
                .map(|d| V::Float(jwc_decimal_f64(d)))
                .unwrap_or(V::Null),
            Type::TEXT | Type::VARCHAR | Type::BPCHAR | Type::NAME => row
                .try_get::<_, Option<String>>(i)
                .ok()
                .flatten()
                .map(v_str)
                .unwrap_or(V::Null),
            // Temporal columns: surface as RFC 3339 / ISO-8601 strings so
            // user code can pass the value to `now()` comparisons or hand
            // it back through `json(...)` without losing precision. The
            // ToSql side (jwc_param_timestamp) parses these formats back
            // when the value travels in the other direction.
            Type::TIMESTAMPTZ => row
                .try_get::<_, Option<chrono::DateTime<chrono::Utc>>>(i)
                .ok()
                .flatten()
                .map(|dt| v_str(dt.to_rfc3339_opts(chrono::SecondsFormat::Secs, true)))
                .unwrap_or(V::Null),
            Type::TIMESTAMP => row
                .try_get::<_, Option<chrono::NaiveDateTime>>(i)
                .ok()
                .flatten()
                .map(|dt| v_str(dt.format("%Y-%m-%dT%H:%M:%S").to_string()))
                .unwrap_or(V::Null),
            Type::DATE => row
                .try_get::<_, Option<chrono::NaiveDate>>(i)
                .ok()
                .flatten()
                .map(|d| v_str(d.format("%Y-%m-%d").to_string()))
                .unwrap_or(V::Null),
            _ => V::Null,
        };
        m.insert(name, v);
    }
    v_obj(m)
}

// --- typed-param helpers used by codegen --------------------------------------
//
// tokio-postgres' `ToSql` impls are width-specific: `i16` only binds to
// `INT2`, `i32` only to `INT2 / INT4`, `i64` only to `INT8`. Binding the
// wrong width raises `WrongType { postgres: Int4, rust: "i64" }` at execute
// time. The codegen picks the helper that matches the declared column type
// (see `PgKind` in `native_build.rs`); this file only has to box correctly.

fn jwc_param_smallint(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i16>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0) as i16),
    }
}

fn jwc_param_int(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i32>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0) as i32),
    }
}

fn jwc_param_bigint(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i64>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0)),
    }
}

/// NUMERIC columns need a real decimal type: tokio-postgres has no
/// `f64 <-> NUMERIC` conversion, so binding a float raises `WrongType` and a
/// `decimal(p,s)` column could never be written at all.
///
/// Values arrive as `V::Float` / `V::Int` / `V::Str`; each is routed through
/// the decimal's text form so `1234.56` stays `1234.56` rather than picking up
/// the binary f64 approximation. An unparseable value binds NULL, matching how
/// the other `jwc_param_*` helpers degrade rather than panicking mid-request.
fn jwc_param_numeric(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    use std::str::FromStr;
    let text = match v {
        V::Null => return Box::new(None::<rust_decimal::Decimal>),
        V::Int(n) => n.to_string(),
        V::Float(f) => f.to_string(),
        V::Str(ref s) => s.to_string(),
        _ => return Box::new(None::<rust_decimal::Decimal>),
    };
    match rust_decimal::Decimal::from_str(&text)
        .or_else(|_| rust_decimal::Decimal::from_scientific(&text))
    {
        Ok(d) => Box::new(d),
        Err(_) => Box::new(None::<rust_decimal::Decimal>),
    }
}

/// Widen a NUMERIC read back into the interpreter's `V::Float`. The VM has no
/// decimal value type, so this matches what the interpreter path yields for
/// the same column.
fn jwc_decimal_f64(d: rust_decimal::Decimal) -> f64 {
    use std::str::FromStr;
    f64::from_str(&d.to_string()).unwrap_or(0.0)
}

fn jwc_param_float(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<f64>),
        V::Int(n) => Box::new(n as f64),
        V::Float(n) => Box::new(n),
        V::Str(s) => Box::new(s.parse::<f64>().unwrap_or(0.0)),
        _ => Box::new(0.0_f64),
    }
}

fn jwc_param_str(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<String>),
        // `Cow<'static, str>` doesn't impl `ToSql`; materialize a `String`
        // (free when the Cow was already Owned; one alloc when Borrowed).
        V::Str(s) => Box::new(s.into_owned()),
        other => Box::new(other.to_string()),
    }
}

/// Bind a JWC value into a Postgres temporal column (`timestamptz` /
/// `timestamp` / `date`). JWC carries datetimes as RFC 3339 strings, but
/// tokio-postgres' `String` ToSql impl only accepts text-like Postgres
/// types — sending one to `timestamptz` raises
/// `WrongType { postgres: Timestamptz, rust: "alloc::string::String" }`.
/// We parse the RFC 3339 / ISO 8601 / date-only string into a real
/// `chrono::DateTime<Utc>` so the with-chrono-0_4 ToSql impl binds it
/// against `TIMESTAMPTZ` natively. Empty / unparseable input falls back
/// to a NULL bind rather than panicking mid-INSERT.
fn jwc_param_timestamp(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    fn parse(s: &str) -> Option<chrono::DateTime<chrono::Utc>> {
        if let Ok(dt) = chrono::DateTime::parse_from_rfc3339(s) {
            return Some(dt.with_timezone(&chrono::Utc));
        }
        if let Ok(d) = chrono::NaiveDate::parse_from_str(s, "%Y-%m-%d") {
            let dt = d.and_hms_opt(0, 0, 0)?;
            return Some(chrono::DateTime::<chrono::Utc>::from_naive_utc_and_offset(
                dt,
                chrono::Utc,
            ));
        }
        None
    }
    match v {
        V::Null => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        V::Str(s) => match parse(&s) {
            Some(dt) => Box::new(dt),
            None => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        },
        other => match parse(&other.to_string()) {
            Some(dt) => Box::new(dt),
            None => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        },
    }
}

fn jwc_param_bool(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<bool>),
        V::Bool(b) => Box::new(b),
        other => Box::new(jwc_truthy(&other)),
    }
}

// --- raw_sql -----------------------------------------------------------------
//
// Escape hatch for SQL the typed query builder doesn't cover (json_agg,
// window functions, ad-hoc analytics). Mirrors the interpreter:
//   * SELECT / WITH → return the first column of the first row as text
//     (or V::Null if no rows). Useful for `SELECT COUNT(*)`, `SELECT json_agg(...)::text`.
//   * Anything else → run as `execute` and return the affected rowcount as int.
//
// `params_json` is a JSON-encoded array of values bound positionally as $1, $2,
// .... It's variadic in JWC source (1 or 2 args); the codegen pads the missing
// param to `V::Str("[]")`.

async fn jwc_b_raw_sql(sql: V, params_json: V) -> V {
    let sql_s: String = match sql {
        V::Str(s) => s.into_owned(),
        _ => return V::Null,
    };

    let raw: String = match params_json {
        V::Str(s) => s.into_owned(),
        V::Null => "[]".to_string(),
        _ => "[]".to_string(),
    };
    let params: Vec<V> = match jwc_from_json(&raw) {
        Ok(V::Array(a)) => Arc::unwrap_or_clone(a),
        _ => Vec::new(),
    };
    // raw_sql doesn't know the prepared statement's parameter types up
    // front, so pick the narrowest integer width the value still fits in.
    // Mirrors `runner::value_to_sql_param` so the AOT and interpreter paths
    // agree on which `INT2`/`INT4`/`INT8` column a JWC int will bind to.
    let boxed: DbParams = params
        .into_iter()
        .map(|p| match p {
            V::Int(n) => {
                if (i32::MIN as i64..=i32::MAX as i64).contains(&n) {
                    Box::new(n as i32) as Box<dyn tokio_postgres::types::ToSql + Sync + Send>
                } else {
                    Box::new(n)
                }
            }
            V::Float(_) => jwc_param_float(p),
            V::Bool(_) => jwc_param_bool(p),
            _ => jwc_param_str(p),
        })
        .collect();

    let lowered = sql_s.trim_start().to_ascii_lowercase();
    if lowered.starts_with("select") || lowered.starts_with("with") {
        let rows = jwc_db_query(&sql_s, boxed).await;
        let Some(first) = rows.into_iter().next() else {
            return V::Null;
        };
        let V::Object(m) = first else {
            return V::Null;
        };
        // First-column-as-text: V::Object now stores rows in an FxHashMap
        // (no insertion order), so explicitly pick the alphabetically-first
        // column to preserve the previous BTreeMap-driven behavior.
        // Callers that care about ordering should `SELECT col AS a` to force
        // alphabetic ordering, or use a single-column projection.
        let mut owned = Arc::unwrap_or_clone(m);
        let Some(first_key) = owned.keys().min().cloned() else {
            return V::Null;
        };
        let Some(v) = owned.remove(&first_key) else {
            return V::Null;
        };
        match v {
            V::Str(s) => V::Str(s),
            V::Int(n) => v_str(n.to_string()),
            V::Float(n) => v_str(n.to_string()),
            V::Bool(b) => v_str(b.to_string()),
            V::Null => V::Null,
            other => v_str(jwc_to_json(&other)),
        }
    } else {
        let affected = jwc_db_exec(&sql_s, boxed).await;
        V::Int(affected as i64)
    }
}

// --- buffered telemetry writes: log_insert ------------------------------------
//
// AOT mirror of `src/log_writer.rs`. Same contract, same env vars, same
// drop-on-full policy — see that module for why the shape is one consumer
// draining a bounded channel rather than a task per row.
//
// The difference from the interpreter is where typing happens: codegen
// already resolved the entity's schema and bound each column with the right
// `jwc_param_*` helper, so a queued row arrives as finished `DbParams`. The
// drain loop only has to renumber placeholders when it merges rows into one
// statement.

struct JwcLogRow {
    /// Static `INSERT INTO "t" (cols...) VALUES ` half, emitted by codegen.
    prefix: &'static str,
    /// Columns per row — how many placeholders each tuple needs.
    ncols: usize,
    params: DbParams,
}

struct JwcLogWriter {
    tx: tokio::sync::mpsc::Sender<JwcLogRow>,
    dropped: std::sync::atomic::AtomicU64,
    written: std::sync::atomic::AtomicU64,
    batches: std::sync::atomic::AtomicU64,
    failed: std::sync::atomic::AtomicU64,
    capacity: usize,
}

/// Postgres refuses a statement with more than 65535 bound parameters, so a
/// batch is chunked to fit rather than trusting `JWC_LOG_BATCH` to be small
/// enough for the entity's width. Mirrors `log_writer::MAX_BIND_PARAMS`.
const JWC_LOG_MAX_BIND_PARAMS: usize = 65_535;

static JWC_LOG: OnceLock<JwcLogWriter> = OnceLock::new();

fn jwc_log_env_usize(key: &str, default: usize) -> usize {
    std::env::var(key)
        .ok()
        .and_then(|v| v.trim().parse::<usize>().ok())
        .filter(|n| *n > 0)
        .unwrap_or(default)
}

/// Queue one row. Never suspends: this is called from request handlers,
/// including middleware `after { }` blocks that run before the response is
/// flushed. Returns `V::Bool(false)` when the row was dropped.
///
/// The writer starts on first use rather than at boot — `jwc_log_push` is
/// only ever reached from inside the tokio runtime, so `tokio::spawn` is
/// safe here and no wiring in `main` is needed.
fn jwc_log_push(prefix: &'static str, ncols: usize, params: DbParams) -> V {
    let w = JWC_LOG.get_or_init(|| {
        let queue = jwc_log_env_usize("JWC_LOG_QUEUE", 10_000);
        let batch = jwc_log_env_usize("JWC_LOG_BATCH", 2_000);
        let flush_ms = jwc_log_env_usize("JWC_LOG_FLUSH_MS", 200) as u64;
        let conc = jwc_log_env_usize("JWC_LOG_CONCURRENCY", 4);
        let (tx, rx) = tokio::sync::mpsc::channel::<JwcLogRow>(queue);
        tokio::spawn(jwc_log_drain(
            rx,
            batch,
            std::time::Duration::from_millis(flush_ms),
            conc,
        ));
        JwcLogWriter {
            tx,
            dropped: std::sync::atomic::AtomicU64::new(0),
            written: std::sync::atomic::AtomicU64::new(0),
            batches: std::sync::atomic::AtomicU64::new(0),
            failed: std::sync::atomic::AtomicU64::new(0),
            capacity: queue,
        }
    });
    match w.tx.try_send(JwcLogRow {
        prefix,
        ncols,
        params,
    }) {
        Ok(()) => V::Bool(true),
        Err(_) => {
            w.dropped
                .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
            V::Bool(false)
        }
    }
}

/// Writer counters for `/metrics`. `None` before the first push.
///
/// Only depth/capacity/dropped used to be published here, against the
/// interpreter's six. That gap is not cosmetic: `written` and `batches` are
/// what turn a drop rate into a diagnosis — rows-per-batch says whether the
/// limit is statement overhead or the database — so tuning a native build
/// meant re-running the whole thing on the interpreter to see the numbers.
struct JwcLogStats {
    depth: usize,
    capacity: usize,
    dropped: u64,
    written: u64,
    batches: u64,
    failed: u64,
}

fn jwc_log_stats() -> Option<JwcLogStats> {
    use std::sync::atomic::Ordering;
    let w = JWC_LOG.get()?;
    Some(JwcLogStats {
        depth: w.capacity.saturating_sub(w.tx.capacity()),
        capacity: w.capacity,
        dropped: w.dropped.load(Ordering::Relaxed),
        written: w.written.load(Ordering::Relaxed),
        batches: w.batches.load(Ordering::Relaxed),
        failed: w.failed.load(Ordering::Relaxed),
    })
}

fn jwc_log_note_written(n: u64) {
    if let Some(w) = JWC_LOG.get() {
        w.written.fetch_add(n, std::sync::atomic::Ordering::Relaxed);
        w.batches.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
    }
}

fn jwc_log_note_failed(n: u64) {
    if let Some(w) = JWC_LOG.get() {
        w.failed.fetch_add(n, std::sync::atomic::Ordering::Relaxed);
    }
}

async fn jwc_log_drain(
    mut rx: tokio::sync::mpsc::Receiver<JwcLogRow>,
    batch: usize,
    flush: std::time::Duration,
    concurrency: usize,
) {
    let mut pending: Vec<JwcLogRow> = Vec::with_capacity(batch);
    let mut ticker = tokio::time::interval(flush);
    // Without this a slow write is followed by a burst of catch-up ticks,
    // each flushing an empty buffer.
    ticker.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Delay);
    // Up to `concurrency` INSERTs in flight. The loop used to `await` each
    // one before looking at the channel again, so for the whole round-trip
    // nothing drained and arrivals had only the channel to sit in: the
    // writer's ceiling was one batch per round-trip, no matter how much
    // capacity the database had left. Telemetry rows carry no ordering
    // requirement between batches, so overlapping them is free.
    //
    // Bounded, not unbounded: these take connections from the same
    // `deadpool-postgres` pool the application's own queries need, and the
    // point of a single consumer was never to be slow — it was to keep
    // telemetry from crowding out real work.
    let mut inflight: tokio::task::JoinSet<()> = tokio::task::JoinSet::new();
    let concurrency = concurrency.max(1);
    loop {
        tokio::select! {
            // `recv_many`, not `recv` — see `log_writer::drain_loop`. Taking
            // one row per poll made the batch size vary with arrival timing,
            // so every INSERT carried a different number of VALUES tuples,
            // missed `prepare_cached` and left an entry nothing would reuse.
            got = rx.recv_many(&mut pending, batch) => {
                if got == 0 {
                    if !pending.is_empty() {
                        jwc_log_flush(std::mem::take(&mut pending)).await;
                    }
                    while inflight.join_next().await.is_some() {}
                    return;
                }
                if pending.len() >= batch {
                    while inflight.len() >= concurrency {
                        let _ = inflight.join_next().await;
                    }
                    let rows = std::mem::replace(&mut pending, Vec::with_capacity(batch));
                    inflight.spawn(jwc_log_flush(rows));
                }
            }
            _ = ticker.tick() => {
                if !pending.is_empty() {
                    while inflight.len() >= concurrency {
                        let _ = inflight.join_next().await;
                    }
                    let rows = std::mem::replace(&mut pending, Vec::with_capacity(batch));
                    inflight.spawn(jwc_log_flush(rows));
                }
            }
            // Reap finished writes so `inflight.len()` reflects reality
            // rather than growing until the next flush forces a join.
            Some(_) = inflight.join_next(), if !inflight.is_empty() => {}
        }
    }
}

/// Group by statement prefix, then write one multi-row INSERT per group.
/// Rows from two different entities cannot share a `VALUES` list, and the
/// prefix is what distinguishes them.
async fn jwc_log_flush(pending: Vec<JwcLogRow>) {
    if pending.is_empty() {
        return;
    }
    let mut groups: std::collections::HashMap<(&'static str, usize), Vec<DbParams>> =
        std::collections::HashMap::new();
    for row in pending {
        groups
            .entry((row.prefix, row.ncols))
            .or_default()
            .push(row.params);
    }
    for ((prefix, ncols), rows) in groups {
        // Chunk to Postgres's bound-parameter ceiling. Without this,
        // `JWC_LOG_BATCH=5000` against a 20-column entity builds a 100k
        // parameter statement the server refuses, and the whole batch is
        // lost at execute time rather than at configuration time.
        let per_chunk = (JWC_LOG_MAX_BIND_PARAMS / ncols.max(1)).max(1);
        let mut rows = rows;
        while !rows.is_empty() {
            let n = per_chunk.min(rows.len());
            let mut sql = String::from(prefix);
            let mut flat: DbParams = Vec::with_capacity(n * ncols);
            let mut next = 1usize;
            for (i, params) in rows.drain(..n).enumerate() {
                if i > 0 {
                    sql.push_str(", ");
                }
                sql.push('(');
                for c in 0..ncols {
                    if c > 0 {
                        sql.push_str(", ");
                    }
                    sql.push_str(&format!("${}", next));
                    next += 1;
                }
                sql.push(')');
                flat.extend(params);
            }
            sql.push(';');
            // `jwc_db_exec` already reports its own failures; a telemetry
            // write has no caller to propagate to and must never take the
            // process down.
            match jwc_db_try_exec(&sql, flat).await {
                Ok(_) => jwc_log_note_written(n as u64),
                Err(e) => {
                    eprintln!("[JWC] log writer: {} row(s) failed: {}", n, e);
                    jwc_log_note_failed(n as u64);
                }
            }
        }
    }
}

// --- /metrics ----------------------------------------------------------------
//
// Native builds used to serve nothing here: `jwc_log_stats` existed but had
// no caller, and codegen registered no route, so `curl /metrics` fell through
// to the catch-all. That made `jwc_log_dropped_total` — the documented way to
// tell that the buffered writer is falling behind — visible only under the
// interpreter, which is not the path anyone deploys.
//
// Narrower than the interpreter's endpoint on purpose: this serves what the
// generated crate can actually observe, which is the log writer and the
// Postgres pool. Request counters live in `server.rs`'s `ServerMetrics` and
// have no native counterpart yet.
//
// Registered only when the program has no `/metrics` route of its own —
// mirrors `server.rs::route_owned_by_user`, so a user endpoint always wins.

/// `serve.rs::metrics_text`, gauge for gauge and in the same order — the
/// two backends have to answer `/metrics` alike or a dashboard built
/// against one silently loses series against the other.
///
/// Gauges only. A counter would need per-request bookkeeping on the hot
/// path, and what the soak criterion asks about is the pool.
fn jwc_metrics_body() -> String {
    let mut out = String::new();

    if let Some(pool) = DB_POOL.get() {
        let st = pool.status();
        out.push_str(
            "# HELP jwc_db_pool_size Connections the pool currently holds.\n\
             # TYPE jwc_db_pool_size gauge\n",
        );
        out.push_str(&format!("jwc_db_pool_size {}\n", st.size));
        out.push_str(
            "# HELP jwc_db_pool_available Connections idle and checkout-ready.\n\
             # TYPE jwc_db_pool_available gauge\n",
        );
        out.push_str(&format!("jwc_db_pool_available {}\n", st.available));
        out.push_str(
            "# HELP jwc_db_pool_max_size Ceiling from JWC_DB_POOL_SIZE.\n\
             # TYPE jwc_db_pool_max_size gauge\n",
        );
        out.push_str(&format!("jwc_db_pool_max_size {}\n", st.max_size));
        // The leak signal. A pool that never returns a connection shows up
        // here as `available` pinned at 0 while `waiting` climbs, which is
        // exactly the shape `soak/analyze.py` is looking for.
        out.push_str(
            "# HELP jwc_db_pool_waiting Tasks blocked waiting for a connection.\n\
             # TYPE jwc_db_pool_waiting gauge\n",
        );
        out.push_str(&format!("jwc_db_pool_waiting {}\n", st.waiting));
    }

    // Redis lives in its own prelude, which is only concatenated for
    // programs that call a `redis_*` built-in. Codegen emits
    // `jwc_redis_metrics_hook` either way — forwarding to the real thing
    // when that prelude is present, returning empty when it is not.
    //
    // Without this the endpoint reported `jwc_db_pool_*` and silently
    // nothing for Redis, which is worse than not reporting at all: the
    // absence reads as "Redis is not configured" when it may just be
    // unimplemented. That misreading cost a production debugging session.
    out.push_str(&jwc_redis_metrics_hook());

    out.push_str(
        "# HELP jwc_routes Declared routes.\n\
         # TYPE jwc_routes gauge\n",
    );
    out.push_str(&format!("jwc_routes {}\n", JWC_ROUTE_COUNT));

    // Native-only, and absent unless a log writer is actually running: the
    // buffered writer has no interpreter counterpart, so emitting these
    // unconditionally would be a series the other backend never produces.
    if let Some(s) = jwc_log_stats() {
        out.push_str("# HELP jwc_log_queue_depth Rows queued for the buffered log writer.\n");
        out.push_str("# TYPE jwc_log_queue_depth gauge\n");
        out.push_str(&format!("jwc_log_queue_depth {}\n", s.depth));
        out.push_str("# HELP jwc_log_queue_capacity Channel ceiling (JWC_LOG_QUEUE).\n");
        out.push_str("# TYPE jwc_log_queue_capacity gauge\n");
        out.push_str(&format!("jwc_log_queue_capacity {}\n", s.capacity));
        out.push_str("# HELP jwc_log_dropped_total Rows discarded because the channel was full.\n");
        out.push_str("# TYPE jwc_log_dropped_total counter\n");
        out.push_str(&format!("jwc_log_dropped_total {}\n", s.dropped));
        out.push_str("# HELP jwc_log_written_total Rows successfully written by the log writer.\n");
        out.push_str("# TYPE jwc_log_written_total counter\n");
        out.push_str(&format!("jwc_log_written_total {}\n", s.written));
        out.push_str("# HELP jwc_log_failed_total Rows the log writer could not persist.\n");
        out.push_str("# TYPE jwc_log_failed_total counter\n");
        out.push_str(&format!("jwc_log_failed_total {}\n", s.failed));
        out.push_str("# HELP jwc_log_batches_total Batch INSERTs issued by the log writer.\n");
        out.push_str("# TYPE jwc_log_batches_total counter\n");
        out.push_str(&format!("jwc_log_batches_total {}\n", s.batches));
    }

    out
}

fn jwc_metrics_route() -> std::pin::Pin<Box<dyn std::future::Future<Output = V> + Send>> {
    Box::pin(async move {
        make_response(
            200,
            jwc_metrics_body(),
            "text/plain; version=0.0.4; charset=utf-8",
        )
    })
}

// --- keyset pagination (queries.md §9) ---------------------------------------
//
// `exec::page_envelope` + `exec::read_cursor` + `cursor::{encode, decode}`,
// transcribed. The cursor is HMAC-signed: unsigned, it is a predicate the
// caller writes and nobody checks.

const JWC_CURSOR_VERSION: &str = "v1";

/// `server { cursor_secret }`. Codegen emits the reader, because the value
/// may be `env("CURSOR_SECRET")` and that is a run-time read.
fn jwc_cursor_secret() -> String {
    jwc_cursor_secret_source().to_string()
}

fn jwc_cursor_encode(keys: &[Option<String>]) -> String {
    use base64::Engine;
    let payload = serde_json::to_string(keys).unwrap_or_else(|_| "[]".to_string());
    let body = format!(
        "{}.{}",
        JWC_CURSOR_VERSION,
        base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(payload)
    );
    let mac = jwc_hmac_sha256_hex(&jwc_cursor_secret(), &body);
    format!("{}.{}", body, mac)
}

/// The key values a cursor carries, or `None` when it is not ours.
///
/// Every failure is the same answer — a malformed cursor and a forged one
/// are the same event from the caller's side, and telling them apart is
/// information the caller has no use for.
fn jwc_cursor_decode(cursor: &str) -> Option<Vec<Option<String>>> {
    use base64::Engine;
    let (body, mac) = cursor.rsplit_once('.')?;
    let expected = jwc_hmac_sha256_hex(&jwc_cursor_secret(), body);
    // Not a `==`: the MAC is the only thing between a caller and an
    // arbitrary predicate, so how long the check takes must not depend on
    // how much of it was right.
    if !jwc_cursor_ct_eq(mac.as_bytes(), expected.as_bytes()) {
        return None;
    }
    let (version, payload) = body.split_once('.')?;
    if version != JWC_CURSOR_VERSION {
        return None;
    }
    let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(payload).ok()?;
    serde_json::from_slice(&bytes).ok()
}

fn jwc_cursor_ct_eq(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut diff = 0u8;
    for (x, y) in a.iter().zip(b) {
        diff |= x ^ y;
    }
    diff == 0
}

/// The cursor's key values, ready to bind. An absent or empty cursor is the
/// first page; one that does not verify is a `BadRequest`, not a 500 and not
/// a silently-empty page — it is client input, and the only honest answer is
/// that it is not a cursor we issued.
fn jwc_cursor_binds(v: &V, arity: usize) -> Result<Vec<Option<String>>, JwcThrown> {
    let Some(text) = jwc_str_view(v) else {
        return Ok(vec![None; arity]);
    };
    if text.is_empty() {
        return Ok(vec![None; arity]);
    }
    match jwc_cursor_decode(text) {
        Some(keys) => Ok(keys),
        None => Err(JwcThrown {
            error: "BadRequest",
            status: 400,
            message: "kursor yaroqsiz".to_string(),
            body: None,
        }),
    }
}

/// The last ordering tuple on this page — where the next one starts.
fn jwc_cursor_last_tuple(keys: &str) -> Option<Vec<Option<String>>> {
    let parsed: serde_json::Value = serde_json::from_str(keys).ok()?;
    let last = parsed.as_array()?.last()?;
    Some(
        last.as_array()?
            .iter()
            .map(|v| v.as_str().map(|s| s.to_string()))
            .collect(),
    )
}

/// `queries.md §9.3` — `{items, next, has_more}`.
///
/// `items` is spliced, not rebuilt: it reaches the response as the text
/// Postgres produced, which is what makes raw survive the envelope
/// (types.md §5.4).
async fn jwc_db_page(
    sql: &str,
    params: DbParams,
    raw_items: bool,
    fields: &'static [&'static str],
) -> JwcResult {
    let rows = jwc_db_try_query(sql, params).await.map_err(|e| jwc_db_error(e, sql))?;
    let (items, keys, has_more) = match rows.first() {
        None => ("[]".to_string(), "[]".to_string(), false),
        Some(r) => (
            r.try_get::<_, Option<String>>(0).unwrap_or(None).unwrap_or_else(|| "[]".into()),
            r.try_get::<_, Option<String>>(1).unwrap_or(None).unwrap_or_else(|| "[]".into()),
            r.try_get::<_, Option<bool>>(2).unwrap_or(None).unwrap_or(false),
        ),
    };

    // With no next page there is no cursor: a caller that follows `next`
    // until it is null cannot loop.
    let next = if has_more {
        match jwc_cursor_last_tuple(&keys) {
            Some(t) => v_str(jwc_cursor_encode(&t)),
            None => V::Null,
        }
    } else {
        V::Null
    };

    let items = if raw_items {
        V::RawJson(items.into())
    } else {
        match jwc_from_json(&items) {
            Ok(j) => jwc_reorder(j, fields),
            Err(_) => V::RawJson(items.into()),
        }
    };

    let mut names: Vec<JwcStr> = Vec::with_capacity(3);
    names.push(Cow::Borrowed("items"));
    names.push(Cow::Borrowed("next"));
    names.push(Cow::Borrowed("has_more"));
    Ok(v_record(Arc::new(names), vec![items, next, V::Bool(has_more)]))
}
