// Generated by jwc build --native. DO NOT EDIT.
#![allow(
    unused_imports,
    dead_code,
    unused_variables,
    unused_mut,
    unused_assignments,
    unreachable_code,
    non_snake_case,
    non_camel_case_types,
    clippy::all
)]

// Phase A4 of PERF_PLAN.md: drop the default Windows `HeapAlloc` /
// `HeapFree` path — it's the single biggest source of allocator churn
// on this target. `mimalloc` is a drop-in replacement (no API surface,
// just `#[global_allocator]`) that wins ~30-50% on hot allocate /
// free loops compared to the system allocator on Windows.
// Linux / macOS keep the system allocator (glibc/jemalloc-on-darwin
// are already competitive on this workload).
#[cfg(windows)]
#[global_allocator]
static GLOBAL: mimalloc::MiMalloc = mimalloc::MiMalloc;

use std::borrow::Cow;
use std::collections::BTreeMap;
use std::fmt;
use std::sync::Arc;

use rustc_hash::FxHashMap;

/// Phase A3 of PERF_PLAN.md: `V::Str` payload is `Cow<'static, str>` so
/// codegen can emit `Cow::Borrowed(&'static str)` for source literals
/// (zero per-request allocation), while dynamic strings still flow through
/// `Cow::Owned(String)`. Clone is a pointer copy for the borrowed case;
/// `into_owned()` is the escape hatch when a `String` is genuinely needed.
type JwcStr = Cow<'static, str>;

#[inline]
fn v_str(s: impl Into<JwcStr>) -> V {
    V::Str(s.into())
}

/// Hot-path `V::Object` payload. `FxHashMap` (fxhash, no DoS resistance —
/// fine for AOT'd source-literal keys) buys O(1) lookup and ~3× faster
/// hashing vs `siphash`. Insertion order is intentionally not preserved
/// here; `jwc_write_json` sorts keys at serialization time so output stays
/// deterministic, and `raw_sql` picks the alphabetically-first column.
type JwcObj = FxHashMap<String, V>;
type JwcArr = Vec<V>;

/// Phase A2 of PERF_PLAN.md: array/object payloads live behind `Arc<…>`,
/// so `Clone V` is a refcount bump instead of a deep copy of the whole
/// subtree. Mutating sites use `Arc::make_mut` (copy-on-write); consuming
/// sites use `Arc::unwrap_or_clone`.
#[inline]
fn v_arr(items: JwcArr) -> V {
    V::Array(Arc::new(items))
}

#[inline]
fn v_obj(m: JwcObj) -> V {
    V::Object(Arc::new(m))
}

/// Phase 1 [1.0-blocker] — `V::Record` constructor. The `field_names` Arc is
/// shared across every Record built with the same shape (object literals of
/// identical key sets, monomorphized entity instances, DB row batches). One
/// allocation for the schema layout + a per-row `values` Vec, instead of one
/// FxHashMap per construction. Field access is `field_names.iter().position(...)`
/// then `values[i]` — O(N) but linear scan beats hashing for the small N
/// (2-10) of typical literal shapes.
#[inline]
fn v_record(field_names: Arc<Vec<JwcStr>>, values: Vec<V>) -> V {
    V::Record { field_names, values: Arc::new(values) }
}

/// Load a `.env` from the current working directory or the binary's directory.
/// Mirrors `project::load_dotenv` so a standalone native binary picks up the
/// same env layout the `jwc run`/`jwc serve` CLI does.
fn jwc_load_dotenv() {
    let candidates: Vec<std::path::PathBuf> = {
        let mut v = Vec::new();
        if let Ok(cwd) = std::env::current_dir() {
            v.push(cwd.join(".env"));
        }
        if let Ok(exe) = std::env::current_exe() {
            // bin/release/app.exe → walk up to project root
            if let Some(parent) = exe.parent() {
                v.push(parent.join(".env"));
                if let Some(g) = parent.parent() {
                    v.push(g.join(".env"));
                    if let Some(gg) = g.parent() {
                        v.push(gg.join(".env"));
                    }
                }
            }
        }
        v
    };
    let mut content = None;
    for c in &candidates {
        if let Ok(s) = std::fs::read_to_string(c) {
            content = Some(s);
            break;
        }
    }
    let Some(content) = content else { return };
    for line in content.lines() {
        let line = line.trim();
        if line.is_empty() || line.starts_with('#') { continue; }
        if let Some((k, v)) = line.split_once('=') {
            let k = k.trim();
            let v = v.trim();
            if std::env::var(k).is_err() {
                std::env::set_var(k, v);
            }
        }
    }
    if std::env::var("DATABASE_URL").is_err() {
        if let (Ok(u), Ok(p), Ok(h), Ok(port), Ok(d)) = (
            std::env::var("PG_USER"),
            std::env::var("PG_PASSWORD"),
            std::env::var("PG_HOST"),
            std::env::var("PG_PORT"),
            std::env::var("PG_DATABASE"),
        ) {
            std::env::set_var(
                "DATABASE_URL",
                format!("postgresql://{}:{}@{}:{}/{}", u, p, h, port, d),
            );
        }
    }
}

#[derive(Clone, Debug)]
enum V {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(JwcStr),
    Array(Arc<JwcArr>),
    Object(Arc<JwcObj>),
    /// Phase 1.6 — opaque, already-encoded JSON fragment. `jwc_write_json`
    /// writes the inner bytes verbatim instead of re-encoding; every other
    /// V match arm treats it like a `V::Str` (length is the byte count,
    /// truthy iff non-empty, etc.). Lets `emit_db_select` produce a
    /// `V::Array` of `V::RawJson` rows for simple selects so JSON
    /// serialisation skips the `V::Object` FxHashMap entirely. That's
    /// what closes the /json-large RPS gap the production-readiness
    /// plan calls out as the Phase 1 1.0-blocker.
    RawJson(JwcStr),
    /// Phase 1 [1.0-blocker] mirror of the interpreter's `Value::Record`.
    /// `field_names` is shared across same-shape rows (one alloc for the
    /// schema layout, per-row `values` Vec). Linear-scan field access beats
    /// hashing for the small N (2-10) of typical literal shapes. Codegen
    /// emits one `__jwc_shape_<N>()` getter per distinct key set in the
    /// program and reuses it across every literal site.
    Record {
        field_names: Arc<Vec<JwcStr>>,
        values: Arc<Vec<V>>,
    },
}

impl fmt::Display for V {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            V::Null => write!(f, "null"),
            V::Bool(b) => write!(f, "{}", b),
            V::Int(n) => write!(f, "{}", n),
            V::Float(n) => write!(f, "{}", n),
            V::Str(s) => write!(f, "{}", s),
            V::RawJson(s) => write!(f, "{}", s),
            V::Array(_) | V::Object(_) | V::Record { .. } => write!(f, "{}", jwc_to_json(self)),
        }
    }
}

fn jwc_print(v: V) {
    println!("{}", v);
}

/// `console.write(s)` / `console.error(s)` — immediate write, no newline.
///
/// Synchronous on purpose. `tokio::io::stdout()` keeps its own buffer, so
/// interleaving it with `jwc_print`'s `println!` would reorder output
/// *within* a native binary — strictly worse than the cross-backend
/// ordering difference we already document. This uses the same
/// `std::io::Stdout` handle `println!` does, so the two interleave
/// correctly here.
///
/// They still do NOT interleave under `jwc run`, where `print` buffers into
/// `Vm::output` and flushes after `main()` returns. See
/// `docs/docs/stdlib/io.md`.
fn jwc_b_console_write(v: V) -> V {
    jwc_console_out(v, false, false)
}

/// `write` plus a trailing newline — the common case, and the one that
/// would otherwise tempt you back to `print` and its buffer.
fn jwc_b_console_writeln(v: V) -> V {
    jwc_console_out(v, false, true)
}

fn jwc_b_console_error(v: V) -> V {
    jwc_console_out(v, true, false)
}

fn jwc_console_out(v: V, to_stderr: bool, newline: bool) -> V {
    use std::io::Write;
    let mut s = v.to_string();
    if newline {
        s.push('\n');
    }
    let res = if to_stderr {
        let stream = std::io::stderr();
        let mut lock = stream.lock();
        lock.write_all(s.as_bytes()).and_then(|()| lock.flush())
    } else {
        let stream = std::io::stdout();
        let mut lock = stream.lock();
        lock.write_all(s.as_bytes()).and_then(|()| lock.flush())
    };
    if let Err(e) = res {
        let op = match (to_stderr, newline) {
            (true, _) => "console.error",
            (false, true) => "console.writeln",
            (false, false) => "console.write",
        };
        jwc_io_panic(op, "", e);
    }
    V::Null
}

/// Panic with the exact JWC error kind as a literal prefix.
///
/// `jwc_classify_error` prefix-matches this marker BEFORE its lowercase
/// substring scan, so the kind is decided by the errno and never by the
/// path text — `file.read("/var/backups/app.sql")` must not come back as
/// `DbError`. `jwc_error_value` surfaces the whole string as `e.message`,
/// which is why the operation and subject stay in it.
#[cold]
#[inline(never)]
fn jwc_io_panic(op: &str, subject: &str, e: std::io::Error) -> ! {
    use std::io::ErrorKind;
    let kind = match e.kind() {
        ErrorKind::NotFound => "IoError.NotFound",
        ErrorKind::PermissionDenied => "IoError.PermissionDenied",
        ErrorKind::AlreadyExists => "IoError.AlreadyExists",
        _ => "IoError",
    };
    panic!("{}: {}({}) failed: {}", kind, op, subject, e);
}

/// `console.read()` — one line from stdin, trailing `\r?\n` stripped,
/// `V::Null` at EOF.
///
/// `spawn_blocking` over `std::io::stdin()` rather than
/// `tokio::io::stdin()`: the tokio handle is fresh per call, so a per-call
/// `BufReader` drops whatever it read ahead past the newline, and
/// consecutive calls silently lose input. `std::io::stdin()` is a
/// process-global buffered handle.
async fn jwc_b_console_read() -> V {
    let joined = tokio::task::spawn_blocking(|| {
        use std::io::BufRead;
        let mut line = String::new();
        std::io::stdin().lock().read_line(&mut line).map(|n| (n, line))
    })
    .await;
    let read = match joined {
        Ok(r) => r,
        Err(e) => panic!("IoError: console.read() task failed: {}", e),
    };
    let (n, mut line) = match read {
        Ok(v) => v,
        Err(e) => jwc_io_panic("console.read", "", e),
    };
    if n == 0 {
        return V::Null;
    }
    if line.ends_with('\n') {
        line.pop();
        if line.ends_with('\r') {
            line.pop();
        }
    }
    v_str(line)
}

// --- file.* / directory.* -------------------------------------------------
//
// Paths reach the OS verbatim; see `docs/spec/threat-model.md`. Errors
// panic (caught by the route wrapper and by `try`/`catch` codegen) rather
// than returning an in-band error string the way `jwc_b_http_get` does —
// an error string would ship as a 200 response body, and a panic is what
// makes native `catch (e: IoError)` work at all.

fn jwc_io_path(v: V, op: &str) -> JwcStr {
    match v {
        V::Str(s) => s,
        other => panic!("{}() path must be a string, got {:?}", op, other),
    }
}

async fn jwc_b_file_read(path: V) -> V {
    let p = jwc_io_path(path, "file.read");
    match tokio::fs::read_to_string(p.as_ref()).await {
        Ok(contents) => v_str(contents),
        Err(e) => jwc_io_panic("file.read", p.as_ref(), e),
    }
}

async fn jwc_b_file_write(path: V, content: V) -> V {
    let p = jwc_io_path(path, "file.write");
    let body = content.to_string();
    match tokio::fs::write(p.as_ref(), body.as_bytes()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("file.write", p.as_ref(), e),
    }
}

async fn jwc_b_file_append(path: V, content: V) -> V {
    use tokio::io::AsyncWriteExt;
    let p = jwc_io_path(path, "file.append");
    let body = content.to_string();
    let mut f = match tokio::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(p.as_ref())
        .await
    {
        Ok(f) => f,
        Err(e) => jwc_io_panic("file.append", p.as_ref(), e),
    };
    match f.write_all(body.as_bytes()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("file.append", p.as_ref(), e),
    }
}

/// `file.exists` is true only for a regular file, `directory.exists` only
/// for a directory. Neither raises: a permission error on the parent yields
/// `false`, so `false` means "not visible to this process as that thing".
async fn jwc_b_file_exists(path: V) -> V {
    let p = jwc_io_path(path, "file.exists");
    let found = match tokio::fs::metadata(p.as_ref()).await {
        Ok(md) => md.is_file(),
        Err(_) => false,
    };
    V::Bool(found)
}

async fn jwc_b_directory_exists(path: V) -> V {
    let p = jwc_io_path(path, "directory.exists");
    let found = match tokio::fs::metadata(p.as_ref()).await {
        Ok(md) => md.is_dir(),
        Err(_) => false,
    };
    V::Bool(found)
}

async fn jwc_b_file_delete(path: V) -> V {
    let p = jwc_io_path(path, "file.delete");
    match tokio::fs::remove_file(p.as_ref()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("file.delete", p.as_ref(), e),
    }
}

async fn jwc_b_file_copy(src: V, dst: V) -> V {
    let s = jwc_io_path(src, "file.copy");
    let d = jwc_io_path(dst, "file.copy");
    match tokio::fs::copy(s.as_ref(), d.as_ref()).await {
        Ok(_) => V::Null,
        Err(e) => jwc_io_panic("file.copy", s.as_ref(), e),
    }
}

/// `rename` returns `EXDEV` across filesystems (a `/tmp` → volume move, an
/// overlayfs → bind-mount move — routine in containers) and on Windows
/// fails when `dst` exists. The copy fallback is gated so a genuine source
/// problem isn't papered over as a confusing copy error. This is what `mv`
/// does.
async fn jwc_b_file_move(src: V, dst: V) -> V {
    let s = jwc_io_path(src, "file.move");
    let d = jwc_io_path(dst, "file.move");
    match tokio::fs::rename(s.as_ref(), d.as_ref()).await {
        Ok(()) => return V::Null,
        Err(e)
            if matches!(
                e.kind(),
                std::io::ErrorKind::NotFound | std::io::ErrorKind::PermissionDenied
            ) =>
        {
            jwc_io_panic("file.move", s.as_ref(), e)
        }
        Err(_) => {}
    }
    if let Err(e) = tokio::fs::copy(s.as_ref(), d.as_ref()).await {
        jwc_io_panic("file.move", s.as_ref(), e);
    }
    match tokio::fs::remove_file(s.as_ref()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("file.move", s.as_ref(), e),
    }
}

async fn jwc_b_file_size(path: V) -> V {
    let p = jwc_io_path(path, "file.size");
    match tokio::fs::metadata(p.as_ref()).await {
        Ok(md) => V::Int(md.len() as i64),
        Err(e) => jwc_io_panic("file.size", p.as_ref(), e),
    }
}

/// A trailing newline does NOT produce a final empty element — a
/// well-formed text file ends with `\n`, and surfacing that as a blank line
/// makes every `for` over the result off by one. `str::lines` handles both
/// `\n` and `\r\n`.
async fn jwc_b_file_lines(path: V) -> V {
    let p = jwc_io_path(path, "file.lines");
    match tokio::fs::read_to_string(p.as_ref()).await {
        // `to_string()` per line is required, not sloppy: `JwcStr` is
        // `Cow<'static, str>`, and `lines()` borrows from `contents`, which
        // dies at the end of this function.
        Ok(contents) => v_arr(
            contents
                .lines()
                .map(|l| v_str(l.to_string()))
                .collect::<JwcArr>(),
        ),
        Err(e) => jwc_io_panic("file.lines", p.as_ref(), e),
    }
}

/// Entry names, sorted. The sort is part of the contract, not an
/// implementation detail: ext4 hands entries back in hash order, so an
/// unsorted listing makes every golden test flaky and every generated
/// listing non-reproducible.
async fn jwc_b_directory_list(path: V) -> V {
    let p = jwc_io_path(path, "directory.list");
    let mut rd = match tokio::fs::read_dir(p.as_ref()).await {
        Ok(rd) => rd,
        Err(e) => jwc_io_panic("directory.list", p.as_ref(), e),
    };
    let mut names: Vec<String> = Vec::new();
    loop {
        match rd.next_entry().await {
            Ok(Some(entry)) => names.push(entry.file_name().to_string_lossy().into_owned()),
            Ok(None) => break,
            Err(e) => jwc_io_panic("directory.list", p.as_ref(), e),
        }
    }
    names.sort();
    v_arr(names.into_iter().map(v_str).collect::<JwcArr>())
}

/// Recursive and idempotent. Plain `create_dir` fails on the most common
/// call (`directory.create("out/reports")` where `out` is absent) and again
/// when the target exists.
async fn jwc_b_directory_create(path: V) -> V {
    let p = jwc_io_path(path, "directory.create");
    match tokio::fs::create_dir_all(p.as_ref()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("directory.create", p.as_ref(), e),
    }
}

/// NOT recursive. Paths here are unrestricted by design, and a recursive
/// variant would make `directory.delete(query_param("d"))` a one-call
/// `rm -rf`. The asymmetry with the recursive `directory.create` is
/// deliberate: creating too much is recoverable, deleting too much is not.
async fn jwc_b_directory_delete(path: V) -> V {
    let p = jwc_io_path(path, "directory.delete");
    match tokio::fs::remove_dir(p.as_ref()).await {
        Ok(()) => V::Null,
        Err(e) => jwc_io_panic("directory.delete", p.as_ref(), e),
    }
}

fn jwc_truthy(v: &V) -> bool {
    match v {
        V::Null => false,
        V::Bool(b) => *b,
        V::Int(n) => *n != 0,
        V::Float(n) => *n != 0.0,
        V::Str(s) => !s.is_empty(),
        V::RawJson(s) => !s.is_empty(),
        V::Array(a) => !a.is_empty(),
        V::Object(o) => !o.is_empty(),
        V::Record { values, .. } => !values.is_empty(),
    }
}

// --- non-local return slot ---------------------------------------------------
//
// `try { ... } catch (e) { ... }` and `transaction { ... }` wrap their body in
// a `std::panic::catch_unwind` closure. A naked `return X;` inside that closure
// would only exit the closure, not the enclosing function. We park the value
// in a thread-local and the closing wrapper drains it.

use std::cell::RefCell;
thread_local! {
    static JWC_RETURN_SLOT: RefCell<Option<V>> = const { RefCell::new(None) };
}

fn jwc_set_return(v: V) {
    JWC_RETURN_SLOT.with(|s| *s.borrow_mut() = Some(v));
}

fn jwc_has_return() -> bool {
    JWC_RETURN_SLOT.with(|s| s.borrow().is_some())
}

fn jwc_take_return() -> Option<V> {
    JWC_RETURN_SLOT.with(|s| s.borrow_mut().take())
}

// Classify an error message string into one of the well-known JWC error
// kinds — mirrors `runner::classify_jwc_error` for the native AOT path.
//
// `#[cold]` (Phase A6 of PERF_PLAN.md): only reached when a route handler
// has actually panicked, so we want LLVM to lay it out away from the hot
// success path and avoid speculating into its `to_ascii_lowercase()` +
// `contains()` chain when no error is in flight.
#[cold]
#[inline(never)]
fn jwc_classify_error(msg: &str) -> &'static str {
    // The I/O builtins panic with the exact kind as a literal prefix
    // (`"IoError.NotFound: file.read(...) failed: ..."`), and this is
    // checked on the RAW message before the lowercase substring scan below.
    // That ordering is load-bearing: a path like `/var/backups/app.sql`
    // would otherwise trip the DbError branch, and one containing `url` or
    // `http` the HttpError branch. Subtypes precede the bare parent so the
    // longest match wins.
    for kind in [
        "IoError.NotFound",
        "IoError.PermissionDenied",
        "IoError.AlreadyExists",
        "IoError",
    ] {
        if msg.starts_with(kind) {
            return kind;
        }
    }
    let lc = msg.to_ascii_lowercase();
    let has = |needles: &[&str]| -> bool { needles.iter().any(|n| lc.contains(n)) };
    // JWT first, mirroring `runner::classify_jwc_error`: these substrings
    // are distinctive and have to win before the generic ValidationError
    // catch-all, or `jwt_verify: signature mismatch` files as a validation
    // failure. Without this branch the native backend classified every
    // `jwt_verify` panic as a bare `Error`, so `catch (e: JwtError)`
    // matched under `jwc run` and silently missed under `--native`.
    if has(&["jwt_verify", "jwt_sign", "jwt:"]) {
        if has(&["token expired", "'exp' claim"]) {
            return "JwtError.Expired";
        }
        if has(&["signature mismatch", "invalid base64", "hs256"]) {
            return "JwtError.InvalidSignature";
        }
        return "JwtError";
    }
    if has(&[
        "validate body",
        "validation failed",
        "field '",
        "required",
        "minlength",
        "maxlength",
        "is not declared on",
        "type error",
    ]) {
        return "ValidationError";
    }
    if has(&[
        "deadpool",
        "tokio-postgres",
        "postgres",
        "db error",
        "no connection",
        "pool",
        "advisory lock",
        "migration",
        "sql",
    ]) {
        return "DbError";
    }
    if has(&["timeout", "deadline", "elapsed"]) {
        return "TimeoutError";
    }
    if has(&[
        "http",
        "reqwest",
        "status code",
        "url",
        "fetch_json",
        "http_get",
        "http_post",
    ]) {
        return "HttpError";
    }
    "Error"
}

fn jwc_catch_type_matches(catch_type: Option<&str>, kind: &str) -> bool {
    match catch_type {
        None => true,
        Some("Error") => true,
        Some(t) if t == kind => true,
        // A parent kind catches its dotted children, mirroring
        // `runner::catch_type_matches`. This side used to do an exact
        // compare only, so `catch (e: DbError)` silently missed every
        // `DbError.*` subtype in an AOT binary while catching them fine
        // under `jwc run`. Bare prefix overlap (`Db` vs `DbError`) must
        // still not match, hence the explicit `.` check.
        Some(t) => {
            kind.len() > t.len()
                && kind.as_bytes().get(t.len()) == Some(&b'.')
                && kind.starts_with(t)
        }
    }
}

// Builds the V passed to `errorHandler (e)` and `try {} catch (e)`.
#[cold]
fn jwc_error_value(msg: String) -> V {
    let kind = jwc_classify_error(&msg);
    let mut m: JwcObj = JwcObj::default();
    // `kind` is a `&'static str` (one of the known JWC error kinds), so wrap
    // it as a borrowed Cow instead of allocating a String.
    m.insert("type".to_string(), v_str(kind));
    m.insert("message".to_string(), v_str(msg));
    m.insert("causes".to_string(), v_arr(Vec::new()));
    v_obj(m)
}

#[cold]
#[inline(never)]
/// Quiet the default panic hook.
///
/// JWC-level errors travel as panics in the native backend and are caught by
/// the `catch_unwind` that `try { } catch { }` and the route wrapper emit. The
/// default hook still prints the message and a backtrace to stderr first, so
/// an ordinary handled failure — `try { jwt_verify(...) } catch { unauthorized() }`
/// on every unauthenticated request — filled the log with `thread 'main'
/// panicked` and a stack trace for what the interpreter reports as nothing at
/// all.
///
/// The hook stays installed for genuine crashes but prints one line instead of
/// a trace. `RUST_BACKTRACE` restores the full output for debugging.
fn jwc_install_panic_hook() {
    // `RUST_BACKTRACE=0` is "no backtrace", not "opt out of the hook" — check
    // the value rather than mere presence.
    let want_backtrace = std::env::var("RUST_BACKTRACE")
        .map(|v| !matches!(v.trim(), "" | "0" | "false" | "off" | "no"))
        .unwrap_or(false);
    if want_backtrace {
        return;
    }
    let default = std::panic::take_hook();
    std::panic::set_hook(Box::new(move |info| {
        // Anything a JWC `try` can catch is handled by user code; only report
        // it when nothing did, and without the trace.
        if jwc_in_caught_region() {
            return;
        }
        default(info);
    }));
}

thread_local! {
    /// Depth of `catch_unwind` regions the current thread is inside.
    static JWC_CATCH_DEPTH: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
}

fn jwc_enter_caught_region() {
    JWC_CATCH_DEPTH.with(|d| d.set(d.get() + 1));
}

fn jwc_leave_caught_region() {
    JWC_CATCH_DEPTH.with(|d| d.set(d.get().saturating_sub(1)));
}

fn jwc_in_caught_region() -> bool {
    JWC_CATCH_DEPTH.with(|d| d.get()) > 0
}

/// Bind a listener, clearing `IPV6_V6ONLY` when the address is IPv6.
///
/// `TcpListener::bind` on `[::]` gives a dual-stack socket on Linux, where
/// `net.ipv6.bindv6only` defaults to 0, but not on Windows, where the
/// option defaults to on. A native build there listened on `[::]:8080`
/// and refused every connection to `127.0.0.1:8080` — invisible to
/// container probes, reverse proxies, and load generators dialling IPv4,
/// while the interpreter build of the same source answered both.
async fn jwc_bind_dual_stack(addr: std::net::SocketAddr) -> std::io::Result<TcpListener> {
    let domain = if addr.is_ipv6() {
        socket2::Domain::IPV6
    } else {
        socket2::Domain::IPV4
    };
    let sock = socket2::Socket::new(domain, socket2::Type::STREAM, Some(socket2::Protocol::TCP))?;
    if addr.is_ipv6() {
        // Best effort: a host with IPv4 disabled rejects this, and an
        // IPv6-only listener is still better than not starting.
        let _ = sock.set_only_v6(false);
    }
    // Match what `TcpListener::bind` does, so a restart doesn't trip over
    // sockets in TIME_WAIT.
    #[cfg(not(windows))]
    sock.set_reuse_address(true)?;
    sock.set_nonblocking(true)?;
    sock.bind(&addr.into())?;
    sock.listen(1024)?;
    TcpListener::from_std(std::net::TcpListener::from(sock))
}

/// Turn an uncaught handler panic into the same 500 envelope the
/// interpreter's `http_error::internal` produces.
///
/// Native handlers used to get a panic guard only when the program
/// declared an `error_handler` block. Without one, a panic — which is how
/// every JWC-level failure travels in this backend, including a failed
/// `jwc_db_exec` — unwound straight into axum, which drops the connection:
/// the client saw no response at all, not a 500. Under load that is one
/// panicked worker per failing request.
///
/// The detail is logged rather than returned, so SQL text and Rust type
/// names don't reach the caller. `JWC_DEBUG_ERRORS=1` puts it back, same
/// switch and same values the interpreter honours.
#[cold]
#[inline(never)]
fn jwc_uncaught_error_response(msg: String) -> V {
    eprintln!("[jwc] uncaught error in handler: {}", msg);
    let debug = std::env::var("JWC_DEBUG_ERRORS")
        .map(|v| matches!(v.trim().to_ascii_lowercase().as_str(), "1" | "true" | "yes" | "on"))
        .unwrap_or(false);
    let detail = if debug {
        msg
    } else {
        "Internal server error. Check the server log for the matching x-request-id.".to_string()
    };
    // Field order matches `http_error::envelope`: error, status, code.
    let mut body = String::from("{\"error\":");
    jwc_write_json_string(&detail, &mut body);
    body.push_str(",\"status\":500,\"code\":\"internal_error\"}");
    make_response(500, body, JWC_JSON_CT)
}

fn jwc_panic_payload_to_string(p: Box<dyn std::any::Any + Send>) -> String {
    if let Some(s) = p.downcast_ref::<String>() {
        return s.clone();
    }
    if let Some(s) = p.downcast_ref::<&'static str>() {
        return (*s).to_string();
    }
    "panic".to_string()
}

// --- arithmetic & coercion ---------------------------------------------------

fn jwc_add(a: V, b: V) -> V {
    match (a, b) {
        (V::Int(x), V::Int(y)) => V::Int(x + y),
        (V::Float(x), V::Float(y)) => V::Float(x + y),
        (V::Int(x), V::Float(y)) => V::Float(x as f64 + y),
        (V::Float(x), V::Int(y)) => V::Float(x + y as f64),
        (V::Str(x), b) => v_str(format!("{}{}", x, b)),
        (a, V::Str(y)) => v_str(format!("{}{}", a, y)),
        (a, b) => panic!("unsupported `+` between {:?} and {:?}", a, b),
    }
}

fn jwc_sub(a: V, b: V) -> V {
    match (a, b) {
        (V::Int(x), V::Int(y)) => V::Int(x - y),
        (V::Float(x), V::Float(y)) => V::Float(x - y),
        (V::Int(x), V::Float(y)) => V::Float(x as f64 - y),
        (V::Float(x), V::Int(y)) => V::Float(x - y as f64),
        (a, b) => panic!("unsupported `-` between {:?} and {:?}", a, b),
    }
}

fn jwc_mul(a: V, b: V) -> V {
    match (a, b) {
        (V::Int(x), V::Int(y)) => V::Int(x * y),
        (V::Float(x), V::Float(y)) => V::Float(x * y),
        (V::Int(x), V::Float(y)) => V::Float(x as f64 * y),
        (V::Float(x), V::Int(y)) => V::Float(x * y as f64),
        (a, b) => panic!("unsupported `*` between {:?} and {:?}", a, b),
    }
}

fn jwc_div(a: V, b: V) -> V {
    match (a, b) {
        (V::Int(x), V::Int(y)) => {
            if y == 0 { panic!("division by zero"); }
            V::Int(x / y)
        }
        (V::Float(x), V::Float(y)) => V::Float(x / y),
        (V::Int(x), V::Float(y)) => V::Float(x as f64 / y),
        (V::Float(x), V::Int(y)) => V::Float(x / y as f64),
        (a, b) => panic!("unsupported `/` between {:?} and {:?}", a, b),
    }
}

fn jwc_mod(a: V, b: V) -> V {
    match (a, b) {
        (V::Int(x), V::Int(y)) => {
            if y == 0 { panic!("mod by zero"); }
            V::Int(x % y)
        }
        (V::Float(x), V::Float(y)) => V::Float(x % y),
        (a, b) => panic!("unsupported `%` between {:?} and {:?}", a, b),
    }
}

fn jwc_neg(v: V) -> V {
    match v {
        V::Int(n) => V::Int(-n),
        V::Float(n) => V::Float(-n),
        v => panic!("unsupported unary `-` on {:?}", v),
    }
}

fn jwc_eq(a: &V, b: &V) -> bool {
    match (a, b) {
        (V::Null, V::Null) => true,
        (V::Bool(x), V::Bool(y)) => x == y,
        (V::Int(x), V::Int(y)) => x == y,
        (V::Float(x), V::Float(y)) => x == y,
        (V::Int(x), V::Float(y)) | (V::Float(y), V::Int(x)) => (*x as f64) == *y,
        (V::Str(x), V::Str(y)) => x == y,
        (V::Array(x), V::Array(y)) => {
            x.len() == y.len() && x.iter().zip(y.iter()).all(|(a, b)| jwc_eq(a, b))
        }
        (V::Object(x), V::Object(y)) => {
            x.len() == y.len()
                && x.iter()
                    .all(|(k, v)| y.get(k).map(|w| jwc_eq(v, w)).unwrap_or(false))
        }
        // Two Records are equal iff every (name, value) pair from `a` matches
        // a same-named field in `b`. Field-order independent so a literal
        // built declaration-order compares equal to one with reordered keys.
        (
            V::Record { field_names: fa, values: va },
            V::Record { field_names: fb, values: vb },
        ) => {
            fa.len() == fb.len()
                && fa.iter().enumerate().all(|(i, name)| {
                    fb.iter()
                        .position(|n| n == name)
                        .map(|j| jwc_eq(&va[i], &vb[j]))
                        .unwrap_or(false)
                })
        }
        _ => false,
    }
}

fn jwc_cmp(a: &V, b: &V) -> Option<std::cmp::Ordering> {
    match (a, b) {
        (V::Int(x), V::Int(y)) => Some(x.cmp(y)),
        (V::Float(x), V::Float(y)) => x.partial_cmp(y),
        (V::Int(x), V::Float(y)) => (*x as f64).partial_cmp(y),
        (V::Float(x), V::Int(y)) => x.partial_cmp(&(*y as f64)),
        (V::Str(x), V::Str(y)) => Some(x.cmp(y)),
        (V::Bool(x), V::Bool(y)) => Some(x.cmp(y)),
        _ => None,
    }
}

fn jwc_lt(a: &V, b: &V) -> bool { matches!(jwc_cmp(a, b), Some(std::cmp::Ordering::Less)) }
fn jwc_lte(a: &V, b: &V) -> bool { matches!(jwc_cmp(a, b), Some(std::cmp::Ordering::Less | std::cmp::Ordering::Equal)) }
fn jwc_gt(a: &V, b: &V) -> bool { matches!(jwc_cmp(a, b), Some(std::cmp::Ordering::Greater)) }
fn jwc_gte(a: &V, b: &V) -> bool { matches!(jwc_cmp(a, b), Some(std::cmp::Ordering::Greater | std::cmp::Ordering::Equal)) }

// --- field / array helpers ---------------------------------------------------

/// Does this value **carry** the key, as distinct from carrying null under
/// it? types.md §6.5 — absent and null are different, and `...$req` spreads
/// only the fields the body actually sent (§9.2): an explicit null sets the
/// column to null, an absent key leaves it alone. `jwc_get_field` collapses
/// the two, so the spread needs its own predicate.
fn jwc_has_field(v: &V, k: &str) -> bool {
    match v {
        V::Object(m) => m.contains_key(k),
        V::Record { field_names, .. } => field_names.iter().any(|f| f.as_ref() == k),
        V::RawJson(s) | V::Str(s) => match jwc_from_json(s) {
            Ok(parsed) => jwc_has_field(&parsed, k),
            Err(_) => false,
        },
        _ => false,
    }
}

fn jwc_get_field(v: &V, k: &str) -> V {
    match v {
        V::Object(m) => m.get(k).cloned().unwrap_or(V::Null),
        // Linear scan over `field_names`; for the typical 2-10 field shapes
        // this is faster than hashing. Returns Null on miss to match the
        // Object arm's behaviour.
        V::Record { field_names, values } => field_names
            .iter()
            .position(|f| f.as_ref() == k)
            .map(|i| values[i].clone())
            .unwrap_or(V::Null),
        // A row read back from the database arrives as `RawJson` — the whole
        // point of that variant is to skip building an FxHashMap for a value
        // that is usually written straight back out. A dynamic object
        // (`json_parse` output, an object literal with computed keys) travels
        // as `Str`. Both used to fall through to `_ => V::Null`, so
        //
        //     let link = select Link from AppDb.Link where ... first;
        //     return ok({ code: link.code, url: link.url });
        //
        // answered `{"code":null,"url":null}` on a native build while the
        // interpreter returned the row. Not an edge case: every field read
        // off a `select ... first` was empty, and the shape was right, so it
        // looked like missing data rather than a compiler bug. jwc-shortener
        // worked around it by rewriting the route in `raw_sql`.
        //
        // Parsing per access is O(n) in the payload. That is the honest cost
        // of the lazy representation and it only lands on code that actually
        // reads a field; a caller returning the row whole still pays nothing.
        V::RawJson(s) | V::Str(s) => match jwc_from_json(s.as_ref()) {
            Ok(parsed) => match parsed {
                // One level only — the parse produced an owned value, so
                // recursing would re-parse a nested RawJson that cannot
                // occur here.
                V::Object(m) => m.get(k).cloned().unwrap_or(V::Null),
                V::Record { field_names, values } => field_names
                    .iter()
                    .position(|f| f.as_ref() == k)
                    .map(|i| values[i].clone())
                    .unwrap_or(V::Null),
                _ => V::Null,
            },
            // Not JSON at all — a plain string field read is a miss, which
            // is what the Object arm returns for an absent key.
            Err(_) => V::Null,
        },
        _ => V::Null,
    }
}

fn jwc_set_field(v: &mut V, k: &str, value: V) {
    match v {
        V::Object(m) => { Arc::make_mut(m).insert(k.to_string(), value); }
        // **Phase 1** — Record CoW mutation. If the field already exists in
        // the shape, write in place via `Arc::make_mut` on the values Arc
        // (the shape Arc stays shared with every other Record of the same
        // shape). For a new field the shape would have to grow; promote the
        // whole Record to a `V::Object` so the FxHashMap path handles it —
        // mirrors the interpreter, which falls back to the JSON-string path
        // for the same reason.
        V::Record { field_names, values } => {
            if let Some(idx) = field_names.iter().position(|f| f.as_ref() == k) {
                Arc::make_mut(values)[idx] = value;
            } else {
                let mut m: JwcObj = FxHashMap::default();
                for (name, val) in field_names.iter().zip(values.iter()) {
                    m.insert(name.as_ref().to_string(), val.clone());
                }
                m.insert(k.to_string(), value);
                *v = v_obj(m);
            }
        }
        // The write half of the same lazy representation `jwc_get_field`
        // handles above. A row from `select ... first` is `RawJson`; a
        // `json_parse` result or a computed-key object literal is `Str`.
        // Reads were taught to parse these; writes were not, so
        //
        //     let existing = select Todo from AppDb.Todo where ... first;
        //     existing.title = req.title;
        //     update existing in AppDb.Todo;
        //
        // — the shape every REST update handler is written in — panicked the
        // tokio worker on a native build, one panic per request, and the
        // client just lost the connection. Under `jwc run` it worked, so
        // `jwc test` / `jwc lint` / `jwc run` were all clean and the crash
        // only appeared after `--native`.
        //
        // Materialise, write through `*v`, and let the next access take the
        // Object path — the parse cost lands once per mutated value rather
        // than once per field access.
        V::RawJson(s) | V::Str(s) => {
            let parsed = jwc_from_json(s.as_ref());
            match parsed {
                Ok(V::Object(m)) => {
                    let mut m = (*m).clone();
                    m.insert(k.to_string(), value);
                    *v = v_obj(m);
                }
                Ok(V::Record { field_names, values }) => {
                    let mut m: JwcObj = FxHashMap::default();
                    for (name, val) in field_names.iter().zip(values.iter()) {
                        m.insert(name.as_ref().to_string(), val.clone());
                    }
                    m.insert(k.to_string(), value);
                    *v = v_obj(m);
                }
                // A string that is not a JSON object is not assignable. The
                // interpreter raises rather than crashing the worker, so the
                // message matters more than the arm: keep it describing the
                // value, not the internal variant.
                _ => panic!("field assignment on non-object value: {:?}", s),
            }
        }
        other => panic!("field assignment on non-object value: {:?}", other),
    }
}

fn jwc_to_array(v: V) -> JwcArr {
    match v {
        V::Array(a) => Arc::unwrap_or_clone(a),
        V::Null => Vec::new(),
        V::Str(s) => {
            // Accept JSON-array strings to match interpreter semantics.
            match jwc_from_json(&s) {
                Ok(V::Array(a)) => Arc::unwrap_or_clone(a),
                _ => panic!("for-in expects an array, got string {:?}", s),
            }
        }
        other => panic!("for-in expects an array, got {:?}", other),
    }
}

// --- JSON --------------------------------------------------------------------

fn jwc_to_json(v: &V) -> String {
    // Phase A7 of PERF_PLAN.md: pre-size the buffer so the common
    // route-response shape never round-trips through the
    // 4 → 8 → 16 → 32 → 64 → 128 reallocation ladder. 256 bytes
    // covers the vast majority of JWC route responses; larger ones
    // still grow but skip the first few cliffs.
    let mut out = String::with_capacity(256);
    jwc_write_json(v, &mut out);
    out
}

fn jwc_write_json(v: &V, out: &mut String) {
    match v {
        V::Null => out.push_str("null"),
        V::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        V::Int(n) => out.push_str(&n.to_string()),
        V::Float(n) => {
            if n.is_finite() {
                out.push_str(&n.to_string());
            } else {
                out.push_str("null");
            }
        }
        V::Str(s) => jwc_write_json_string(s, out),
        // Already-encoded JSON — write the bytes verbatim. The whole
        // point of V::RawJson is to skip the V::Object FxHashMap roundtrip
        // on the serialisation side, so this is the load-bearing arm.
        V::RawJson(s) => out.push_str(s),
        V::Array(items) => {
            out.push('[');
            for (i, item) in items.iter().enumerate() {
                if i > 0 { out.push(','); }
                jwc_write_json(item, out);
            }
            out.push(']');
        }
        V::Object(map) => {
            // FxHashMap has no insertion order — sort keys so JSON output
            // is deterministic (and matches the previous BTreeMap behavior).
            out.push('{');
            let mut keys: Vec<&String> = map.keys().collect();
            keys.sort_unstable();
            for (i, k) in keys.into_iter().enumerate() {
                if i > 0 { out.push(','); }
                jwc_write_json_string(k, out);
                out.push(':');
                jwc_write_json(map.get(k).expect("key from keys()"), out);
            }
            out.push('}');
        }
        // Records walk `field_names` + `values` in declaration order so
        // output mirrors the source-literal field order (and matches the
        // interpreter's `Value::Record` JSON output). The recursive
        // `jwc_write_json` call handles nested RawJson by writing its
        // bytes verbatim — same as the Array arm above.
        V::Record { field_names, values } => {
            out.push('{');
            for (i, (name, val)) in field_names.iter().zip(values.iter()).enumerate() {
                if i > 0 { out.push(','); }
                jwc_write_json_string(name, out);
                out.push(':');
                jwc_write_json(val, out);
            }
            out.push('}');
        }
    }
}

fn jwc_write_json_string(s: &str, out: &mut String) {
    // Phase A7: reserve `s.len() + 2` up front. In the no-escapes-needed
    // path this is the exact size and we skip all reallocations; when
    // escapes do appear we've still saved most of them.
    out.reserve(s.len() + 2);
    out.push('"');
    for ch in s.chars() {
        match ch {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            '\x08' => out.push_str("\\b"),
            '\x0c' => out.push_str("\\f"),
            c if (c as u32) < 0x20 => {
                out.push_str(&format!("\\u{:04x}", c as u32));
            }
            c => out.push(c),
        }
    }
    out.push('"');
}

fn jwc_from_json(s: &str) -> Result<V, String> {
    let mut p = JsonParser { src: s.as_bytes(), pos: 0 };
    p.skip_ws();
    let v = p.parse_value()?;
    p.skip_ws();
    if p.pos != p.src.len() {
        return Err(format!("trailing data at byte {}", p.pos));
    }
    Ok(v)
}

struct JsonParser<'a> {
    src: &'a [u8],
    pos: usize,
}

impl<'a> JsonParser<'a> {
    fn peek(&self) -> Option<u8> { self.src.get(self.pos).copied() }
    fn bump(&mut self) -> Option<u8> { let b = self.peek(); if b.is_some() { self.pos += 1; } b }

    fn skip_ws(&mut self) {
        while let Some(b) = self.peek() {
            if matches!(b, b' ' | b'\t' | b'\n' | b'\r') { self.pos += 1; } else { break; }
        }
    }

    fn expect(&mut self, b: u8) -> Result<(), String> {
        if self.bump() == Some(b) { Ok(()) } else { Err(format!("expected '{}' at {}", b as char, self.pos)) }
    }

    fn parse_value(&mut self) -> Result<V, String> {
        self.skip_ws();
        match self.peek() {
            Some(b'n') => self.parse_keyword(b"null", V::Null),
            Some(b't') => self.parse_keyword(b"true", V::Bool(true)),
            Some(b'f') => self.parse_keyword(b"false", V::Bool(false)),
            Some(b'"') => self.parse_string().map(v_str),
            Some(b'[') => self.parse_array(),
            Some(b'{') => self.parse_object(),
            Some(b) if b == b'-' || b.is_ascii_digit() => self.parse_number(),
            Some(b) => Err(format!("unexpected byte '{}' at {}", b as char, self.pos)),
            None => Err("unexpected end of input".into()),
        }
    }

    fn parse_keyword(&mut self, kw: &[u8], val: V) -> Result<V, String> {
        if self.pos + kw.len() > self.src.len() || &self.src[self.pos..self.pos + kw.len()] != kw {
            return Err(format!("expected `{}` at {}", std::str::from_utf8(kw).unwrap(), self.pos));
        }
        self.pos += kw.len();
        Ok(val)
    }

    fn parse_string(&mut self) -> Result<String, String> {
        self.expect(b'"')?;
        let mut out = String::new();
        loop {
            match self.bump() {
                None => return Err("unterminated string".into()),
                Some(b'"') => return Ok(out),
                Some(b'\\') => match self.bump() {
                    Some(b'"') => out.push('"'),
                    Some(b'\\') => out.push('\\'),
                    Some(b'/') => out.push('/'),
                    Some(b'n') => out.push('\n'),
                    Some(b'r') => out.push('\r'),
                    Some(b't') => out.push('\t'),
                    Some(b'b') => out.push('\x08'),
                    Some(b'f') => out.push('\x0c'),
                    Some(b'u') => {
                        if self.pos + 4 > self.src.len() {
                            return Err("truncated \\u escape".into());
                        }
                        let hex = std::str::from_utf8(&self.src[self.pos..self.pos + 4])
                            .map_err(|_| "invalid \\u".to_string())?;
                        let code = u32::from_str_radix(hex, 16).map_err(|e| e.to_string())?;
                        self.pos += 4;
                        if let Some(c) = char::from_u32(code) { out.push(c); }
                    }
                    Some(b) => return Err(format!("bad escape \\{}", b as char)),
                    None => return Err("eof after backslash".into()),
                },
                Some(b) => out.push(b as char),
            }
        }
    }

    fn parse_number(&mut self) -> Result<V, String> {
        let start = self.pos;
        if self.peek() == Some(b'-') { self.pos += 1; }
        while let Some(b) = self.peek() {
            if b.is_ascii_digit() { self.pos += 1; } else { break; }
        }
        let mut is_float = false;
        if self.peek() == Some(b'.') {
            is_float = true;
            self.pos += 1;
            while let Some(b) = self.peek() {
                if b.is_ascii_digit() { self.pos += 1; } else { break; }
            }
        }
        if matches!(self.peek(), Some(b'e') | Some(b'E')) {
            is_float = true;
            self.pos += 1;
            if matches!(self.peek(), Some(b'+') | Some(b'-')) { self.pos += 1; }
            while let Some(b) = self.peek() {
                if b.is_ascii_digit() { self.pos += 1; } else { break; }
            }
        }
        let slice = std::str::from_utf8(&self.src[start..self.pos]).map_err(|e| e.to_string())?;
        if is_float {
            slice.parse::<f64>().map(V::Float).map_err(|e| e.to_string())
        } else {
            slice.parse::<i64>().map(V::Int).map_err(|e| e.to_string())
        }
    }

    fn parse_array(&mut self) -> Result<V, String> {
        self.expect(b'[')?;
        let mut out: JwcArr = Vec::new();
        self.skip_ws();
        if self.peek() == Some(b']') { self.pos += 1; return Ok(v_arr(out)); }
        loop {
            out.push(self.parse_value()?);
            self.skip_ws();
            match self.bump() {
                Some(b',') => self.skip_ws(),
                Some(b']') => return Ok(v_arr(out)),
                _ => return Err(format!("expected ',' or ']' at {}", self.pos)),
            }
        }
    }

    fn parse_object(&mut self) -> Result<V, String> {
        self.expect(b'{')?;
        let mut out: JwcObj = JwcObj::default();
        self.skip_ws();
        if self.peek() == Some(b'}') { self.pos += 1; return Ok(v_obj(out)); }
        loop {
            self.skip_ws();
            let k = self.parse_string()?;
            self.skip_ws();
            self.expect(b':')?;
            let v = self.parse_value()?;
            out.insert(k, v);
            self.skip_ws();
            match self.bump() {
                Some(b',') => continue,
                Some(b'}') => return Ok(v_obj(out)),
                _ => return Err(format!("expected ',' or '}}' at {}", self.pos)),
            }
        }
    }
}

// --- Built-in functions ------------------------------------------------------

fn jwc_b_length(v: V) -> V {
    match v {
        // A string that parses as a JSON array or object counts its
        // elements, not its characters. This is what the interpreter does
        // (`eval_length_call`), and it is load-bearing: `request_body()`
        // hands back raw JSON as a string, so `length(request_body())`
        // meant "how many characters of JSON" here and "how many fields"
        // there. Plain strings still count characters.
        V::Str(s) => {
            if let Ok(parsed) = serde_json::from_str::<serde_json::Value>(&s) {
                if let Some(arr) = parsed.as_array() {
                    return V::Int(arr.len() as i64);
                }
                if let Some(obj) = parsed.as_object() {
                    return V::Int(obj.len() as i64);
                }
            }
            V::Int(s.chars().count() as i64)
        }
        V::Array(a) => V::Int(a.len() as i64),
        V::Object(o) => V::Int(o.len() as i64),
        V::Record { values, .. } => V::Int(values.len() as i64),
        V::Null => V::Int(0),
        other => panic!("length() not supported on {:?}", other),
    }
}

/// `len` is a declared alias of `length` in `BUILTIN_DEFS`; codegen mangles
/// the call site to `jwc_b_len`, so the shim has to exist.
fn jwc_b_len(v: V) -> V {
    jwc_b_length(v)
}

fn jwc_b_lower(v: V) -> V {
    match v {
        V::Str(s) => v_str(s.to_lowercase()),
        other => panic!("lower() expects a string, got {:?}", other),
    }
}

fn jwc_b_upper(v: V) -> V {
    match v {
        V::Str(s) => v_str(s.to_uppercase()),
        other => panic!("upper() expects a string, got {:?}", other),
    }
}

fn jwc_b_trim(v: V) -> V {
    match v {
        V::Str(s) => v_str(s.trim().to_string()),
        other => panic!("trim() expects a string, got {:?}", other),
    }
}

fn jwc_b_contains(haystack: V, needle: V) -> V {
    let result = match (&haystack, &needle) {
        (V::Str(s), V::Str(p)) => s.contains(p.as_ref()),
        (V::Array(items), n) => items.iter().any(|item| jwc_eq(item, n)),
        (V::Object(map), V::Str(k)) => map.contains_key(k.as_ref()),
        (V::Record { field_names, .. }, V::Str(k)) => {
            field_names.iter().any(|f| f.as_ref() == k.as_ref())
        }
        _ => false,
    };
    V::Bool(result)
}

fn jwc_b_starts_with(s: V, p: V) -> V {
    match (s, p) {
        (V::Str(a), V::Str(b)) => V::Bool(a.starts_with(b.as_ref())),
        (a, b) => panic!("starts_with() expects two strings, got {:?} / {:?}", a, b),
    }
}

fn jwc_b_ends_with(s: V, p: V) -> V {
    match (s, p) {
        (V::Str(a), V::Str(b)) => V::Bool(a.ends_with(b.as_ref())),
        (a, b) => panic!("ends_with() expects two strings, got {:?} / {:?}", a, b),
    }
}

fn jwc_b_replace(s: V, old: V, new: V) -> V {
    match (s, old, new) {
        (V::Str(a), V::Str(b), V::Str(c)) => v_str(a.replace(b.as_ref(), c.as_ref())),
        (a, b, c) => panic!("replace() expects three strings, got {:?} / {:?} / {:?}", a, b, c),
    }
}

fn jwc_b_split(s: V, sep: V) -> V {
    match (s, sep) {
        (V::Str(a), V::Str(b)) => {
            let parts: JwcArr = a.split(b.as_ref()).map(|p| v_str(p.to_string())).collect();
            v_arr(parts)
        }
        (a, b) => panic!("split() expects two strings, got {:?} / {:?}", a, b),
    }
}

fn jwc_b_substring(s: V, start: V, len: V) -> V {
    let s = match s {
        V::Str(s) => s,
        V::Null => return V::Null,
        other => panic!("substring() expects a string, got {:?}", other),
    };
    let start = match start {
        V::Int(n) => n,
        other => panic!("substring() expects int start, got {:?}", other),
    };
    let len = match len {
        V::Int(n) => n,
        other => panic!("substring() expects int len, got {:?}", other),
    };
    if start < 0 || len <= 0 {
        return v_str(String::new());
    }
    let out: String = s.chars().skip(start as usize).take(len as usize).collect();
    v_str(out)
}

fn jwc_b_take(xs: V, n: V) -> V {
    let n = match n {
        V::Int(n) => n,
        other => panic!("take() expects int n, got {:?}", other),
    };
    match xs {
        // `take(rows, 5)` — the obvious pagination shape — used to panic on
        // both backends, while `first` and `last` accepted arrays. See
        // `eval_take_call`; a string still slices by character.
        V::Array(items) => {
            let k = if n <= 0 { 0 } else { n as usize };
            v_arr(items.iter().take(k).cloned().collect())
        }
        V::Str(s) => {
            if n <= 0 {
                return v_str(String::new());
            }
            v_str(s.chars().take(n as usize).collect::<String>())
        }
        V::Null => V::Null,
        other => panic!("take() expects a string or an array, got {:?}", other),
    }
}

fn jwc_b_first(v: V) -> V {
    match v {
        V::Array(a) => {
            if a.is_empty() {
                V::Null
            } else {
                // Refcount == 1 (the only owner) → unwrap_or_clone returns
                // the Vec by move; > 1 clones. Either way we can `remove(0)`.
                let mut owned = Arc::unwrap_or_clone(a);
                owned.remove(0)
            }
        }
        V::Str(s) => s.chars().next().map(|c| v_str(c.to_string())).unwrap_or(V::Null),
        V::Null => V::Null,
        other => panic!("first() expects an array or string, got {:?}", other),
    }
}

fn jwc_b_last(v: V) -> V {
    match v {
        V::Array(a) => a.last().cloned().unwrap_or(V::Null),
        V::Str(s) => s.chars().last().map(|c| v_str(c.to_string())).unwrap_or(V::Null),
        V::Null => V::Null,
        other => panic!("last() expects an array or string, got {:?}", other),
    }
}

fn jwc_b_range(start: V, end: V, step: V) -> V {
    let s = jwc_to_int(&start).unwrap_or(0);
    let e = jwc_to_int(&end).unwrap_or(0);
    let st = jwc_to_int(&step).unwrap_or(1);
    if st <= 0 {
        panic!("range() step must be positive, got {}", st);
    }
    let mut out: JwcArr = Vec::new();
    let mut i = s;
    while i < e {
        out.push(V::Int(i));
        i += st;
    }
    v_arr(out)
}

fn jwc_b_unix_timestamp() -> V {
    let secs = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_secs() as i64)
        .unwrap_or(0);
    V::Int(secs)
}

/// `random_int(end)` → [0, end); `random_int(start, end)` → [start, end).
/// Half-open, matching `range()`. Codegen pads the 1-arg form with a 0
/// start, so both arms arrive here filled in.
///
/// NOT cryptographic — see the interpreter arm for the same warning.
fn jwc_b_random_int(start: V, end: V) -> V {
    let lo = jwc_to_int(&start).unwrap_or(0);
    let hi = jwc_to_int(&end).unwrap_or(0);
    if hi <= lo {
        panic!("random_int({}, {}): the range is empty (end must exceed start)", lo, hi);
    }
    V::Int(rand::Rng::gen_range(&mut rand::thread_rng(), lo..hi))
}

fn jwc_push(arr: &mut V, elem: V) {
    match arr {
        V::Array(items) => Arc::make_mut(items).push(elem),
        V::Null => *arr = v_arr(vec![elem]),
        other => panic!("push() first arg must be an array, got {:?}", other),
    }
}

fn jwc_b_join(arr: V, sep: V) -> V {
    let sep = match sep {
        V::Str(s) => s,
        other => panic!("join() sep must be a string, got {:?}", other),
    };
    let items = jwc_to_array(arr);
    let parts: Vec<String> = items.iter().map(|v| v.to_string()).collect();
    v_str(parts.join(sep.as_ref()))
}

fn jwc_b_json_parse(v: V) -> V {
    match v {
        V::Str(s) => match jwc_from_json(s.as_ref()) {
            Ok(parsed) => parsed,
            Err(e) => panic!("json_parse failed: {}", e),
        },
        other => panic!("json_parse() expects a string, got {:?}", other),
    }
}

fn jwc_b_json_stringify(v: V) -> V {
    v_str(jwc_to_json(&v))
}

/// `env(name)` — the value, or **null** when the variable is not set.
///
/// Not the empty string. `env("PUBLIC_BASE_URL") ?? "https://1kb.uz"` is the
/// shape every program uses this in, and `??` only fires on null: answering
/// `""` made the default unreachable and jwc-shortener built its short links
/// as `/abc1234` with no host.
fn jwc_b_env(name: V) -> V {
    let n = match name {
        V::Str(s) => s,
        _ => return V::Null,
    };
    match std::env::var(n.as_ref()) {
        Ok(v) => v_str(v),
        Err(_) => V::Null,
    }
}

/// Mirror of the interpreter's `int(v)` — see the note on the `"int"` arm in
/// `runner/eval.rs`. Strings are trimmed before parsing (a trailing space
/// from `console.read()` or a query param used to make this answer 0), an
/// unparseable string panics rather than answering a plausible-looking 0,
/// and `null` propagates so `int` stays usable in nullable flows.
///
/// The panic message carries "type error" so `jwc_classify_error` files it
/// as ValidationError, matching the interpreter side.
fn jwc_b_int(v: V) -> V {
    match v {
        V::Int(_) => v,
        V::Float(n) => V::Int(n as i64),
        V::Bool(b) => V::Int(if b { 1 } else { 0 }),
        V::Null => V::Null,
        V::Str(ref s) => match s.trim().parse::<i64>() {
            Ok(n) => V::Int(n),
            Err(_) => panic!(
                "int({:?}): type error — not an integer. Use a guard if the \
                 value may be absent or non-numeric.",
                s.as_ref()
            ),
        },
        other => panic!("int(v): type error — cannot convert {:?} to int", other),
    }
}

/// Materialize the `&str` view of a `V::Str` payload. Used by helpers that
/// need to pass the string to `HashMap::get` / `BTreeMap::get` keyed on
/// `&str`, where Cow's deref doesn't fire automatically.
#[inline]
fn jwc_str_view(v: &V) -> Option<&str> {
    match v {
        V::Str(s) => Some(s.as_ref()),
        _ => None,
    }
}

// --- HTTP runtime ------------------------------------------------------------
//
// Tokio-based async HTTP/1.0 server. One tokio task per connection; the
// per-request `Request` lives in a `tokio::task_local!` so JWC code's
// `body()` / `path_param()` / `query_param()` / `header()` built-ins can
// read it without threading the value through every helper signature.
//
// Response values are represented as a `V::Object` with a magic
// `__http_response` marker. The route dispatcher converts the handler's V
// return value into an HTTP response via `jwc_to_response`.

use std::future::Future;
use std::pin::Pin;
use tokio::net::TcpListener;

/// Type of a generated route handler: an `async fn()` boxed/erased into a
/// `Pin<Box<dyn Future>>` so we can store them in a homogeneous `Router`.
type RouteFn = fn() -> Pin<Box<dyn Future<Output = V> + Send>>;

const HTTP_RESPONSE_MARKER: &str = "__http_response";

/// Every JSON response the interpreter emits carries the charset
/// (`exec.rs:228`, `exec_call.rs:631`, `Response::json`). One constant so
/// the two backends cannot drift apart on it again.
const JWC_JSON_CT: &str = "application/json; charset=utf-8";

// --- thrown errors (errors.md §5) --------------------------------------------
//
// A JWC `throw` is not a Rust panic. Panics are `Abort::Fault` — the 500 an
// interpreter fault produces — and they cannot cross an `.await` without
// `catch_unwind`, which would need `UnwindSafe` futures and would poison
// whatever lock or pooled connection was held at the point of the throw.
//
// So a throw travels the way Rust travels errors: generated functions return
// `Result<V, JwcThrown>` and every call site propagates with `?`. The route
// wrapper is the only place that turns one into a response, which is exactly
// where `serve.rs::handle_error` does it.
#[derive(Clone, Debug)]
struct JwcThrown {
    /// The declared error's name — what a postfix `catch` matches on.
    error: &'static str,
    /// The status the declaration carries (errors.md §4.3). Codegen resolves
    /// it from the symbol table at compile time, so there is no name → status
    /// map to build at boot.
    status: u16,
    /// `Thrown::message()`: the first argument when it is text, else empty.
    message: String,
    /// A response body the raiser already built. Only validation sets it —
    /// types.md §11.3 fixes that body's shape, and it is not the ordinary
    /// `{"error": msg}` envelope.
    body: Option<String>,
}

type JwcResult = Result<V, JwcThrown>;

impl JwcThrown {
    fn new(error: &'static str, status: u16, message: V) -> JwcThrown {
        JwcThrown {
            error,
            status,
            message: jwc_str_view(&message).unwrap_or("").to_string(),
            body: None,
        }
    }

    /// The `(err)` binder of a postfix `catch` — errors.md §7.2 gives it one
    /// field, `message`.
    fn payload(&self) -> V {
        let mut m = JwcObj::default();
        m.insert("message".to_string(), v_str(self.message.clone()));
        v_obj(m)
    }
}

/// `serve.rs::handle_error` — a declared error becomes
/// `Response::message(status, &thrown.message())`, i.e. `{"error": msg}`.
#[cold]
fn jwc_thrown_response(t: JwcThrown) -> V {
    if let Some(body) = t.body {
        return make_response(t.status, body, JWC_JSON_CT);
    }
    // Written rather than routed through `JwcObj`, which is an `FxHashMap`:
    // a one-key document has no order to lose, but the next reader would
    // reasonably add a second key.
    make_response(
        t.status,
        format!("{{\"error\":{}}}", jwc_json_string(&t.message)),
        JWC_JSON_CT,
    )
}

fn jwc_to_u16(v: V) -> u16 {
    match v {
        V::Int(n) => n as u16,
        V::Float(n) => n as u16,
        V::Str(s) => s.parse().unwrap_or(0),
        _ => 0,
    }
}

fn jwc_to_int(v: &V) -> Option<i64> {
    match v {
        V::Int(n) => Some(*n),
        V::Float(n) => Some(*n as i64),
        V::Str(s) => s.parse().ok(),
        _ => None,
    }
}

fn jwc_to_float(v: &V) -> Option<f64> {
    match v {
        V::Int(n) => Some(*n as f64),
        V::Float(n) => Some(*n),
        V::Str(s) => s.parse().ok(),
        _ => None,
    }
}

#[derive(Debug)]
struct Request {
    method: String,
    path: String,
    query: BTreeMap<String, String>,
    headers: BTreeMap<String, String>,
    body: Vec<u8>,
    path_params: BTreeMap<String, String>,
    /// `path_params` after `jwc_parse_path_params` — the typed values
    /// `@name` reads.
    typed_params: JwcObj,
    /// Headers an `after { }` block added. middleware.md §5.4 — an after
    /// block may add headers and nothing else, so they are collected here
    /// and merged onto the finished response rather than being allowed to
    /// rewrite it.
    extra_headers: std::sync::Mutex<Vec<(String, String)>>,
    /// The declared pattern, `/orgs/{org_id}` — `request.route()`.
    route_pattern: String,
    /// `true` if the request line was `HTTP/1.1`. Drives default keep-alive.
    http_version_11: bool,
    /// Wall-clock instant the dispatcher saw the request — read by
    /// `response_duration_ms()` so middleware / handler / errorHandler
    /// can record observed latency without a hand-rolled timer.
    started_at: std::time::Instant,
    /// HTTP status the handler emitted, populated by the dispatcher
    /// after the handler returns and before any `after { ... }` block
    /// runs. `0` means "not yet set" — read by `response_status()` from
    /// inside after-blocks. Atomic rather than `Mutex<Option<u16>>` so
    /// the hot path is a lock-free relaxed store/load (the value flows
    /// through happens-before via the surrounding await boundary; we
    /// don't need stronger ordering here).
    response_status: std::sync::atomic::AtomicU16,
    /// Request-scoped key/value bag behind `setContext(k, v)` /
    /// `context(k)` — the channel a `middleware` uses to hand verified
    /// JWT claims to the handler that runs after it.
    ///
    /// The interpreter keeps this as a plain `HashMap` field on the `Vm`
    /// because one `Vm` serves one request. Native has no `Vm`: built-ins
    /// are free functions reaching for `CURRENT_REQUEST`, so the bag lives
    /// on the request and takes a `Mutex` to stay `Sync` across the
    /// `.await` points inside a handler. Uncontended in practice — one
    /// task owns a request — so the lock is a relaxed CAS, not a stall.
    context: std::sync::Mutex<JwcObj>,
}

tokio::task_local! {
    /// Active HTTP request for the current handler task. Set by
    /// `handle_connection` via `CURRENT_REQUEST.scope(req, async { ... }).await`
    /// before dispatching into the user's route fn so built-ins can read it
    /// across `.await` points without explicit plumbing.
    static CURRENT_REQUEST: Arc<Request>;
}

fn with_current_request<F: FnOnce(&Request) -> V>(f: F) -> V {
    match CURRENT_REQUEST.try_with(|req| f(req.as_ref())) {
        Ok(v) => v,
        Err(_) => V::Null,
    }
}

fn jwc_b_path_param(name: V) -> V {
    let k = match name { V::Str(s) => s, _ => return V::Null };
    with_current_request(|req| {
        // `typed` holds what `parse_params` produced — a `bigint` parameter
        // is a `V::Int` here, not the raw segment text, so `@id + 1` means
        // the same thing on both backends.
        if let Some(v) = req.typed_params.get(k.as_ref()) {
            return v.clone();
        }
        req.path_params.get(k.as_ref()).cloned().map(v_str).unwrap_or(V::Null)
    })
}

/// One JSON string literal, quoted and escaped.
fn jwc_json_string(s: &str) -> String {
    let mut out = String::with_capacity(s.len() + 2);
    jwc_write_json(&V::Str(Cow::Owned(s.to_string())), &mut out);
    out
}

/// `serve.rs::parse_params` — routing.md §3.2. A segment that does not parse
/// as its declared type is a 400 before any middleware runs, and the body
/// names the parameter and the type it failed.
fn jwc_parse_path_params(
    raw: &BTreeMap<String, String>,
    types: &[(String, String)],
) -> Result<JwcObj, (u16, String)> {
    let mut out = JwcObj::default();
    for (name, text) in raw {
        let ty = types
            .iter()
            .find(|(n, _)| n == name)
            .map(|(_, t)| t.as_str())
            .unwrap_or("text");
        let v = match ty {
            "bigint" => text.parse::<i64>().ok().map(V::Int),
            "int" | "smallint" => text.parse::<i64>().ok().map(V::Int),
            // Kept as text: `numeric` is exact, and routing it through f64
            // to validate then discarding the float is exactly what the
            // interpreter does.
            "numeric" => text.parse::<f64>().ok().map(|_| v_str(text.clone())),
            "boolean" => match text.as_str() {
                "true" => Some(V::Bool(true)),
                "false" => Some(V::Bool(false)),
                _ => None,
            },
            "uuid" => {
                if text.len() == 36 && text.chars().filter(|c| *c == '-').count() == 4 {
                    Some(v_str(text.clone()))
                } else {
                    None
                }
            }
            _ => Some(v_str(text.clone())),
        };
        match v {
            Some(v) => {
                out.insert(name.clone(), v);
            }
            None => {
                // Built as text, not through `JwcObj`: that is an
                // `FxHashMap`, and the interpreter's `Value::Record` is an
                // ordered list, so routing this through the map would
                // reorder the three keys.
                return Err((
                    400,
                    format!(
                        "{{\"error\":\"bad_path_parameter\",\"parameter\":{},\"expected\":{}}}",
                        jwc_json_string(name),
                        jwc_json_string(ty)
                    ),
                ));
            }
        }
    }
    Ok(out)
}

/// Used by `route ... -> handler;` codegen: pulls a positional arg for the
/// declared handler param. Path params take precedence; query params fall
/// back; missing keys become `V::Null`. Mirrors `runner.rs::build_handler_args`.
fn jwc_b_handler_arg(name: &str) -> V {
    with_current_request(|req| {
        if let Some(s) = req.path_params.get(name) {
            return v_str(s.clone());
        }
        if let Some(s) = req.query.get(name) {
            return v_str(s.clone());
        }
        V::Null
    })
}

fn jwc_b_query_param(name: V, default: V) -> V {
    let k = match name { V::Str(s) => s, _ => return default };
    with_current_request(|req| {
        req.query.get(k.as_ref()).cloned().map(v_str).unwrap_or_else(|| default.clone())
    })
}

fn jwc_b_header(name: V) -> V {
    let k = match name { V::Str(s) => s.to_lowercase(), _ => return V::Null };
    with_current_request(|req| {
        req.headers.get(&k).cloned().map(v_str).unwrap_or(V::Null)
    })
}

// `response_duration_ms()` — ms since dispatch started. Same semantics
// as the interpreter shape: V::Null when called outside a request,
// V::Int(milliseconds) inside one.
fn jwc_b_response_duration_ms() -> V {
    with_current_request(|req| V::Int(req.started_at.elapsed().as_millis() as i64))
}

// Microseconds, for handlers that finish inside one millisecond — where
// `response_duration_ms` reports 0 and every percentile derived from it is
// also 0.
fn jwc_b_response_duration_us() -> V {
    with_current_request(|req| V::Int(req.started_at.elapsed().as_micros() as i64))
}

// `response_status()` — HTTP status the handler emitted. The
// dispatcher populates this *after* the handler returns and *before*
// any `after { ... }` block runs (see `jwc_set_response_status`
// below). Returns V::Null when called from the request phase
// (pre-handler middleware or the handler body itself), matching the
// interpreter shape documented in docs/spec/builtins.md.
fn jwc_b_response_status() -> V {
    with_current_request(|req| {
        match req.response_status.load(std::sync::atomic::Ordering::Relaxed) {
            0 => V::Null,
            s => V::Int(i64::from(s)),
        }
    })
}

// `context(key)` / `setContext(key, value)` — the request-scoped bag that
// carries values from a `middleware` to the handler behind it. Both used
// to be rejected by native codegen, which meant the single most common
// auth shape in JWC —
//
// (NB: keep the phrase the `native_emit` suite greps for out of this
// comment — the whole prelude is concatenated into the emitted source,
// so prose here is searchable text in every generated crate.)
//
//     middleware auth { setContext("userId", jwt_verify(...)?.sub) }
//     route GET "/me" { return { id: context("userId") }; }
//
// — refused to compile under `jwc build --native`. Mirrors
// `runner::builtins::eval_context_get_call` / `eval_context_set_call`:
// a missing key reads back `V::Null` rather than panicking.
//
// Outside a request the pair still has to work, because the interpreter's
// bag is a plain field on the `Vm` and `main()` gets a `Vm` like any
// route does — so `setContext` in `main()` reads back in `main()`. The
// task-local is empty there, so those calls fall through to a process
// global. Requests never touch the global: each one carries its own bag
// on the `Request`, which is what keeps one caller's claims from leaking
// into another's handler.
fn jwc_global_context() -> &'static std::sync::Mutex<JwcObj> {
    static GLOBAL: std::sync::OnceLock<std::sync::Mutex<JwcObj>> = std::sync::OnceLock::new();
    GLOBAL.get_or_init(|| std::sync::Mutex::new(JwcObj::default()))
}

fn jwc_b_context(key: V) -> V {
    let k = match key {
        V::Str(s) => s,
        other => panic!("context(key): key must be string, got {:?}", other),
    };
    // A poisoned lock means another task panicked mid-write. That panic
    // is already travelling to `catch_unwind`; reading the bag as empty
    // is the graceful degradation, not a second panic.
    let read = |map: &std::sync::Mutex<JwcObj>| match map.lock() {
        Ok(m) => m.get(k.as_ref()).cloned().unwrap_or(V::Null),
        Err(_) => V::Null,
    };
    match CURRENT_REQUEST.try_with(|req| read(&req.context)) {
        Ok(v) => v,
        Err(_) => read(jwc_global_context()),
    }
}

fn jwc_b_setContext(key: V, value: V) -> V {
    let k = match key {
        V::Str(s) => s.into_owned(),
        other => panic!("setContext(key, value): key must be string, got {:?}", other),
    };
    let stored = CURRENT_REQUEST.try_with(|req| {
        if let Ok(mut m) = req.context.lock() {
            m.insert(k.clone(), value.clone());
        }
    });
    if stored.is_err() {
        if let Ok(mut m) = jwc_global_context().lock() {
            m.insert(k, value);
        }
    }
    V::Null
}

/// `set_context` is a declared alias of `setContext` in `BUILTIN_DEFS`,
/// and codegen mangles a call by the name the user wrote — so the
/// snake_case spelling needs its own symbol.
fn jwc_b_set_context(key: V, value: V) -> V {
    jwc_b_setContext(key, value)
}

/// Set the current request's response status. Called from the route
/// dispatcher between the handler returning and the after-block chain
/// firing. Idempotent — silently ignored when there's no active
/// request scope (e.g. main()).
/// `response.set_header(name, value)` — middleware.md §5.4.
fn jwc_b_response_set_header(name: V, value: V) -> V {
    let n = jwc_str_view(&name).unwrap_or("").to_string();
    let v = body_string(value);
    if n.is_empty() {
        return V::Null;
    }
    with_current_request(|req| {
        if let Ok(mut bag) = req.extra_headers.lock() {
            bag.retain(|(k, _)| !k.eq_ignore_ascii_case(&n));
            bag.push((n.clone(), v.clone()));
        }
        V::Null
    })
}

/// `response.add_header(name, value)` — appends rather than replacing, for
/// the headers that legitimately repeat (`Set-Cookie`, `Vary`).
fn jwc_b_response_add_header(name: V, value: V) -> V {
    let n = jwc_str_view(&name).unwrap_or("").to_string();
    let v = body_string(value);
    if n.is_empty() {
        return V::Null;
    }
    with_current_request(|req| {
        if let Ok(mut bag) = req.extra_headers.lock() {
            bag.push((n.clone(), v.clone()));
        }
        V::Null
    })
}

/// Take everything an `after` block queued. The dispatcher drains once per
/// block, the way `serve.rs` clears `vm.extra_headers` between them.
fn jwc_drain_extra_headers() -> Vec<(String, String)> {
    // `with_current_request` answers a `V`; this one wants the bag itself.
    CURRENT_REQUEST
        .try_with(|req| match req.extra_headers.lock() {
            Ok(mut bag) => std::mem::take(&mut *bag),
            Err(_) => Vec::new(),
        })
        .unwrap_or_default()
}

/// `<response> with { … }` — routing.md §6.2.
///
/// **Replace**, not append. A builder has already stamped `content-type`,
/// and two of them is a malformed message (RFC 9110 §8.3) that clients
/// resolve inconsistently — `with { "Content-Type": … }` has to win, or it
/// does nothing an author can rely on. `cookie(...)` is the append form and
/// is a separate expression.
fn jwc_with_headers(resp: V, add: Vec<(String, String)>) -> V {
    let mut m = match resp {
        V::Object(o) if matches!(o.get(HTTP_RESPONSE_MARKER), Some(V::Bool(true))) => (*o).clone(),
        // Not a response: the interpreter queues the headers on the request
        // instead, and the after-chain merges them onto whatever is sent.
        other => {
            for (k, v) in add {
                jwc_b_response_set_header(v_str(k), v_str(v));
            }
            return other;
        }
    };
    let mut headers = match m.get("headers") {
        Some(V::Object(h)) => (**h).clone(),
        _ => JwcObj::default(),
    };
    for (k, v) in add {
        let lower = k.to_ascii_lowercase();
        let existing: Vec<String> = headers
            .keys()
            .filter(|h| h.to_ascii_lowercase() == lower)
            .cloned()
            .collect();
        for e in existing {
            headers.remove(&e);
        }
        headers.insert(k, v_str(v));
    }
    // `content_type` is a field of its own on the response object and
    // `jwc_to_response` reads it *before* the headers map, so a
    // `with { "Content-Type": … }` that only landed in the map would be
    // overwritten by the builder's.
    if let Some(ct) = headers
        .iter()
        .find(|(k, _)| k.eq_ignore_ascii_case("content-type"))
        .map(|(_, v)| v.clone())
    {
        m.insert("content_type".to_string(), ct);
    }
    m.insert("headers".to_string(), v_obj(headers));
    v_obj(m)
}

/// Merge headers onto a finished response value.
fn jwc_response_with_headers(resp: V, add: Vec<(String, String)>) -> V {
    if add.is_empty() {
        return resp;
    }
    let mut m = match resp {
        V::Object(o) => (*o).clone(),
        other => {
            // Not a response object — `after` cannot decorate what is not a
            // response, and dropping the headers is better than dropping the
            // body.
            return other;
        }
    };
    let mut headers = match m.get("headers") {
        Some(V::Object(h)) => (**h).clone(),
        _ => JwcObj::default(),
    };
    for (k, v) in add {
        headers.insert(k, v_str(v));
    }
    m.insert("headers".to_string(), v_obj(headers));
    v_obj(m)
}

fn jwc_set_response_status(status: u16) {
    let _ = CURRENT_REQUEST.try_with(|req| {
        req.response_status
            .store(status, std::sync::atomic::Ordering::Relaxed);
    });
}

// `request_id()` — the stable per-request identifier the server stamps.
// `None` when the runtime can't find an in-flight request (e.g. called
// from `main()` before `serve(port)`). Matches the interpreter shape so
// programs stay portable between `jwc run` and `jwc build --native`.
fn jwc_b_request_id() -> V {
    with_current_request(|req| {
        req.headers
            .get("x-jwc-request-id")
            .cloned()
            .map(v_str)
            .unwrap_or(V::Null)
    })
}

// `client_ip()` — original client IP when the request flows through a
// proxy. Reads the header named by `JWC_REAL_IP_HEADER` (default
// `x-forwarded-for`), walks the comma-separated chain RIGHT to LEFT
// peeling off any entries listed in `JWC_TRUSTED_PROXIES`, and returns
// the first untrusted entry. Empty trust list ⇒ rightmost wins.
fn jwc_b_client_ip() -> V {
    let header_name = std::env::var("JWC_REAL_IP_HEADER")
        .unwrap_or_else(|_| "x-forwarded-for".to_string());
    let key = header_name.to_lowercase();
    let trusted_raw = std::env::var("JWC_TRUSTED_PROXIES").unwrap_or_default();
    let trusted: Vec<String> = trusted_raw
        .split(',')
        .map(|s| s.trim().to_string())
        .filter(|s| !s.is_empty())
        .collect();
    with_current_request(|req| {
        let raw = match req.headers.get(&key) {
            Some(v) => v,
            None => return V::Null,
        };
        for entry in raw.split(',').rev() {
            let candidate = entry.trim();
            if candidate.is_empty() { continue; }
            let is_trusted = trusted.iter().any(|p| candidate.starts_with(p.as_str()));
            if !is_trusted {
                return v_str(candidate.to_string());
            }
        }
        V::Null
    })
}

fn jwc_b_request_path() -> V {
    with_current_request(|req| v_str(req.path.clone()))
}

/// routing.md §5.4 — the *declared* pattern, not the request path, so a
/// rate-limit key buckets by route rather than by every distinct id.
fn jwc_b_request_route() -> V {
    with_current_request(|req| v_str(req.route_pattern.clone()))
}

fn jwc_b_request_method() -> V {
    with_current_request(|req| v_str(req.method.clone()))
}

fn jwc_b_body() -> V {
    with_current_request(|req| {
        if req.body.is_empty() {
            return V::Null;
        }
        let as_str = String::from_utf8_lossy(&req.body).to_string();
        // Auto-parse JSON bodies to match interpreter semantics.
        match jwc_from_json(&as_str) {
            Ok(parsed) => parsed,
            Err(_) => v_str(as_str),
        }
    })
}

/// `request_body()` — the **raw** body as a string, where `body()` above
/// hands back the parsed JSON value. Both spellings exist and they are not
/// interchangeable, so this cannot delegate to `jwc_b_body`.
///
/// Mirrors `eval_request_body_call`: the literal string `"null"` when there
/// is no body, no request in scope, and no `JWC_REQUEST_BODY` — not `V::Null`.
/// Callers do `if request_body() == "null"`, which a real null would fail.
fn jwc_b_request_body() -> V {
    let from_req = with_current_request(|req| {
        if req.body.is_empty() {
            V::Null
        } else {
            v_str(String::from_utf8_lossy(&req.body).to_string())
        }
    });
    if matches!(from_req, V::Str(_)) {
        return from_req;
    }
    match std::env::var("JWC_REQUEST_BODY") {
        Ok(s) => v_str(s),
        Err(_) => v_str("null".to_string()),
    }
}

// --- response helpers --------------------------------------------------------

fn make_response(status: u16, body: String, content_type: &str) -> V {
    make_response_with_headers(status, body, content_type, JwcObj::default())
}

fn make_response_with_headers(
    status: u16,
    body: String,
    content_type: &str,
    headers: JwcObj,
) -> V {
    let mut m: JwcObj = JwcObj::default();
    m.insert(HTTP_RESPONSE_MARKER.to_string(), V::Bool(true));
    m.insert("status".to_string(), V::Int(status as i64));
    m.insert("body".to_string(), v_str(body));
    m.insert("content_type".to_string(), v_str(content_type.to_string()));
    if !headers.is_empty() {
        m.insert("headers".to_string(), v_obj(headers));
    }
    v_obj(m)
}

/// `exec_call::respond` — the response builders' shared core.
///
/// A value that is **already** a response keeps its body and its headers and
/// only has its status replaced. That is what makes `created(json($row))`
/// mean 201-with-that-body rather than 201-wrapping-a-response-object, and
/// the same for `statusCode(302, redirect(...))`.
fn jwc_respond(status: u16, v: V) -> V {
    if let V::Object(ref m) = v {
        if matches!(m.get(HTTP_RESPONSE_MARKER), Some(V::Bool(true))) {
            let mut inner = (**m).clone();
            inner.insert("status".to_string(), V::Int(status as i64));
            return v_obj(inner);
        }
    }
    make_response(status, jwc_to_json(&v), JWC_JSON_CT)
}

/// `exec_call::respond_message` — the `{"error": msg}` envelope.
fn jwc_respond_message(status: u16, message: &str) -> V {
    make_response(
        status,
        format!("{{\"error\":{}}}", jwc_json_string(message)),
        JWC_JSON_CT,
    )
}

/// `exec_call::respond_empty` — no body and, deliberately, **no headers**:
/// a 204 that announced a content-type would be describing a body it does
/// not have.
fn jwc_respond_empty(status: u16) -> V {
    make_response(status, String::new(), "")
}

fn body_string(v: V) -> String {
    match v {
        V::Str(s) => s.into_owned(),
        V::Null => String::new(),
        v => jwc_to_json(&v),
    }
}

fn jwc_b_text(v: V) -> V {
    make_response(200, body_string(v), "text/plain; charset=utf-8")
}

/// Append `; charset=utf-8` to text-ish MIME types that don't already declare a
/// charset; binary/other types pass through verbatim. Mirrors the interpreter's
/// `normalize_content_type` so both runtimes emit identical headers.
fn jwc_normalize_content_type(mime: &str) -> String {
    if mime.to_ascii_lowercase().contains("charset") {
        mime.to_string()
    } else if mime.starts_with("text/") {
        format!("{}; charset=utf-8", mime)
    } else {
        mime.to_string()
    }
}

fn jwc_b_response(body: V, mime: V) -> V {
    let m = match mime {
        V::Str(s) => s,
        other => panic!("response() mime must be a string, got {:?}", other),
    };
    make_response(200, body_string(body), &jwc_normalize_content_type(m.as_ref()))
}

fn jwc_b_raw(body: V, mime: V) -> V {
    jwc_b_response(body, mime)
}

fn jwc_b_html(v: V) -> V {
    make_response(200, body_string(v), "text/html; charset=utf-8")
}

fn jwc_b_json(v: V) -> V {
    let body = jwc_to_json(&v);
    // Phase 4 [1.0-blocker] — `json(s)` on a `V::Str` validates the string
    // is well-formed JSON in DEBUG builds. Release skips the check (this is
    // the production hot path); callers wanting unconditional skip use
    // `json_unchecked()`. The dev-build interpreter does the unconditional
    // check; this `cfg(debug_assertions)` mirror catches AOT-only regressions
    // during development without ever costing on the production binary.
    #[cfg(debug_assertions)]
    if let V::Str(ref s) = v {
        if let Err(e) = serde_json::from_str::<serde_json::Value>(s.as_ref()) {
            let preview: String = s.chars().take(40).collect();
            let ellipsis = if s.chars().count() > 40 { "..." } else { "" };
            panic!(
                "json(): argument is not valid JSON — got '{preview}{ellipsis}' (use json_unchecked() to skip validation): {e}"
            );
        }
    }
    jwc_respond(200, v)
}

/// `json_unchecked(v)` — bypass the string-validation arm of `json(v)`.
/// Caller MUST guarantee the string is valid JSON; the runtime trusts it
/// without checking. Used by hot paths that have already validated the
/// payload (DB select results, body() strings already known to be JSON).
fn jwc_b_json_unchecked(v: V) -> V {
    let body = jwc_to_json(&v);
    make_response(200, body, JWC_JSON_CT)
}

fn jwc_b_ok(v: V) -> V {
    match &v {
        V::Str(_) => jwc_b_text(v),
        _ => jwc_b_json(v),
    }
}

// --- responses (routing.md §6.1) ---------------------------------------------
//
// One builder per line of `exec_call.rs`'s response block, in the same order
// and with the same argument treatment. The 0.9 shapes these replace differed
// in ways that only showed at the wire: `notFound("gone")` served four bytes
// of `text/plain` here and `{"error":"gone"}` under `jwc run`.

fn jwc_b_created(v: V) -> V {
    jwc_respond(201, v)
}

fn jwc_b_accepted(v: V) -> V {
    jwc_respond(202, v)
}

fn jwc_b_no_content(_v: V) -> V {
    jwc_respond_empty(204)
}

/// `badRequest(v)` takes a **value**, not a message: it is the one 4xx
/// builder whose argument is the body.
fn jwc_b_bad_request(v: V) -> V {
    jwc_respond(400, v)
}

fn jwc_b_unauthorized(v: V) -> V {
    jwc_respond_message(401, jwc_str_view(&v).unwrap_or(""))
}

fn jwc_b_forbidden(v: V) -> V {
    jwc_respond_message(403, jwc_str_view(&v).unwrap_or(""))
}

fn jwc_b_not_found(v: V) -> V {
    jwc_respond_message(404, jwc_str_view(&v).unwrap_or(""))
}

fn jwc_b_conflict(v: V) -> V {
    jwc_respond_message(409, jwc_str_view(&v).unwrap_or(""))
}

fn jwc_b_too_many_requests(v: V) -> V {
    jwc_respond_message(429, jwc_str_view(&v).unwrap_or(""))
}

/// Takes no argument in 1.0 and has one fixed message: an internal error is
/// not a place to leak what went wrong.
fn jwc_b_internal_error(_v: V) -> V {
    jwc_respond_message(500, "internal_error")
}

fn jwc_b_status_code(code: V, v: V) -> V {
    jwc_respond(jwc_to_int(&code).unwrap_or(200) as u16, v)
}

fn jwc_b_redirect(code: V, location: V) -> V {
    let status = jwc_to_int(&code).unwrap_or(302) as u16;
    let mut headers = JwcObj::default();
    headers.insert(
        "location".to_string(),
        v_str(jwc_str_view(&location).unwrap_or("").to_string()),
    );
    make_response_with_headers(status, String::new(), "", headers)
}

/// routing.md §6.5 — verbatim body, declared type. Every other builder
/// JSON-encodes, which for an HTML page means the browser is handed a
/// quoted string.
fn jwc_b_content(mime: V, body: V) -> V {
    let m = jwc_str_view(&mime).unwrap_or("").to_string();
    make_response(
        200,
        jwc_str_view(&body).unwrap_or("").to_string(),
        &jwc_normalize_content_type(&m),
    )
}

/// Extract the wire HTTP status from a handler return value WITHOUT
/// consuming or stringifying the body. Used by the route dispatcher to
/// populate `Request::response_status` before the after-block chain
/// runs — so `response_status()` is non-null inside `after { ... }`.
fn jwc_status_of(v: &V) -> u16 {
    match v {
        V::Object(m) => {
            if matches!(m.get(HTTP_RESPONSE_MARKER), Some(V::Bool(true))) {
                return m.get("status").and_then(jwc_to_int).unwrap_or(200) as u16;
            }
            200
        }
        // Phase 1 — handlers may now return a `V::Record` directly when a
        // route literal produces the response shape. Look up the marker
        // via the same field accessor used by `obj.field` reads.
        V::Record { .. } => {
            if matches!(jwc_get_field(v, HTTP_RESPONSE_MARKER), V::Bool(true)) {
                let s = jwc_get_field(v, "status");
                return jwc_to_int(&s).unwrap_or(200) as u16;
            }
            200
        }
        _ => 200,
    }
}

fn jwc_to_response(v: V) -> (u16, String, String, Vec<(String, String)>) {
    if let V::Object(ref m) = v {
        if matches!(m.get(HTTP_RESPONSE_MARKER), Some(V::Bool(true))) {
            let status = m.get("status").and_then(jwc_to_int).unwrap_or(200) as u16;
            let body = match m.get("body") {
                Some(V::Str(s)) => s.clone().into_owned(),
                Some(other) => jwc_to_json(other),
                None => String::new(),
            };
            let ct = match m.get("content_type") {
                Some(V::Str(s)) => s.clone().into_owned(),
                _ => "text/plain; charset=utf-8".to_string(),
            };
            let _ = &ct;
            let headers: Vec<(String, String)> = match m.get("headers") {
                Some(V::Object(hm)) => hm
                    .iter()
                    .map(|(k, v)| (k.clone(), body_string(v.clone())))
                    .collect(),
                _ => Vec::new(),
            };
            return (status, body, ct, headers);
        }
    }
    // Everything that did NOT come through `text()` / `html()` /
    // `response()` — i.e. every handler that just returns a value — gets
    // `application/json`, matching `server.rs`:
    //
    //     let ct = content_type.as_deref().unwrap_or("application/json");
    //
    // A bare `V::Str` used to be guessed as `text/plain`, which is wrong
    // for the common case of a handler that hand-builds a JSON document
    // and returns the string: jwc-shortener's `/openapi.json` served
    // `text/plain` natively and `application/json` under the interpreter,
    // so Swagger UI refused the spec from the native binary only.
    //
    // A handler that genuinely wants another type says so — `text(v)`,
    // `html(v)`, or `response(v, "image/svg+xml")` — and takes the
    // marker path above instead.
    //
    // `V::Null` (handler fell off the end, or returned nothing) is the
    // JSON document `null`, not an empty body, again mirroring the
    // interpreter's `response_str.unwrap_or_else(|| "null".to_string())`.
    match v {
        V::Str(s) => (200, s.into_owned(), JWC_JSON_CT.to_string(), Vec::new()),
        V::Null => (200, "null".to_string(), JWC_JSON_CT.to_string(), Vec::new()),
        other => (200, jwc_to_json(&other), JWC_JSON_CT.to_string(), Vec::new()),
    }
}

// --- routing -----------------------------------------------------------------

#[derive(Clone)]
enum PathSeg {
    Literal(String),
    /// `{id: bigint}` — the declared type travels with the segment because
    /// routing.md §3.2 parses a path parameter *before* any middleware runs,
    /// and a value that does not parse is a 400 there, not a 500 in the
    /// query layer.
    Param { name: String, ty: String },
}

#[derive(Clone, Copy)]
enum RouteKind {
    Http,
    Ws,
}

struct RouteEntry {
    method: String,
    segments: Vec<PathSeg>,
    /// The declared pattern with the type annotations stripped —
    /// `/orgs/{org_id}`. What `request.route()` answers (routing.md §5.4).
    pattern: String,
    kind: RouteKind,
    handler: RouteFn,
}

struct Router {
    entries: Vec<RouteEntry>,
}

impl Router {
    fn new() -> Self { Router { entries: Vec::new() } }

    fn add(&mut self, method: &str, pattern: &str, handler: RouteFn) {
        self.add_kind(method, pattern, RouteKind::Http, handler);
    }

    fn add_ws(&mut self, pattern: &str, handler: RouteFn) {
        self.add_kind("GET", pattern, RouteKind::Ws, handler);
    }

    fn add_kind(&mut self, method: &str, pattern: &str, kind: RouteKind, handler: RouteFn) {
        let segments: Vec<PathSeg> = pattern
            .trim_start_matches('/')
            .split('/')
            .filter(|s| !s.is_empty())
            .map(|s| {
                if s.starts_with('{') && s.ends_with('}') {
                    let inner = &s[1..s.len() - 1];
                    let (name, ty) = match inner.split_once(':') {
                        Some((n, t)) => (n.trim(), t.trim()),
                        None => (inner.trim(), "text"),
                    };
                    PathSeg::Param { name: name.to_string(), ty: ty.to_string() }
                } else {
                    PathSeg::Literal(s.to_string())
                }
            })
            .collect();
        let mut rendered = String::new();
        for seg in &segments {
            rendered.push('/');
            match seg {
                PathSeg::Literal(l) => rendered.push_str(l),
                PathSeg::Param { name, .. } => {
                    rendered.push('{');
                    rendered.push_str(name);
                    rendered.push('}');
                }
            }
        }
        if rendered.is_empty() {
            rendered.push('/');
        }
        self.entries.push(RouteEntry {
            method: method.to_string(),
            segments,
            pattern: rendered,
            kind,
            handler,
        });
    }

    fn match_route(
        &self,
        method: &str,
        path: &str,
    ) -> Option<(RouteKind, RouteFn, String, BTreeMap<String, String>, Vec<(String, String)>)> {
        let req_segs: Vec<&str> = path.trim_matches('/').split('/').filter(|s| !s.is_empty()).collect();
        // routing.md §4.2 — the winner is the candidate with the most
        // **literal** segments, not the first one registered. jwc-shortener
        // declares `/{code}` for its redirects and `/docs`, `/openapi.json`,
        // `/robots.txt`, `/sitemap.xml` and `/og.svg` beside it; first-match
        // gave every one of those the redirect handler and a 404.
        let mut best: Option<(&RouteEntry, BTreeMap<String, String>, Vec<(String, String)>, usize)> =
            None;
        for entry in &self.entries {
            if entry.method != method { continue; }
            if entry.segments.len() != req_segs.len() { continue; }
            let mut params = BTreeMap::new();
            let mut types: Vec<(String, String)> = Vec::new();
            let mut literals = 0usize;
            let mut ok = true;
            for (seg, req) in entry.segments.iter().zip(req_segs.iter()) {
                match seg {
                    PathSeg::Literal(lit) => {
                        if lit == req {
                            literals += 1;
                        } else {
                            ok = false;
                            break;
                        }
                    }
                    PathSeg::Param { name, ty } => {
                        params.insert(name.clone(), (*req).to_string());
                        types.push((name.clone(), ty.clone()));
                    }
                }
            }
            if !ok { continue; }
            if best.as_ref().is_none_or(|(_, _, _, n)| literals > *n) {
                best = Some((entry, params, types, literals));
            }
        }
        best.map(|(e, params, types, _)| (e.kind, e.handler, e.pattern.clone(), params, types))
    }

    /// Verbs declared on a path that a request's own method didn't match.
    /// Empty means the path itself is unknown — the difference between a 405
    /// and a 404, which the router previously collapsed into one answer.
    fn allowed_methods(&self, path: &str) -> Vec<String> {
        let req_segs: Vec<&str> = path.trim_start_matches('/').split('/').filter(|s| !s.is_empty()).collect();
        let mut out: Vec<String> = Vec::new();
        for entry in &self.entries {
            if entry.segments.len() != req_segs.len() { continue; }
            let mut ok = true;
            for (seg, req) in entry.segments.iter().zip(req_segs.iter()) {
                if let PathSeg::Literal(lit) = seg {
                    if lit != req { ok = false; break; }
                }
            }
            if ok {
                let m = entry.method.to_ascii_uppercase();
                if !out.contains(&m) { out.push(m); }
            }
        }
        out.sort();
        out
    }
}

// --- CORS --------------------------------------------------------------------
//
// Mirrors `jwc::cors` in the interpreter, including the defaults and the
// wildcard-plus-credentials rejection, so a project behaves the same whether
// it is run with `jwc run` or built with `jwc build --native`.

#[derive(Debug, Clone, Default)]
struct JwcCors {
    enabled: bool,
    any_origin: bool,
    origins: Vec<String>,
    methods: String,
    headers: String,
    expose: String,
    credentials: bool,
    max_age: String,
}

fn jwc_cors_env(key: &str, default: &str) -> String {
    match std::env::var(key) {
        Ok(v) if !v.trim().is_empty() => v,
        _ => default.to_string(),
    }
}

fn jwc_cors_norm(origin: &str) -> String {
    origin.trim().trim_end_matches('/').to_ascii_lowercase()
}

impl JwcCors {
    fn from_env() -> Self {
        let raw = jwc_cors_env("JWC_CORS_ORIGINS", "");
        let raw = raw.trim().to_string();
        if raw.is_empty() {
            return Self::default();
        }
        let any_origin = raw == "*";
        let origins = if any_origin {
            Vec::new()
        } else {
            raw.split(',').map(jwc_cors_norm).filter(|o| !o.is_empty()).collect()
        };
        JwcCors {
            enabled: true,
            any_origin,
            origins,
            methods: jwc_cors_env("JWC_CORS_METHODS", "GET,POST,PUT,PATCH,DELETE,OPTIONS"),
            headers: jwc_cors_env("JWC_CORS_HEADERS", "content-type,authorization"),
            expose: jwc_cors_env("JWC_CORS_EXPOSE_HEADERS", "x-request-id"),
            credentials: matches!(
                jwc_cors_env("JWC_CORS_CREDENTIALS", "0").trim().to_ascii_lowercase().as_str(),
                "1" | "true" | "yes" | "on"
            ),
            max_age: jwc_cors_env("JWC_CORS_MAX_AGE", "86400"),
        }
    }

    fn validate(&self) -> Result<(), String> {
        if self.enabled && self.any_origin && self.credentials {
            return Err("JWC_CORS_ORIGINS=* cannot be combined with JWC_CORS_CREDENTIALS=1 — \
                        browsers reject `Access-Control-Allow-Origin: *` on a credentialed \
                        request. List the exact origins instead."
                .to_string());
        }
        Ok(())
    }

    fn allow_origin(&self, origin: &str) -> Option<String> {
        if !self.enabled {
            return None;
        }
        if self.any_origin {
            return Some("*".to_string());
        }
        let probe = jwc_cors_norm(origin);
        if self.origins.iter().any(|o| jwc_cors_norm(o) == probe) {
            Some(origin.to_string())
        } else {
            None
        }
    }
}

fn jwc_cors_set(resp: &mut axum::response::Response, name: &'static str, value: &str) {
    if let Ok(v) = axum::http::HeaderValue::from_str(value) {
        resp.headers_mut().insert(axum::http::HeaderName::from_static(name), v);
    }
}

fn jwc_cors_decorate(resp: &mut axum::response::Response, cfg: &JwcCors, allow_origin: &str) {
    jwc_cors_set(resp, "access-control-allow-origin", allow_origin);
    if cfg.credentials {
        jwc_cors_set(resp, "access-control-allow-credentials", "true");
    }
    if allow_origin != "*" {
        jwc_cors_set(resp, "vary", "Origin");
    }
}

async fn jwc_cors_middleware(
    cfg: Arc<JwcCors>,
    req: axum::extract::Request,
    next: axum::middleware::Next,
) -> axum::response::Response {
    let origin = req
        .headers()
        .get("origin")
        .and_then(|v| v.to_str().ok())
        .map(|s| s.to_string());
    let Some(origin) = origin else {
        return next.run(req).await;
    };
    let allow = cfg.allow_origin(&origin);

    let is_preflight = req.method() == axum::http::Method::OPTIONS
        && req.headers().contains_key("access-control-request-method");
    if is_preflight {
        let mut resp = axum::response::Response::new(axum::body::Body::empty());
        *resp.status_mut() = axum::http::StatusCode::NO_CONTENT;
        if let Some(allow) = &allow {
            jwc_cors_decorate(&mut resp, &cfg, allow);
            jwc_cors_set(&mut resp, "access-control-allow-methods", &cfg.methods);
            jwc_cors_set(&mut resp, "access-control-allow-headers", &cfg.headers);
            jwc_cors_set(&mut resp, "access-control-max-age", &cfg.max_age);
        }
        return resp;
    }

    let mut resp = next.run(req).await;
    if let Some(allow) = &allow {
        jwc_cors_decorate(&mut resp, &cfg, allow);
        if !cfg.expose.is_empty() {
            jwc_cors_set(&mut resp, "access-control-expose-headers", &cfg.expose);
        }
    }
    resp
}

// --- HTTP server (axum-based, HTTP/1.1 + keep-alive) -------------------------

/// Request body cap. Mirrors `server.rs::parse_max_body_bytes` exactly,
/// including the axum-default 2 MiB when `JWC_MAX_BODY_BYTES` is unset
/// and the `0` escape hatch for deployments behind a proxy that already
/// enforces a size. `None` means "no limit".
const JWC_DEFAULT_MAX_BODY_BYTES: usize = 2 * 1024 * 1024;

fn jwc_max_body_bytes() -> Option<usize> {
    match std::env::var("JWC_MAX_BODY_BYTES")
        .ok()
        .and_then(|v| v.trim().parse::<usize>().ok())
    {
        Some(0) => None,
        Some(n) => Some(n),
        None => Some(JWC_DEFAULT_MAX_BODY_BYTES),
    }
}

struct HttpServer {
    port: u16,
    router: Arc<Router>,
}

impl HttpServer {
    fn new(port: u16, router: Router) -> Self {
        HttpServer { port, router: Arc::new(router) }
    }

    async fn run(self) {
        let mut app = axum::Router::new()
            .fallback(axum::routing::any(handle_axum_request))
            .with_state(self.router.clone());
        // Same CORS contract as the interpreter: off unless
        // `JWC_CORS_ORIGINS` is set, preflights answered before routing.
        let cors = Arc::new(JwcCors::from_env());
        if let Err(e) = cors.validate() {
            eprintln!("[jwc] {}", e);
            std::process::exit(1);
        }
        if cors.enabled {
            let cors = cors.clone();
            app = app.layer(axum::middleware::from_fn(move |req, next| {
                let cors = cors.clone();
                async move { jwc_cors_middleware(cors, req, next).await }
            }));
        }
        // Body-size cap, same contract as `server.rs::build_router`: a
        // native binary used to buffer an unbounded `curl -d @huge.bin`
        // straight into the `Bytes` extractor, so one client could OOM
        // the process — a limit the interpreter has had all along.
        match jwc_max_body_bytes() {
            Some(max) => app = app.layer(axum::extract::DefaultBodyLimit::max(max)),
            None => app = app.layer(axum::extract::DefaultBodyLimit::disable()),
        }
        // Prefer dual-stack so a Node dev proxy resolving `localhost` to `::1`
        // can connect; fall back to IPv4 on hosts with no IPv6 stack.
        //
        // `JWC_BIND_HOST` overrides the address entirely — set it to
        // `0.0.0.0` to force IPv4-only, or to a specific interface.
        let v6 = std::net::SocketAddr::from((std::net::Ipv6Addr::UNSPECIFIED, self.port));
        let v4 = std::net::SocketAddr::from(([0, 0, 0, 0], self.port));
        let explicit = std::env::var("JWC_BIND_HOST").ok().and_then(|h| {
            let h = h.trim().trim_start_matches('[').trim_end_matches(']').to_string();
            match h.parse::<std::net::IpAddr>() {
                Ok(ip) => Some(std::net::SocketAddr::from((ip, self.port))),
                Err(_) => {
                    eprintln!("[jwc] ignoring JWC_BIND_HOST={:?}: not an IP address", h);
                    None
                }
            }
        });
        let (listener, addr) = match explicit {
            Some(a) => match jwc_bind_dual_stack(a).await {
                Ok(l) => (l, a),
                Err(e) => {
                    eprintln!("[jwc] failed to bind {} ({})", a, e);
                    std::process::exit(1);
                }
            },
            None => match jwc_bind_dual_stack(v6).await {
                Ok(l) => (l, v6),
                Err(v6_err) => match TcpListener::bind(v4).await {
                    Ok(l) => (l, v4),
                    Err(e) => {
                        eprintln!("[jwc] failed to bind {} ({}) or {} ({})", v6, v6_err, v4, e);
                        std::process::exit(1);
                    }
                },
            },
        };
        eprintln!("[jwc] listening on http://{}", addr);
        if let Err(e) = axum::serve(listener, app)
            .with_graceful_shutdown(jwc_shutdown_signal())
            .await
        {
            eprintln!("[jwc] server error: {}", e);
        }
    }
}

/// Resolves on Ctrl+C (SIGINT). Logs the drain notice and arms a watchdog that
/// force-exits if inflight requests don't drain within `JWC_SHUTDOWN_TIMEOUT`
/// (default 5s). Handed to axum's `with_graceful_shutdown`, which stops
/// accepting new connections and waits for inflight requests to finish.
async fn jwc_shutdown_signal() {
    if tokio::signal::ctrl_c().await.is_err() {
        return;
    }
    eprintln!("Shutdown signal received, draining inflight requests...");
    let timeout: u64 = std::env::var("JWC_SHUTDOWN_TIMEOUT")
        .ok()
        .and_then(|v| v.parse::<u64>().ok())
        .filter(|v| *v > 0)
        .unwrap_or(5);
    tokio::spawn(async move {
        tokio::time::sleep(std::time::Duration::from_secs(timeout)).await;
        eprintln!("Graceful shutdown timed out after {}s; forcing exit.", timeout);
        std::process::exit(0);
    });
}

/// config.md §4 — `/healthz`, `/readyz` and `/metrics`, at fixed names,
/// reachable before anyone reads the source.
///
/// `jwc_op_*` are shims codegen emits: the real implementations live in the
/// DB and Redis preludes, which are only concatenated for programs that
/// reach for them, and these three endpoints exist either way.
async fn jwc_operational(method: &str, path: &str) -> Option<axum::response::Response> {
    if !method.eq_ignore_ascii_case("GET") {
        return None;
    }
    let json = |status: u16, body: String| {
        axum::response::Response::builder()
            .status(status)
            .header("content-type", JWC_JSON_CT)
            .body(body.into())
            .unwrap()
    };
    match path.trim_end_matches('/') {
        // Liveness. Touches nothing: a process that answers this is one the
        // supervisor should not kill. Wiring a dependency in here is the
        // classic way to turn a database blip into a restart storm.
        "/healthz" => Some(json(200, "{\"status\":\"ok\"}".to_string())),

        // Readiness. Every configured dependency, actually round-tripped.
        "/readyz" => {
            let failed = jwc_op_readiness().await;
            Some(if failed.is_empty() {
                json(200, "{\"status\":\"ready\"}".to_string())
            } else {
                // 503, and the body names which dependency. A probe that
                // only says "not ready" sends the operator to the logs of a
                // pod that is already out of rotation.
                let list = failed
                    .iter()
                    .map(|f| format!("\"{}\"", f))
                    .collect::<Vec<_>>()
                    .join(",");
                json(
                    503,
                    format!("{{\"status\":\"unready\",\"failed\":[{}]}}", list),
                )
            })
        }

        "/metrics" => Some(
            axum::response::Response::builder()
                .status(200)
                .header("content-type", "text/plain; version=0.0.4; charset=utf-8")
                .body(jwc_op_metrics().into())
                .unwrap(),
        ),
        _ => None,
    }
}

async fn handle_axum_request(
    axum::extract::State(router): axum::extract::State<Arc<Router>>,
    method: axum::http::Method,
    uri: axum::http::Uri,
    headers: axum::http::HeaderMap,
    body: axum::body::Bytes,
) -> axum::response::Response {
    let path_str = uri.path();
    let mut query_map: BTreeMap<String, String> = BTreeMap::new();
    if let Some(q) = uri.query() {
        for pair in q.split('&') {
            if pair.is_empty() { continue; }
            let (k, v) = match pair.find('=') {
                Some(i) => (&pair[..i], &pair[i + 1..]),
                None => (pair, ""),
            };
            query_map.insert(url_decode(k), url_decode(v));
        }
    }
    let mut header_map: BTreeMap<String, String> = BTreeMap::new();
    for (name, value) in headers.iter() {
        header_map.insert(
            name.as_str().to_ascii_lowercase(),
            value.to_str().unwrap_or("").to_string(),
        );
    }
    let method_str = method.as_str().to_string();

    let matched = router.match_route(&method_str, path_str);
    // config.md §4.0.3 — §4.0.2 promises these three are reachable before
    // reading anyone's source, so a wildcard pattern nobody aimed at them
    // must not take that away. A route that matched *without* binding a
    // path parameter was aimed here deliberately and wins.
    if matched.as_ref().is_some_and(|(_, _, _, binds, _)| !binds.is_empty()) {
        if let Some(r) = jwc_operational(&method_str, path_str).await {
            return r;
        }
    }
    let (kind, handler, route_pattern, path_params, param_types) = match matched {
        Some(found) => found,
        None => {
            if let Some(r) = jwc_operational(&method_str, path_str).await {
                return r;
            }
            // `serve.rs` answers one thing for anything unmatched:
            // `Response::message(404, "not found")`. The richer envelope
            // this used to build — and the 405 with `Allow` — came from
            // 0.9, where the interpreter did the same. It no longer does,
            // so a native binary that kept them disagreed with `jwc serve`
            // on every miss.
            return axum::response::Response::builder()
                .status(404)
                .header("content-type", JWC_JSON_CT)
                .body("{\"error\":\"not found\"}".into())
                .unwrap();
        }
    };

    if matches!(kind, RouteKind::Ws) {
        return axum::response::Response::builder()
            .status(501)
            .header("content-type", "text/plain; charset=utf-8")
            .body("WebSocket not supported in native build yet; use `jwc run` or `jwc build` (without --native).".into())
            .unwrap();
    }

    // routing.md §3.2 — parsed here, ahead of the chain. A segment that is
    // not the type the route declared is a 400 that never reaches user code.
    let typed_params = match jwc_parse_path_params(&path_params, &param_types) {
        Ok(t) => t,
        Err((status, body)) => {
            return axum::response::Response::builder()
                .status(status)
                .header("content-type", JWC_JSON_CT)
                .body(body.into())
                .unwrap();
        }
    };

    let req = Arc::new(Request {
        method: method_str,
        path: path_str.to_string(),
        query: query_map,
        headers: header_map,
        body: body.to_vec(),
        path_params,
        typed_params,
        route_pattern,
        http_version_11: true,
        started_at: std::time::Instant::now(),
        response_status: std::sync::atomic::AtomicU16::new(0),
        extra_headers: std::sync::Mutex::new(Vec::new()),
        context: std::sync::Mutex::new(JwcObj::default()),
    });

    // A panic is the native backend's `Abort::Fault`: the interpreter logs
    // it and answers 500. Without this guard the panic unwound into hyper
    // and the client got a dropped connection instead of a response — the
    // one failure mode a client cannot distinguish from the server being
    // gone.
    let guarded = std::panic::AssertUnwindSafe(
        CURRENT_REQUEST.scope(req, async move { handler().await }),
    );
    let result_v = match futures::FutureExt::catch_unwind(guarded).await {
        Ok(v) => v,
        Err(payload) => {
            let msg = payload
                .downcast_ref::<String>()
                .cloned()
                .or_else(|| payload.downcast_ref::<&str>().map(|s| (*s).to_string()))
                .unwrap_or_else(|| "panic".to_string());
            eprintln!("[fault] {}", msg);
            return axum::response::Response::builder()
                .status(500)
                .header("content-type", JWC_JSON_CT)
                .body("{\"error\":\"internal_error\"}".into())
                .unwrap();
        }
    };

    let (status, body_str, ct, extra_headers) = jwc_to_response(result_v);
    let status_code = axum::http::StatusCode::from_u16(status).unwrap_or(axum::http::StatusCode::OK);
    let mut builder = axum::response::Response::builder().status(status_code);
    // `respond_empty` leaves this blank on purpose (204, 3xx): a response
    // with no body has no type to declare.
    if !ct.is_empty() {
        builder = builder.header("content-type", ct.as_str());
    }
    for (k, v) in extra_headers {
        // Drop pairs whose name or value contain characters axum would
        // refuse — silently, because user code rarely has the context to
        // recover and we'd rather emit the redirect than 500. CRLF in
        // either side is the classic response-splitting vector, so we
        // reject it explicitly here (the interpreter path goes through
        // `axum::http::HeaderValue::parse()` which rejects the same
        // bytes; keep the two paths shape-equivalent).
        let name_ok = !k.is_empty()
            && k.bytes().all(|b| b.is_ascii() && b != b'\n' && b != b'\r' && b != 0);
        let value_ok = v.bytes().all(|b| b != b'\n' && b != b'\r' && b != 0);
        if name_ok && value_ok {
            builder = builder.header(k, v);
        }
    }
    builder.body(body_str.into()).unwrap()
}

fn url_decode(s: &str) -> String {
    let bytes = s.as_bytes();
    let mut out: Vec<u8> = Vec::with_capacity(bytes.len());
    let mut i = 0;
    while i < bytes.len() {
        match bytes[i] {
            b'+' => { out.push(b' '); i += 1; }
            b'%' if i + 2 < bytes.len() => {
                let hex = std::str::from_utf8(&bytes[i + 1..i + 3]).unwrap_or("");
                match u8::from_str_radix(hex, 16) {
                    Ok(b) => { out.push(b); i += 3; }
                    Err(_) => { out.push(bytes[i]); i += 1; }
                }
            }
            b => { out.push(b); i += 1; }
        }
    }
    String::from_utf8_lossy(&out).into_owned()
}

// --- async built-ins: sleep_ms / http_get / fetch_json -----------------------

async fn jwc_b_sleep_ms(n: V) -> V {
    let ms = jwc_to_int(&n).unwrap_or(0).max(0) as u64;
    tokio::time::sleep(std::time::Duration::from_millis(ms)).await;
    V::Null
}


// --- time / identifiers ------------------------------------------------------

fn jwc_b_uuid() -> V {
    // RFC 4122 v4 — random, includes proper version/variant bits.
    v_str(uuid::Uuid::new_v4().to_string())
}

fn jwc_b_now() -> V {
    // ISO-8601 / RFC 3339 UTC, second precision — matches the interpreter's
    // `current_utc_iso8601()`. Postgres accepts this as timestamptz on insert.
    let dt: chrono::DateTime<chrono::Utc> = chrono::Utc::now();
    v_str(dt.format("%Y-%m-%dT%H:%M:%SZ").to_string())
}

// --- process-wide in-memory cache (TTL-keyed, std-only) ---------------------
//
// Mirrors `jwc::cache` from the interpreter: single global Mutex<HashMap>,
// lazy TTL eviction on read. Fine for single-process / single-replica
// deployments; behind multiple replicas use a shared Redis cache instead.

mod jwc_cache_store {
    use std::collections::HashMap;
    use std::sync::{Mutex, OnceLock};
    use std::time::Instant;

    pub struct Entry {
        pub value: String,
        /// `None` means "never expires".
        pub expires_at: Option<Instant>,
    }

    pub fn store() -> &'static Mutex<HashMap<String, Entry>> {
        static STORE: OnceLock<Mutex<HashMap<String, Entry>>> = OnceLock::new();
        STORE.get_or_init(|| Mutex::new(HashMap::new()))
    }
}

fn jwc_b_cache_get(key: V) -> V {
    use std::time::Instant;
    let k = match key {
        V::Str(s) => s.into_owned(),
        _ => return V::Null,
    };
    let mut guard = jwc_cache_store::store().lock().expect("cache mutex poisoned");
    let expired = match guard.get(&k) {
        Some(entry) => match entry.expires_at {
            Some(deadline) => Instant::now() >= deadline,
            None => false,
        },
        None => return V::Null,
    };
    if expired {
        guard.remove(&k);
        return V::Null;
    }
    guard
        .get(&k)
        .map(|e| v_str(e.value.clone()))
        .unwrap_or(V::Null)
}

fn jwc_b_cache_set(key: V, value: V, ttl_secs: V) -> V {
    use std::time::{Duration, Instant};
    let k = match key {
        V::Str(s) => s.into_owned(),
        _ => return V::Null,
    };
    let v = match value {
        V::Str(s) => s.into_owned(),
        V::Int(n) => n.to_string(),
        V::Float(n) => n.to_string(),
        V::Bool(b) => b.to_string(),
        V::Null => String::new(),
        other => jwc_to_json(&other),
    };
    let ttl = jwc_to_int(&ttl_secs).unwrap_or(0).max(0) as u64;
    let expires_at = if ttl == 0 {
        None
    } else {
        Instant::now().checked_add(Duration::from_secs(ttl))
    };
    let mut guard = jwc_cache_store::store().lock().expect("cache mutex poisoned");
    guard.insert(
        k,
        jwc_cache_store::Entry {
            value: v,
            expires_at,
        },
    );
    V::Null
}

fn jwc_b_cache_del(key: V) -> V {
    let k = match key {
        V::Str(s) => s.into_owned(),
        _ => return V::Null,
    };
    jwc_cache_store::store()
        .lock()
        .expect("cache mutex poisoned")
        .remove(&k);
    V::Null
}

fn jwc_b_cache_clear() -> V {
    jwc_cache_store::store()
        .lock()
        .expect("cache mutex poisoned")
        .clear();
    V::Null
}

// --- class validation and the 400 contract (types.md §11) --------------------
//
// `validate.rs` is the interpreter's half. This is that code, transcribed, and
// driven by a table codegen emits from the same `ClassSym`s the checker built.
// Errors are **collected**, never fail-fast, and the response body shape is
// fixed: user code cannot produce a different `validation_failed` payload,
// because validation is not reachable from user code (errors.md §9, E11).

/// What `coerce` needs to know about a field's base type — `Ty` after `?`
/// and `[]` are stripped.
#[derive(Clone, Copy, PartialEq)]
enum JwcTy {
    Boolean,
    Bigint,
    Int,
    Numeric,
    Jsonb,
    /// Every other scalar, and an `enum`: JSON string in, text out.
    Text,
    Class,
}

struct JwcRule {
    name: &'static str,
    /// `minLength(2)` and friends. `None` when the rule takes no argument or
    /// its argument is not an integer literal.
    limit: Option<i64>,
    /// `min(0.01)` — compared as a decimal, not an integer, so
    /// `amount numeric(14,2) min(0)` rejects `-1.00`.
    bound: Option<f64>,
    pattern: &'static str,
}

struct JwcClassField {
    name: &'static str,
    ty: JwcTy,
    /// The nested class's name when `ty` is `Class`, else empty.
    class: &'static str,
    is_array: bool,
    rules: &'static [JwcRule],
}

fn jwc_class(name: &str) -> Option<&'static [JwcClassField]> {
    JWC_CLASSES
        .iter()
        .find(|(n, _)| *n == name)
        .map(|(_, f)| *f)
}

/// `request.body() as <Class>` — routing.md §5.2. The cast is what validates.
fn jwc_validate_body(class: &str) -> JwcResult {
    let raw = with_current_request(|req| v_str(String::from_utf8_lossy(&req.body).to_string()));
    let text = jwc_str_view(&raw).unwrap_or("").to_string();
    let Some(fields) = jwc_class(class) else {
        panic!("unknown class `{}`", class);
    };
    let Ok(parsed) = serde_json::from_str::<serde_json::Value>(&text) else {
        return Err(jwc_validation_error(vec![jwc_field_error(
            "",
            "json",
            None,
            "body is not valid JSON",
        )]));
    };

    let mut out: Vec<(String, V)> = Vec::new();
    let mut failures: Vec<String> = Vec::new();
    jwc_validate_class(fields, &parsed, "", &mut out, &mut failures);
    if !failures.is_empty() {
        return Err(jwc_validation_error(failures));
    }
    Ok(jwc_ordered_record(out))
}

/// An ordered record, the way the interpreter's `Value::Record` is ordered —
/// declaration order, not hash order.
fn jwc_ordered_record(fields: Vec<(String, V)>) -> V {
    let mut names: Vec<JwcStr> = Vec::with_capacity(fields.len());
    let mut values: Vec<V> = Vec::with_capacity(fields.len());
    for (k, v) in fields {
        names.push(Cow::Owned(k));
        values.push(v);
    }
    v_record(Arc::new(names), values)
}

/// types.md §11.3 — validation has one fixed body and user code cannot
/// produce a different one, so it is built here rather than routed through
/// the ordinary `{"error": msg}` envelope.
fn jwc_validation_error(failures: Vec<String>) -> JwcThrown {
    JwcThrown {
        error: "BadRequest",
        status: 400,
        message: "validation_failed".to_string(),
        body: Some(format!(
            "{{\"error\":\"validation_failed\",\"fields\":[{}]}}",
            failures.join(",")
        )),
    }
}

/// One entry of the `fields` array, already encoded — the key order is the
/// contract, so it is written rather than assembled in a map.
fn jwc_field_error(path: &str, rule: &str, limit: Option<i64>, message: &str) -> String {
    match limit {
        Some(l) => format!(
            "{{\"path\":{},\"rule\":{},\"limit\":{},\"message\":{}}}",
            jwc_json_string(path),
            jwc_json_string(rule),
            l,
            jwc_json_string(message)
        ),
        None => format!(
            "{{\"path\":{},\"rule\":{},\"message\":{}}}",
            jwc_json_string(path),
            jwc_json_string(rule),
            jwc_json_string(message)
        ),
    }
}

fn jwc_validate_class(
    fields: &'static [JwcClassField],
    input: &serde_json::Value,
    prefix: &str,
    out: &mut Vec<(String, V)>,
    failures: &mut Vec<String>,
) {
    use serde_json::Value as J;
    let J::Object(map) = input else {
        failures.push(jwc_field_error(prefix, "type", None, "expected an object"));
        return;
    };

    for f in fields {
        let path = if prefix.is_empty() {
            f.name.to_string()
        } else {
            format!("{}.{}", prefix, f.name)
        };
        // types.md §11.5 — unknown keys are dropped silently; the class is
        // the whitelist, and rejecting extras breaks every client that adds
        // a field.
        let present = map.get(f.name);
        let required = f.rules.iter().any(|r| r.name == "required");

        let value = match present {
            None | Some(J::Null) => {
                if required {
                    failures.push(jwc_field_error(
                        &path,
                        "required",
                        None,
                        &format!("{} kerak", f.name),
                    ));
                }
                // §6.5 — absent and null are distinguishable, and absent
                // means "omit the column" downstream.
                if present.is_some() {
                    out.push((f.name.to_string(), V::Null));
                }
                continue;
            }
            Some(v) => v,
        };

        match jwc_coerce(f, value) {
            Some(v) => {
                jwc_check_rules(f, &path, value, &v, failures);
                if f.ty == JwcTy::Class {
                    if let Some(inner) = jwc_class(f.class) {
                        if let J::Object(_) = value {
                            let mut nested = Vec::new();
                            jwc_validate_class(inner, value, &path, &mut nested, failures);
                            out.push((f.name.to_string(), jwc_ordered_record(nested)));
                            continue;
                        }
                        if let J::Array(items) = value {
                            // §11.4 — element failures accumulate with
                            // indexed paths into the same list.
                            let mut rows = Vec::new();
                            for (i, item) in items.iter().enumerate() {
                                let mut nested = Vec::new();
                                jwc_validate_class(
                                    inner,
                                    item,
                                    &format!("{}[{}]", path, i),
                                    &mut nested,
                                    failures,
                                );
                                rows.push(jwc_ordered_record(nested));
                            }
                            out.push((f.name.to_string(), v_arr(rows)));
                            continue;
                        }
                    }
                }
                out.push((f.name.to_string(), v));
            }
            None => failures.push(jwc_field_error(
                &path,
                "type",
                None,
                &format!("{} tipi mos emas", f.name),
            )),
        }
    }
}

fn jwc_coerce(f: &JwcClassField, v: &serde_json::Value) -> Option<V> {
    use serde_json::Value as J;
    match (f.ty, v) {
        (_, J::Null) => Some(V::Null),
        (JwcTy::Boolean, J::Bool(b)) => Some(V::Bool(*b)),
        // types.md §2.3 — a bigint arrives as a JSON string *or* a number.
        //
        // The interpreter's `Value::Bigint` is numeric in arithmetic and a
        // string on the JSON wire; `V` has no variant that is both, so this
        // keeps it numeric. A validated `bigint` field echoed straight back
        // into a response therefore serialises as a number here and as a
        // string under `jwc serve`.
        (JwcTy::Bigint, J::String(s)) => s.parse::<i64>().ok().map(V::Int),
        (JwcTy::Bigint, J::Number(n)) => n.as_i64().map(V::Int),
        (JwcTy::Int, J::Number(n)) => n.as_i64().map(V::Int),
        (JwcTy::Numeric, J::String(s)) => s.parse::<f64>().ok().map(|_| v_str(s.clone())),
        (JwcTy::Numeric, J::Number(n)) => Some(v_str(n.to_string())),
        (JwcTy::Jsonb, other) => Some(V::RawJson(Cow::Owned(other.to_string()))),
        (JwcTy::Text, J::String(s)) => Some(v_str(s.clone())),
        (JwcTy::Class, J::Object(_)) => Some(V::Null),
        (_, J::Array(items)) => {
            let mut out = Vec::new();
            for i in items {
                out.push(jwc_coerce(f, i)?);
            }
            Some(v_arr(out))
        }
        _ => None,
    }
}

fn jwc_check_rules(
    f: &JwcClassField,
    path: &str,
    raw: &serde_json::Value,
    value: &V,
    failures: &mut Vec<String>,
) {
    for r in f.rules {
        let ok = match r.name {
            "required" => true,
            "minLength" => jwc_text_len(value)
                .is_none_or(|n| r.limit.is_none_or(|l| n >= l)),
            "maxLength" => jwc_text_len(value)
                .is_none_or(|n| r.limit.is_none_or(|l| n <= l)),
            "minItems" => jwc_array_len(raw)
                .is_none_or(|n| r.limit.is_none_or(|l| n >= l)),
            "maxItems" => jwc_array_len(raw)
                .is_none_or(|n| r.limit.is_none_or(|l| n <= l)),
            "min" => jwc_numeric_value(value)
                .is_none_or(|n| r.bound.is_none_or(|l| n >= l)),
            "max" => jwc_numeric_value(value)
                .is_none_or(|n| r.bound.is_none_or(|l| n <= l)),
            "pattern" => match (r.pattern, jwc_str_view(value)) {
                ("", _) | (_, None) => true,
                (p, Some(s)) => jwc_regex_is_match(p, s),
            },
            "transient" => true,
            _ => true,
        };
        if !ok {
            failures.push(jwc_field_error(
                path,
                r.name,
                r.limit,
                &jwc_default_message(f.name, r.name, r.limit),
            ));
        }
    }
}

fn jwc_default_message(field: &str, rule: &str, limit: Option<i64>) -> String {
    match (rule, limit) {
        ("minLength", Some(n)) => format!("{} kamida {} belgidan iborat bo'lishi kerak", field, n),
        ("maxLength", Some(n)) => format!("{} ko'pi bilan {} belgi bo'lishi kerak", field, n),
        ("minItems", Some(n)) => format!("{} kamida {} ta element bo'lishi kerak", field, n),
        ("maxItems", Some(n)) => format!("{} ko'pi bilan {} ta element bo'lishi kerak", field, n),
        ("min", Some(n)) => format!("{} kamida {} bo'lishi kerak", field, n),
        ("max", Some(n)) => format!("{} ko'pi bilan {} bo'lishi kerak", field, n),
        ("pattern", _) => format!("{} shakli mos emas", field),
        ("required", _) => format!("{} kerak", field),
        _ => format!("{} yaroqsiz", field),
    }
}

fn jwc_numeric_value(v: &V) -> Option<f64> {
    match v {
        V::Int(n) => Some(*n as f64),
        V::Float(n) => Some(*n),
        V::Str(s) => s.parse().ok(),
        _ => None,
    }
}

fn jwc_text_len(v: &V) -> Option<i64> {
    jwc_str_view(v).map(|s| s.chars().count() as i64)
}

fn jwc_array_len(v: &serde_json::Value) -> Option<i64> {
    match v {
        serde_json::Value::Array(items) => Some(items.len() as i64),
        _ => None,
    }
}

// `jwc_regex_is_match` is a codegen shim: the real one when the program has
// a `pattern(r"…")` rule to enforce, an always-true one when it does not, so
// a crate with no pattern anywhere does not compile the regex engine.

// `string.matches(s, pattern)`. Codegen emits the body when the program has a
// regex to run and a `false` stub when it does not — the same shim treatment
// `jwc_regex_is_match` gets, and for the same reason: a crate with no regex
// anywhere should not compile the engine.
