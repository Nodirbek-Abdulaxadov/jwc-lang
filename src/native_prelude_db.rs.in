// --- Postgres runtime (async) -----------------------------------------------
//
// Only included when the program declares at least one dbcontext / entity.
// Pulls `tokio-postgres` + `deadpool-postgres` deps in the generated Cargo.toml.
//
// Notes:
//   * One global `deadpool_postgres::Pool`; per-call `pool.get().await` checks
//     out a client; `prepare_cached` reuses statements per-client.
//   * Column readers cover BOOL, INT2/4/8, FLOAT4/8, TEXT/VARCHAR/BPCHAR/NAME.
//     UUID, TIMESTAMP, JSONB surface as `V::Null` — switch to TEXT or wait for
//     the uuid/chrono follow-up.

use std::sync::OnceLock;

static DB_POOL: OnceLock<deadpool_postgres::Pool> = OnceLock::new();

fn jwc_db_connection_string() -> String {
    if let Ok(u) = std::env::var("DATABASE_URL") { return u; }
    if let Ok(u) = std::env::var("JWC_DATABASE_URL") { return u; }
    let host = std::env::var("PG_HOST").unwrap_or_else(|_| "localhost".into());
    let port = std::env::var("PG_PORT").unwrap_or_else(|_| "5432".into());
    let user = std::env::var("PG_USER").unwrap_or_else(|_| "postgres".into());
    let pwd = std::env::var("PG_PASSWORD").unwrap_or_default();
    let db = std::env::var("PG_DATABASE").unwrap_or_else(|_| "postgres".into());
    format!("host={} port={} user={} password={} dbname={}", host, port, user, pwd, db)
}

async fn jwc_db_init() {
    if DB_POOL.get().is_some() { return; }
    let url = jwc_db_connection_string();
    let pg_cfg: tokio_postgres::Config = url
        .parse()
        .unwrap_or_else(|e| panic!("setConnectionString: invalid Postgres URL: {}", e));
    let mgr_cfg = deadpool_postgres::ManagerConfig {
        recycling_method: deadpool_postgres::RecyclingMethod::Fast,
    };
    let mgr = deadpool_postgres::Manager::from_config(pg_cfg, tokio_postgres::NoTls, mgr_cfg);
    // Default 64 matches the bundled interpreter's pool tuning; override via
    // `JWC_DB_POOL_SIZE` for memory-constrained deployments.
    let max_size: usize = std::env::var("JWC_DB_POOL_SIZE")
        .ok()
        .and_then(|s| s.parse().ok())
        .unwrap_or(64);
    let pool = deadpool_postgres::Pool::builder(mgr)
        .max_size(max_size)
        .build()
        .unwrap_or_else(|e| panic!("setConnectionString: pool build failed: {}", e));
    let _ = DB_POOL.set(pool);
}

async fn jwc_b_setConnectionString() -> V {
    jwc_db_init().await;
    V::Null
}

async fn jwc_db_get() -> deadpool_postgres::Object {
    let pool = DB_POOL
        .get()
        .expect("DB used before setConnectionString() — call setConnectionString() in main()");
    pool.get()
        .await
        .unwrap_or_else(|e| panic!("failed to check out a DB connection: {}", e))
}

type DbParams = Vec<Box<dyn tokio_postgres::types::ToSql + Sync + Send>>;

async fn jwc_db_query(sql: &str, params: DbParams) -> Vec<V> {
    let rows = jwc_db_query_rows(sql, params).await;
    rows.iter().map(jwc_row_to_v).collect()
}

/// Run a query whose single column is a `::text`-cast JSON document and parse
/// it into a `V`. Mirrors the interpreter's eager-load / complex-select path:
/// the SQL wraps the inner select in `row_to_json(r)::text` (a `first` query
/// yields 0 or 1 rows) or `json_agg(...)::text` (a list query always yields one
/// row holding the array). No row → `V::Null`; unparseable text → `V::Null`.
#[allow(dead_code)]
async fn jwc_db_query_json(sql: &str, params: DbParams) -> V {
    let rows = jwc_db_query_rows(sql, params).await;
    match rows.first() {
        Some(row) => row
            .try_get::<_, Option<String>>(0)
            .ok()
            .flatten()
            .map(|t| jwc_from_json(&t).unwrap_or(V::Null))
            .unwrap_or(V::Null),
        None => V::Null,
    }
}

/// Raw-row variant of `jwc_db_query`. Used by the monomorphized struct
/// path (Phase 1) so generated code can map each row straight into a
/// concrete `JwcEnt_<Name>` (via the struct's `jwc_from_row` ctor)
/// without going through the dynamic `V::Object` detour. The dynamic
/// `jwc_db_query` stays as a one-line wrapper for callers that still
/// want the FxHashMap shape; per-entity callsites switch over a slice
/// at a time.
#[allow(dead_code)]
async fn jwc_db_query_rows(sql: &str, params: DbParams) -> Vec<tokio_postgres::Row> {
    let refs: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> =
        params.iter().map(|b| b.as_ref() as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    let client = jwc_db_get().await;
    let stmt = client
        .prepare_cached(sql)
        .await
        .unwrap_or_else(|e| panic!("prepare failed: {}\nSQL: {}", e, sql));
    client
        .query(&stmt, &refs)
        .await
        .unwrap_or_else(|e| panic!("query failed: {}\nSQL: {}", e, sql))
}

async fn jwc_db_exec(sql: &str, params: DbParams) -> u64 {
    let refs: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> =
        params.iter().map(|b| b.as_ref() as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    let client = jwc_db_get().await;
    let stmt = client
        .prepare_cached(sql)
        .await
        .unwrap_or_else(|e| panic!("prepare failed: {}\nSQL: {}", e, sql));
    client
        .execute(&stmt, &refs)
        .await
        .unwrap_or_else(|e| panic!("execute failed: {}\nSQL: {}", e, sql))
}

fn jwc_row_to_v(row: &tokio_postgres::Row) -> V {
    use tokio_postgres::types::Type;
    let mut m: JwcObj = JwcObj::default();
    for (i, col) in row.columns().iter().enumerate() {
        let name = col.name().to_string();
        let ty = col.type_();
        let v: V = match *ty {
            Type::BOOL => row
                .try_get::<_, Option<bool>>(i)
                .ok()
                .flatten()
                .map(V::Bool)
                .unwrap_or(V::Null),
            Type::INT2 => row
                .try_get::<_, Option<i16>>(i)
                .ok()
                .flatten()
                .map(|n| V::Int(n as i64))
                .unwrap_or(V::Null),
            Type::INT4 => row
                .try_get::<_, Option<i32>>(i)
                .ok()
                .flatten()
                .map(|n| V::Int(n as i64))
                .unwrap_or(V::Null),
            Type::INT8 => row
                .try_get::<_, Option<i64>>(i)
                .ok()
                .flatten()
                .map(V::Int)
                .unwrap_or(V::Null),
            Type::FLOAT4 => row
                .try_get::<_, Option<f32>>(i)
                .ok()
                .flatten()
                .map(|n| V::Float(n as f64))
                .unwrap_or(V::Null),
            Type::FLOAT8 => row
                .try_get::<_, Option<f64>>(i)
                .ok()
                .flatten()
                .map(V::Float)
                .unwrap_or(V::Null),
            Type::TEXT | Type::VARCHAR | Type::BPCHAR | Type::NAME => row
                .try_get::<_, Option<String>>(i)
                .ok()
                .flatten()
                .map(v_str)
                .unwrap_or(V::Null),
            // Temporal columns: surface as RFC 3339 / ISO-8601 strings so
            // user code can pass the value to `now()` comparisons or hand
            // it back through `json(...)` without losing precision. The
            // ToSql side (jwc_param_timestamp) parses these formats back
            // when the value travels in the other direction.
            Type::TIMESTAMPTZ => row
                .try_get::<_, Option<chrono::DateTime<chrono::Utc>>>(i)
                .ok()
                .flatten()
                .map(|dt| v_str(dt.to_rfc3339_opts(chrono::SecondsFormat::Secs, true)))
                .unwrap_or(V::Null),
            Type::TIMESTAMP => row
                .try_get::<_, Option<chrono::NaiveDateTime>>(i)
                .ok()
                .flatten()
                .map(|dt| v_str(dt.format("%Y-%m-%dT%H:%M:%S").to_string()))
                .unwrap_or(V::Null),
            Type::DATE => row
                .try_get::<_, Option<chrono::NaiveDate>>(i)
                .ok()
                .flatten()
                .map(|d| v_str(d.format("%Y-%m-%d").to_string()))
                .unwrap_or(V::Null),
            _ => V::Null,
        };
        m.insert(name, v);
    }
    v_obj(m)
}

// --- typed-param helpers used by codegen --------------------------------------
//
// tokio-postgres' `ToSql` impls are width-specific: `i16` only binds to
// `INT2`, `i32` only to `INT2 / INT4`, `i64` only to `INT8`. Binding the
// wrong width raises `WrongType { postgres: Int4, rust: "i64" }` at execute
// time. The codegen picks the helper that matches the declared column type
// (see `PgKind` in `native_build.rs`); this file only has to box correctly.

fn jwc_param_smallint(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i16>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0) as i16),
    }
}

fn jwc_param_int(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i32>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0) as i32),
    }
}

fn jwc_param_bigint(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<i64>),
        other => Box::new(jwc_to_int(&other).unwrap_or(0)),
    }
}

fn jwc_param_float(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<f64>),
        V::Int(n) => Box::new(n as f64),
        V::Float(n) => Box::new(n),
        V::Str(s) => Box::new(s.parse::<f64>().unwrap_or(0.0)),
        _ => Box::new(0.0_f64),
    }
}

fn jwc_param_str(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<String>),
        // `Cow<'static, str>` doesn't impl `ToSql`; materialize a `String`
        // (free when the Cow was already Owned; one alloc when Borrowed).
        V::Str(s) => Box::new(s.into_owned()),
        other => Box::new(other.to_string()),
    }
}

/// Bind a JWC value into a Postgres temporal column (`timestamptz` /
/// `timestamp` / `date`). JWC carries datetimes as RFC 3339 strings, but
/// tokio-postgres' `String` ToSql impl only accepts text-like Postgres
/// types — sending one to `timestamptz` raises
/// `WrongType { postgres: Timestamptz, rust: "alloc::string::String" }`.
/// We parse the RFC 3339 / ISO 8601 / date-only string into a real
/// `chrono::DateTime<Utc>` so the with-chrono-0_4 ToSql impl binds it
/// against `TIMESTAMPTZ` natively. Empty / unparseable input falls back
/// to a NULL bind rather than panicking mid-INSERT.
fn jwc_param_timestamp(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    fn parse(s: &str) -> Option<chrono::DateTime<chrono::Utc>> {
        if let Ok(dt) = chrono::DateTime::parse_from_rfc3339(s) {
            return Some(dt.with_timezone(&chrono::Utc));
        }
        if let Ok(d) = chrono::NaiveDate::parse_from_str(s, "%Y-%m-%d") {
            let dt = d.and_hms_opt(0, 0, 0)?;
            return Some(chrono::DateTime::<chrono::Utc>::from_naive_utc_and_offset(
                dt,
                chrono::Utc,
            ));
        }
        None
    }
    match v {
        V::Null => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        V::Str(s) => match parse(&s) {
            Some(dt) => Box::new(dt),
            None => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        },
        other => match parse(&other.to_string()) {
            Some(dt) => Box::new(dt),
            None => Box::new(None::<chrono::DateTime<chrono::Utc>>),
        },
    }
}

fn jwc_param_bool(v: V) -> Box<dyn tokio_postgres::types::ToSql + Sync + Send> {
    match v {
        V::Null => Box::new(None::<bool>),
        V::Bool(b) => Box::new(b),
        other => Box::new(jwc_truthy(&other)),
    }
}

// --- raw_sql -----------------------------------------------------------------
//
// Escape hatch for SQL the typed query builder doesn't cover (json_agg,
// window functions, ad-hoc analytics). Mirrors the interpreter:
//   * SELECT / WITH → return the first column of the first row as text
//     (or V::Null if no rows). Useful for `SELECT COUNT(*)`, `SELECT json_agg(...)::text`.
//   * Anything else → run as `execute` and return the affected rowcount as int.
//
// `params_json` is a JSON-encoded array of values bound positionally as $1, $2,
// .... It's variadic in JWC source (1 or 2 args); the codegen pads the missing
// param to `V::Str("[]")`.

async fn jwc_b_raw_sql(sql: V, params_json: V) -> V {
    let sql_s: String = match sql {
        V::Str(s) => s.into_owned(),
        _ => return V::Null,
    };

    let raw: String = match params_json {
        V::Str(s) => s.into_owned(),
        V::Null => "[]".to_string(),
        _ => "[]".to_string(),
    };
    let params: Vec<V> = match jwc_from_json(&raw) {
        Ok(V::Array(a)) => Arc::unwrap_or_clone(a),
        _ => Vec::new(),
    };
    // raw_sql doesn't know the prepared statement's parameter types up
    // front, so pick the narrowest integer width the value still fits in.
    // Mirrors `runner::value_to_sql_param` so the AOT and interpreter paths
    // agree on which `INT2`/`INT4`/`INT8` column a JWC int will bind to.
    let boxed: DbParams = params
        .into_iter()
        .map(|p| match p {
            V::Int(n) => {
                if (i32::MIN as i64..=i32::MAX as i64).contains(&n) {
                    Box::new(n as i32) as Box<dyn tokio_postgres::types::ToSql + Sync + Send>
                } else {
                    Box::new(n)
                }
            }
            V::Float(_) => jwc_param_float(p),
            V::Bool(_) => jwc_param_bool(p),
            _ => jwc_param_str(p),
        })
        .collect();

    let lowered = sql_s.trim_start().to_ascii_lowercase();
    if lowered.starts_with("select") || lowered.starts_with("with") {
        let rows = jwc_db_query(&sql_s, boxed).await;
        let Some(first) = rows.into_iter().next() else {
            return V::Null;
        };
        let V::Object(m) = first else {
            return V::Null;
        };
        // First-column-as-text: V::Object now stores rows in an FxHashMap
        // (no insertion order), so explicitly pick the alphabetically-first
        // column to preserve the previous BTreeMap-driven behavior.
        // Callers that care about ordering should `SELECT col AS a` to force
        // alphabetic ordering, or use a single-column projection.
        let mut owned = Arc::unwrap_or_clone(m);
        let Some(first_key) = owned.keys().min().cloned() else {
            return V::Null;
        };
        let Some(v) = owned.remove(&first_key) else {
            return V::Null;
        };
        match v {
            V::Str(s) => V::Str(s),
            V::Int(n) => v_str(n.to_string()),
            V::Float(n) => v_str(n.to_string()),
            V::Bool(b) => v_str(b.to_string()),
            V::Null => V::Null,
            other => v_str(jwc_to_json(&other)),
        }
    } else {
        let affected = jwc_db_exec(&sql_s, boxed).await;
        V::Int(affected as i64)
    }
}
