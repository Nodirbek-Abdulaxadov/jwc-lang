// --- crypto built-ins (gated by needs_crypto) --------------------------------
// Concatenated into the generated standalone binary, so this operates on the
// emitted `V` enum (not `crate::`). Imports are aliased to avoid any clash with
// names already brought in by the always-on prelude; aliased trait imports
// still bring `.update()` / `.finalize()` into scope.
use hmac::{Hmac as JwcHmac, Mac as JwcMac};
use sha2::{Digest as JwcDigest, Sha256 as JwcSha256};
use sha1::Sha1 as JwcSha1;
use md5::Md5 as JwcMd5;
use argon2::password_hash::{
    rand_core::OsRng as JwcOsRng, PasswordHasher as JwcPwHasher,
    PasswordVerifier as JwcPwVerifier, SaltString as JwcSaltString,
};
use argon2::{Argon2 as JwcArgon2, PasswordHash as JwcPasswordHash};

fn jwc_hash_to_hex(bytes: &[u8]) -> String {
    // Direct byte → hex without going through `format!("{:02x}", b)` per
    // byte. The old version did one tiny `String` allocation per byte
    // (32 per SHA-256, 20 per SHA-1, 16 per MD5) — hot enough on chained
    // hashing benchmarks to dominate request time. This version is one
    // pre-sized String plus two table lookups per input byte.
    const HEX: &[u8; 16] = b"0123456789abcdef";
    let mut out = Vec::with_capacity(bytes.len() * 2);
    for &b in bytes {
        out.push(HEX[(b >> 4) as usize]);
        out.push(HEX[(b & 0x0f) as usize]);
    }
    // SAFETY: every byte we pushed is from `HEX`, which is pure ASCII,
    // so `out` is guaranteed to be valid UTF-8.
    unsafe { String::from_utf8_unchecked(out) }
}

fn jwc_b_sha256(v: V) -> V {
    match v {
        V::Str(s) => {
            let mut h = JwcSha256::new();
            h.update(s.as_bytes());
            v_str(jwc_hash_to_hex(&h.finalize()))
        }
        other => panic!("sha256() expects a string, got {:?}", other),
    }
}

fn jwc_b_sha1(v: V) -> V {
    match v {
        V::Str(s) => {
            let mut h = JwcSha1::new();
            h.update(s.as_bytes());
            v_str(jwc_hash_to_hex(&h.finalize()))
        }
        other => panic!("sha1() expects a string, got {:?}", other),
    }
}

fn jwc_b_md5(v: V) -> V {
    match v {
        V::Str(s) => {
            let mut h = JwcMd5::new();
            h.update(s.as_bytes());
            v_str(jwc_hash_to_hex(&h.finalize()))
        }
        other => panic!("md5() expects a string, got {:?}", other),
    }
}

fn jwc_b_hmac_sha256(key: V, msg: V) -> V {
    match (key, msg) {
        (V::Str(k), V::Str(m)) => {
            type H = JwcHmac<JwcSha256>;
            let mut mac = H::new_from_slice(k.as_bytes()).expect("HMAC accepts any key length");
            mac.update(m.as_bytes());
            v_str(jwc_hash_to_hex(&mac.finalize().into_bytes()))
        }
        (a, b) => panic!("hmac_sha256() expects two strings, got {:?} / {:?}", a, b),
    }
}

fn jwc_b_hash_password(v: V) -> V {
    match v {
        V::Str(pwd) => {
            let salt = JwcSaltString::generate(&mut JwcOsRng);
            match JwcArgon2::default().hash_password(pwd.as_bytes(), &salt) {
                Ok(h) => v_str(h.to_string()),
                Err(e) => panic!("hash_password failed: {}", e),
            }
        }
        other => panic!("hash_password() expects a string, got {:?}", other),
    }
}

fn jwc_b_verify_password(pwd: V, stored: V) -> V {
    match (pwd, stored) {
        (V::Str(p), V::Str(h)) => match JwcPasswordHash::new(h.as_ref()) {
            Ok(parsed) => V::Bool(JwcArgon2::default().verify_password(p.as_bytes(), &parsed).is_ok()),
            Err(e) => panic!("verify_password: malformed stored hash: {}", e),
        },
        (a, b) => panic!("verify_password() expects two strings, got {:?} / {:?}", a, b),
    }
}

// --- JWT (HS256) -------------------------------------------------------------
//
// Native used to reject `jwt_sign` / `jwt_verify` outright, so any project
// using Bearer auth could not be built with `--native` at all — which covers
// most real backends and undercut the "one static binary" promise. This is a
// port of `crate::jwt`, kept behaviourally identical: same header, same
// `Bearer ` tolerance, same `exp` enforcement, same HS256-only restriction.

fn jwc_jwt_b64_encode(bytes: &[u8]) -> String {
    use base64::engine::general_purpose::URL_SAFE_NO_PAD as JwcB64;
    use base64::Engine as _;
    JwcB64.encode(bytes)
}

fn jwc_jwt_b64_decode(s: &str) -> Result<Vec<u8>, String> {
    use base64::engine::general_purpose::URL_SAFE_NO_PAD as JwcB64;
    use base64::Engine as _;
    JwcB64.decode(s).map_err(|_| "invalid base64".to_string())
}

fn jwc_jwt_sign_hs256(payload_json: &str, secret: &str) -> Result<String, String> {
    // Validate the payload is JSON so the resulting token is decodable.
    serde_json::from_str::<serde_json::Value>(payload_json)
        .map_err(|_| "jwt_sign: payload must be valid JSON".to_string())?;

    let header_b64 = jwc_jwt_b64_encode(br#"{"alg":"HS256","typ":"JWT"}"#);
    let payload_b64 = jwc_jwt_b64_encode(payload_json.as_bytes());
    let signing_input = format!("{}.{}", header_b64, payload_b64);

    let mut mac = <JwcHmac<JwcSha256> as JwcMac>::new_from_slice(secret.as_bytes())
        .map_err(|e| format!("jwt_sign: invalid secret: {}", e))?;
    mac.update(signing_input.as_bytes());
    let signature = mac.finalize().into_bytes();
    Ok(format!(
        "{}.{}",
        signing_input,
        jwc_jwt_b64_encode(&signature)
    ))
}

/// Strip an optional, case-insensitive `Bearer ` prefix so an `Authorization`
/// header value can be passed straight through.
///
/// `get(..7)` rather than `[..7]`: the header is attacker-controlled and a
/// multibyte value would panic on a byte-index slice — which in a native
/// build means `catch_unwind` turning an unauthenticated request into a
/// 500. Mirrors `crate::jwt::strip_bearer_prefix`.
fn jwc_jwt_strip_bearer(value: &str) -> &str {
    let trimmed = value.trim();
    match trimmed.get(..7) {
        Some(prefix) if prefix.eq_ignore_ascii_case("bearer ") => trimmed[7..].trim_start(),
        _ => trimmed,
    }
}

/// Opt-in claim policy, mirroring `crate::jwt::VerifyOptions`. Read from
/// the environment once and cached — `jwt_verify` is on the hot path of
/// every authenticated request.
struct JwcJwtVerifyOptions {
    leeway_secs: i64,
    expected_iss: Option<String>,
    expected_aud: Option<String>,
}

fn jwc_jwt_verify_options() -> &'static JwcJwtVerifyOptions {
    static OPTS: std::sync::OnceLock<JwcJwtVerifyOptions> = std::sync::OnceLock::new();
    OPTS.get_or_init(|| {
        fn non_empty(name: &str) -> Option<String> {
            std::env::var(name)
                .ok()
                .map(|v| v.trim().to_string())
                .filter(|v| !v.is_empty())
        }
        JwcJwtVerifyOptions {
            leeway_secs: non_empty("JWC_JWT_LEEWAY_SECS")
                .and_then(|v| v.parse::<i64>().ok())
                .filter(|n| *n >= 0)
                .unwrap_or(0),
            expected_iss: non_empty("JWC_JWT_EXPECTED_ISS"),
            expected_aud: non_empty("JWC_JWT_EXPECTED_AUD"),
        }
    })
}

/// Read a numeric claim, accepting integer and float encodings.
/// `Ok(None)` means absent. Mirrors `crate::jwt::numeric_claim`.
fn jwc_jwt_numeric_claim(
    payload: &serde_json::Value,
    name: &str,
) -> Result<Option<i64>, String> {
    match payload.get(name) {
        None | Some(serde_json::Value::Null) => Ok(None),
        Some(value) => value
            .as_i64()
            .or_else(|| value.as_f64().map(|f| f as i64))
            .map(Some)
            .ok_or_else(|| format!("jwt_verify: '{}' claim must be a number", name)),
    }
}

/// `aud` is either a string or an array of strings (RFC 7519 §4.1.3).
fn jwc_jwt_audience_matches(aud: &serde_json::Value, expected: &str) -> bool {
    match aud {
        serde_json::Value::String(s) => s == expected,
        serde_json::Value::Array(items) => items
            .iter()
            .any(|item| item.as_str().map(|s| s == expected).unwrap_or(false)),
        _ => false,
    }
}

fn jwc_jwt_verify_hs256(token: &str, secret: &str) -> Result<String, String> {
    let token = jwc_jwt_strip_bearer(token);
    let parts: Vec<&str> = token.split('.').collect();
    if parts.len() != 3 {
        return Err("jwt_verify: token must have 3 segments".to_string());
    }

    let header_bytes = jwc_jwt_b64_decode(parts[0])
        .map_err(|_| "jwt_verify: invalid base64 in header".to_string())?;
    let header: serde_json::Value = serde_json::from_slice(&header_bytes)
        .map_err(|_| "jwt_verify: header is not JSON".to_string())?;
    let alg = header.get("alg").and_then(|v| v.as_str()).unwrap_or("none");
    if alg != "HS256" {
        return Err(format!("jwt_verify: only HS256 is supported, got '{}'", alg));
    }

    let signing_input = format!("{}.{}", parts[0], parts[1]);
    let signature = jwc_jwt_b64_decode(parts[2])
        .map_err(|_| "jwt_verify: invalid base64 in signature".to_string())?;
    let mut mac = <JwcHmac<JwcSha256> as JwcMac>::new_from_slice(secret.as_bytes())
        .map_err(|e| format!("jwt_verify: invalid secret: {}", e))?;
    mac.update(signing_input.as_bytes());
    mac.verify_slice(&signature)
        .map_err(|_| "jwt_verify: signature mismatch".to_string())?;

    let payload_bytes = jwc_jwt_b64_decode(parts[1])
        .map_err(|_| "jwt_verify: invalid base64 in payload".to_string())?;
    let payload_str = String::from_utf8(payload_bytes)
        .map_err(|_| "jwt_verify: payload is not valid UTF-8".to_string())?;
    let parsed: serde_json::Value = serde_json::from_str(&payload_str)
        .map_err(|_| "jwt_verify: payload is not valid JSON".to_string())?;

    let opts = jwc_jwt_verify_options();
    let leeway = opts.leeway_secs.max(0);
    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_secs() as i64)
        .unwrap_or(0);

    // `exp` is enforced when present; absent `exp` stays valid so
    // non-expiring machine-to-machine tokens keep working.
    if let Some(exp_secs) = jwc_jwt_numeric_claim(&parsed, "exp")? {
        if exp_secs.saturating_add(leeway) <= now {
            return Err(format!(
                "jwt_verify: token expired (exp={}, now={})",
                exp_secs, now
            ));
        }
    }

    // `nbf` — a token minted for a future activation window must not be
    // accepted before it opens.
    if let Some(nbf_secs) = jwc_jwt_numeric_claim(&parsed, "nbf")? {
        if nbf_secs.saturating_sub(leeway) > now {
            return Err(format!(
                "jwt_verify: token not yet valid (nbf={}, now={})",
                nbf_secs, now
            ));
        }
    }

    // `iat` is validated but deliberately not enforced — see the
    // interpreter side for the reasoning.
    let _ = jwc_jwt_numeric_claim(&parsed, "iat")?;

    if let Some(expected) = opts.expected_iss.as_deref() {
        match parsed.get("iss").and_then(|v| v.as_str()) {
            Some(iss) if iss == expected => {}
            Some(iss) => {
                return Err(format!(
                    "jwt_verify: issuer mismatch (expected '{}', got '{}')",
                    expected, iss
                ))
            }
            None => {
                return Err(format!(
                    "jwt_verify: missing 'iss' claim (expected '{}')",
                    expected
                ))
            }
        }
    }

    if let Some(expected) = opts.expected_aud.as_deref() {
        match parsed.get("aud") {
            Some(aud) if jwc_jwt_audience_matches(aud, expected) => {}
            Some(_) => {
                return Err(format!(
                    "jwt_verify: audience mismatch (expected '{}')",
                    expected
                ))
            }
            None => {
                return Err(format!(
                    "jwt_verify: missing 'aud' claim (expected '{}')",
                    expected
                ))
            }
        }
    }

    Ok(parsed.to_string())
}

fn jwc_b_jwt_sign(payload: V, secret: V) -> V {
    let payload_json = jwc_to_json(&payload);
    let secret = match secret {
        V::Str(s) => s.to_string(),
        other => panic!("jwt_sign(payload, secret): secret must be a string, got {:?}", other),
    };
    match jwc_jwt_sign_hs256(&payload_json, &secret) {
        Ok(token) => v_str(token),
        Err(e) => panic!("{}", e),
    }
}

fn jwc_b_jwt_verify(token: V, secret: V) -> V {
    let token = match token {
        V::Str(s) => s.to_string(),
        other => panic!("jwt_verify(token, secret): token must be a string, got {:?}", other),
    };
    let secret = match secret {
        V::Str(s) => s.to_string(),
        other => panic!("jwt_verify(token, secret): secret must be a string, got {:?}", other),
    };
    match jwc_jwt_verify_hs256(&token, &secret) {
        Ok(payload) => v_str(payload),
        Err(e) => panic!("{}", e),
    }
}
