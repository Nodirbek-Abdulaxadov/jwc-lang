# Queue driver — defaults to in-memory. Set to `postgres` for a durable
# queue (requires DATABASE_URL / PG_*).
# JWC_QUEUE_DRIVER=postgres

# Postgres connection (only needed for the durable queue):
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=secret
# PG_DATABASE={{name}}

# PORT=8080
