// {{name}} — background-job scaffold generated by `jwc new --template jobs`.
// `POST /send-email` enqueues a job and returns 202-shaped JSON without
// blocking on the actual send. The handler runs in the queue worker.

route POST "/send-email" {
    let payload = body();
    enqueue("process_email", json_stringify(payload));
    return json({ queued: true });
}

route GET "/health" {
    return json({ ok: true });
}

function main() {
    // Wire job handlers BEFORE serving so an early enqueue can still be
    // dispatched by the worker.
    register_job_handler("process_email", process_email);

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
