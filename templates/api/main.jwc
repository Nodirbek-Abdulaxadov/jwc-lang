// {{name}} — REST API scaffold generated by `jwc new --template api`.
// CRUD for a single `Item` entity. Extend by adding more entities under
// `src/` and more routes in this file (or a new `src/Controller.jwc`).

route GET "/items" {
    let items = select Item from AppDb.Item;
    return json(items);
}

route GET "/items/{id}" {
    let id = path_param("id");
    let item = select Item from AppDb.Item where Item.id == @id first;
    if (item == null) {
        return notFound();
    }
    return json(item);
}

route POST "/items" {
    validate body {
        name: required, minLength(1), maxLength(255);
    }
    let req = body();
    let it = new Item();
    it.name = req.name;
    it.createdAt = now();
    insert it into AppDb.Item;
    return created(it);
}

route PUT "/items/{id}" {
    validate body {
        name: required, minLength(1), maxLength(255);
    }
    let id = path_param("id");
    let req = body();
    let existing = select Item from AppDb.Item where Item.id == @id first;
    if (existing == null) {
        return notFound();
    }
    existing.name = req.name;
    update existing in AppDb.Item;
    return json(existing);
}

route DELETE "/items/{id}" {
    let id = path_param("id");
    let existing = select Item from AppDb.Item where Item.id == @id first;
    if (existing == null) {
        return notFound();
    }
    delete existing from AppDb.Item;
    return noContent();
}

function main() {
    // Auto-builds DATABASE_URL from PG_* env vars (loaded from `.env`).
    setConnectionString();

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
