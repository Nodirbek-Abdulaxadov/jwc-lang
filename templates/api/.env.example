# Either set DATABASE_URL directly:
# DATABASE_URL=postgres://postgres:secret@localhost:5432/{{name}}

# ...or let JWC assemble it from these PG_* fields on startup:
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=secret
PG_DATABASE={{name}}

# Override the listen port (defaults to 8080).
# PORT=8080
