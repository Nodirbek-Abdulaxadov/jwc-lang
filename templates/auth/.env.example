# Postgres (DATABASE_URL or PG_* fields):
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=secret
PG_DATABASE={{name}}

# REQUIRED — used by jwt_sign / jwt_verify. Generate a strong random
# value for production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-production

# PORT=8080
