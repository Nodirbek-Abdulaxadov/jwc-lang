// {{name}} — JWT-auth scaffold generated by `jwc new --template auth`.
// `POST /register` and `POST /login` issue a JWT; `GET /me` is gated by
// the `Auth` middleware defined in `src/AuthMiddleware.jwc`.

route POST "/register" {
    validate body {
        email:    required, pattern(r"^[^@]+@[^@]+\.[^@]+$");
        password: required, minLength(8), maxLength(200);
    }
    let req = body();
    let u = new User();
    u.email = req.email;
    u.passwordHash = hash_password(req.password);
    u.createdAt = now();
    insert u into AppDb.User;
    return created(json({ id: u.id }));
}

route POST "/login" {
    validate body {
        email:    required;
        password: required;
    }
    let req = body();
    let u = select User from AppDb.User where User.email == @req.email first;
    if (u == null) {
        return unauthorized();
    }
    let ok = verify_password(req.password, u.passwordHash);
    if (!ok) {
        return unauthorized();
    }
    let token = jwt_sign({ sub: u.id }, env("JWT_SECRET"));
    return json({ token: token });
}

route GET "/me" use Auth {
    let id = context("userId");
    let u = select User { id, email, createdAt }
        from AppDb.User where User.id == @id first;
    if (u == null) {
        return notFound();
    }
    return json(u);
}

function main() {
    setConnectionString();

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
