// Verifies `Authorization: Bearer <jwt>` (or a raw token) on every gated
// request. Stashes the JWT subject as `context("userId")` so handlers can
// read it without re-parsing the token.
middleware Auth {
    let token = header("authorization");
    if (token == null) {
        return unauthorized();
    }
    try {
        let claims = jwt_verify(token, env("JWT_SECRET"));
        setContext("userId", claims.sub);
    } catch (e) {
        return unauthorized();
    }
}
