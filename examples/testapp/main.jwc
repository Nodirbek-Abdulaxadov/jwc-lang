route GET "/ping" {
    return json({ hello: "world" });
}

function main() {
    // No-arg form: pulls DATABASE_URL (or PG_HOST/PORT/USER/PASSWORD/DATABASE)
    // from the env. `.env` is auto-loaded before main() runs.
    setConnectionString();

    // Structured form (use when you want fields explicit in source):
    //   setConnectionString({
    //       host:     "localhost",
    //       port:     5432,
    //       user:     "postgres",
    //       password: env("PG_PASSWORD"),
    //       database: "myapp"
    //   });
    //
    // Raw URL form:
    //   setConnectionString("postgresql://postgres:secret@localhost:5432/myapp");

    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
