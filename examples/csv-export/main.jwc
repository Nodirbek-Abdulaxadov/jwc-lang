// csv-export — demonstrates v0.4.0 array literals, range/push/join, and the
// custom-MIME response() builtin. Works under both `jwc run` and
// `jwc build --native`.
//
//   jwc run examples/csv-export
//   curl http://localhost:8080/squares.csv

const HEADER = "n,square";

// GET /squares.csv — builds a CSV of n,n^2 for n in [0, count) using an array
// builder + join, then ships it with an explicit text/csv Content-Type.
route GET "/squares.csv" {
    let count = int(query_param("count", "10"));
    let rows = [HEADER];
    for n in range(0, count) {
        push(rows, n + "," + (n * n));
    }
    let body = join(rows, "\n");
    return response(body, "text/csv");
}

// GET / — tiny landing page so the root isn't a 404.
route GET "/" {
    return html("<h1>csv-export</h1><p>Try <a href=\"/squares.csv\">/squares.csv?count=20</a></p>");
}

function main() {
    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
