dbcontext AppDb : Postgres;

entity Note of AppDb {
    id int pk autoincrement;
    title varchar(200);
    body text;
    pinned bool;
    score int;

    comments: List<Comment> via Comment.note_id;
}

entity Comment of AppDb {
    id int pk autoincrement;
    note_id int;
    text varchar(500);
}

route GET "/notes" {
    let pinned = query_param("pinned", "");
    if (pinned == "true") {
        return json(select Note from AppDb.Note where Note.pinned == true orderby Note.id desc limit 50);
    }
    return json(select Note from AppDb.Note orderby Note.id desc limit 100);
}

route GET "/notes/count" {
    return json({
        total:  select count(*)     from AppDb.Note,
        pinned: select count(*)     from AppDb.Note where Note.pinned == true,
        top:    select max(Note.score) from AppDb.Note,
        avg:    select avg(Note.score) from AppDb.Note,
        sum:    select sum(Note.score) from AppDb.Note
    });
}

route GET "/notes/by-ids" {
    let a = query_param("a", 1);
    let b = query_param("b", 2);
    let c = query_param("c", 3);
    return json(select Note from AppDb.Note where Note.id in (@a, @b, @c) orderby Note.id asc);
}

route GET "/notes/range" {
    let lo = query_param("lo", 10);
    let hi = query_param("hi", 100);
    return json(select Note from AppDb.Note where Note.score between @lo and @hi orderby Note.score desc);
}

route GET "/notes/titles" {
    return json(select Note { id, title } from AppDb.Note orderby Note.id desc limit 50);
}

route GET "/notes/{id}/full" {
    let id = path_param("id");
    let n = select Note with comments from AppDb.Note where Note.id == @id first;
    if (n == null) {
        return not_found("note not found");
    }
    return json(n);
}

route GET "/notes/{id}" {
    let id = path_param("id");
    let n = select Note from AppDb.Note where Note.id == @id first;
    if (n == null) {
        return not_found("note not found");
    }
    return json(n);
}

route POST "/notes" {
    let req = body();
    let n = new Note();
    n.title = req.title;
    n.body = req.body;
    n.pinned = false;
    insert n into AppDb.Note;
    return created(n);
}

route DELETE "/notes/{id}" {
    let id = path_param("id");
    delete from AppDb.Note where Note.id == @id;
    return ok({ deleted: id });
}

route PATCH "/notes/{id}/pin" {
    let id = path_param("id");
    let n = select Note from AppDb.Note where Note.id == @id first;
    if (n == null) {
        return not_found("note not found");
    }
    n.pinned = true;
    update n in AppDb.Note;
    return ok(n);
}

middleware authMw {
    let token = header("Authorization");
    if (token == null) {
        return unauthorized({ error: "missing token" });
    }
}

errorHandler (e) {
    return internal_error({ message: e.message });
}

function noteRow(id) {
    return select Note from AppDb.Note where Note.id == @id first;
}

route GET "/notes/{id}/handler" -> noteRow;

route POST "/notes/validated" use authMw {
    validate body {
        title: required, minLength(3);
        body:  required;
    }
    let req = body();
    let n = new Note();
    n.title = req.title;
    n.body = req.body;
    n.pinned = false;
    n.score = 0;

    try {
        transaction {
            insert n into AppDb.Note;
            if (req.boom == true) {
                return internal_error({ error: "forced boom rolls back" });
            }
        }
        return created(n);
    } catch (e) {
        return internal_error({ caught: e.message });
    }
}

route WS "/echo" {
    while (true) {
        let msg = ws_recv();
        if (msg == null) {
            return null;
        }
        ws_send("echo: " + msg);
    }
}

async function main() {
    setConnectionString();
    print("native jwc up on :8080");
    serve(8080);
}
