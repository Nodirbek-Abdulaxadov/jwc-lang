// Interactive CLI program — no `serve()`, so `jwc run` executes `main()`
// and exits.
//
// This is the shape `console.read()` is for. Inside an HTTP route it is a
// mistake: stdin is not request input, and if the server was launched from
// a terminal a route calling it blocks that request until a human types.
// Use `body()` / `query_param()` / `header()` there.
//
// Note `console.write` rather than `print` for the prompt. `print` buffers
// into the interpreter's output string and flushes only after `main()`
// returns, so a prompt written with `print` would appear *after* you were
// expected to answer it.
function main() {
    console.write("Ismingiz: ");
    let ism = console.read();
    if (ism == null) {
        console.error("kiritish yopildi\n");
        return;
    }

    console.write("Yoshingiz: ");
    let yosh = console.read();

    let satr = "ism=" + ism + " yosh=" + yosh;
    console.write(satr + "\n");

    // Append it to a log the caller can inspect afterwards.
    directory.create("out");
    file.append("out/kirish.log", satr + "\n");
    console.write("yozildi: out/kirish.log (" + file.size("out/kirish.log") + " bayt)\n");
}
