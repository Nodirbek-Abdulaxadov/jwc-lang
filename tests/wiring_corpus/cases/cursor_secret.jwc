namespace cursor_secret;

-- config.md §3 — a `page` query needs `server { cursor_secret }`.
--
-- A cursor is a client-supplied predicate. Unsigned, a caller could hand
-- back any ordering tuple and read rows the query's own `where` was meant
-- to keep from them, so this is checked before the program runs rather
-- than left to the runtime to decide.
server {                            -- expect: E1205
    max_page_size = 50;
}

service Paged {
    function notes(cursor: text?, size: int) {
        return select N from App.s.Notes
            orderby id asc
            page after $cursor size $size;
    }
}
