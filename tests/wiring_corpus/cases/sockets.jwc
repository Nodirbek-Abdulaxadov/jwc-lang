namespace sockets;

-- routing.md §9 — a `socket` is a member of a `routes` block, beside its
-- HTTP siblings, sharing the prefix and the `use` chain.

middleware SockAuth provides who: text {
    let key = request.header("X-Key") or throw Unauthorized("kalit kerak");
    context.who = $key;
}

routes "/live" {
    route GET "health" {
        return json({ ok: true });
    }

    socket "rooms/{room: text}" use SockAuth {
        on open {
            -- `@room` is a path parameter; a socket has a path.
            socket.send("joined " + @room + " as " + context.who);
        }

        on message (text) {
            if ($text == "bye") {
                socket.close();
            }
            socket.send("echo: " + $text);
        }

        on close {
            let who = context.who;
        }
    }

    -- Send-only: no `on message`. Legal — a peer that speaks first is not
    -- an error, its frame is dropped.
    socket "ticks" {
        on open {
            socket.send("tick");
        }
    }
}

routes "/dup" {
    route GET "a" {
        return json({});
    }

    -- The upgrade is a GET on the wire, so this collides with the route
    -- above rather than coexisting with it.
    socket "a" {                                -- expect: E0710
        on open {
            socket.send("hi");
        }
    }
}

routes "/bad" {
    socket "returns" {
        on message (m) {
            -- The HTTP response was the 101 that got here.
            return json({ echoed: $m });        -- expect: E0814
        }
    }
}

routes "/misplaced" {
    route GET "x" {
        -- There is no connection here.
        socket.send("nope");                    -- expect: E0225
        return json({});
    }
}
