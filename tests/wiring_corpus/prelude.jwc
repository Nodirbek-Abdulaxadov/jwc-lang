namespace prelude;

database App : Postgres;
schema s of App;

table Orgs of App.s {
    id   bigint primary key identity;
    slug varchar(40) unique : "band";
    name varchar(120);
}

table Notes of App.s {
    id     bigint primary key identity;
    org_id bigint;
    body   text;

    foreign key (org_id) references App.s.Orgs (id);

    check (org_id > 0) : "musbat";
}

error Declined(message: text) = 402;
