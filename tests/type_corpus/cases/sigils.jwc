namespace sigils;

-- Every local reference carries `$`, so a bare name in a query clause is a
-- column and nothing else (names.md §5.3).
service Sigils {
    function tenancy_filter(org_id: bigint) {
        return select N from App.s.Notes where org_id == $org_id;
    }

    function missing_sigil(org_id: bigint) {
        return select N from App.s.Notes where body == org_id;   -- expect: E0376
    }

    function tautology(org_id: bigint) {
        return select N from App.s.Notes where org_id == org_id; -- expect: W0104
    }

    function unknown_column(org_id: bigint) {
        return select N from App.s.Notes where nope == $org_id;  -- expect: E0211
    }

    function local_without_sigil_outside_a_query() {
        let x = 1;
        return x;                                                -- expect: E0211
    }
}
