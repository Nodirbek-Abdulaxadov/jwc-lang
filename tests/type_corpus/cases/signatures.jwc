namespace signatures;

-- Typed service boundaries (types.md §10).
service Sigs {
    function takes_two(a: bigint, b: text) -> text {
        return $b;
    }

    function wrong_arity() {
        return Sigs.takes_two(1);               -- expect: E0353
    }

    function wrong_type() {
        return Sigs.takes_two(1, 2);            -- expect: E0354
    }

    function unknown_method() {
        return Sigs.nope(1);                    -- expect: E0204
    }

    function incompatible_returns(flag: boolean) {
        if ($flag) { return { a: 1 }; }
        return { b: "x" };                      -- expect: E0351
    }

    function compatible_returns(flag: boolean) {
        if ($flag) { return { status: "duplicate" }; }
        return { status: "ok" };
    }

    function annotated_disagrees() -> text {
        return 1;                               -- expect: E0351
    }

}

-- errors.md §3.3 — only a package boundary declares a raise set; the
-- compiler infers it everywhere else.
function raises_is_not_for_app_code() raises (NotFound) {   -- expect: E1003
    return 1;
}
