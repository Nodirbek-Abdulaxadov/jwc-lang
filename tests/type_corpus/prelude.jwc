namespace prelude;

database App : Postgres;
schema s of App;

enum Role of App.s { owner, admin, member }
enum Status { draft, live }

table Orgs of App.s {
    id         bigint primary key identity;
    slug       varchar(40) unique;
    name       varchar(120);
    region     varchar(20)?;
    created_at timestamptz default now();
}

table Members of App.s {
    org_id     bigint;
    account_id bigint;
    role       Role default Role.member;
    secret     varchar(64) private;
    added_by   bigint server;

    primary key (org_id, account_id);
    foreign key (org_id) references App.s.Orgs (id) on delete cascade;
}

--- An account with a stored password digest, for the hash rules
--- (builtins.md §6).
table Accounts of App.s {
    id            bigint primary key identity;
    email         varchar(255) unique;
    password_hash varchar(255) private;
}

table Notes of App.s {
    id      bigint primary key identity;
    org_id  bigint;
    body    text;
    status  Status default Status.draft;
    amount  numeric(14, 2);
    retired timestamptz?;

    foreign key (org_id) references App.s.Orgs (id);

    unique (org_id, body) where retired == null : "band";
}

table Invites of App.s {
    id          bigint primary key identity;
    org_id      bigint;
    invited_by  bigint;
    accepted_by bigint?;
    email       varchar(255);

    foreign key (org_id)      references App.s.Orgs (id);
    foreign key (invited_by)  references App.s.Orgs (id);
    foreign key (accepted_by) references App.s.Orgs (id);
}

--- A `jsonb` payload, for the write rules (types.md §5.6). Its shape is
--- per-event, which is the point: it is the one column type whose shape is
--- not the schema's business.
table Events of App.s {
    id      bigint primary key identity;
    org_id  bigint;
    payload jsonb;

    foreign key (org_id) references App.s.Orgs (id);
}

view OrgList of App.s {
    select O from App.s.Orgs
        left join App.s.Members M on M.org_id == O.id
            as many members orderby account_id asc limit 200
        as { id, slug, name, members: { account_id, role } }
}

--- A view with both a nested `one` and a collection: ordering by the
--- nested field lowers to a flattened column, which the base table does
--- not have (queries.md §8.3).
view NoteWithOrg of App.s {
    select N from App.s.Notes
        left join App.s.Orgs O on O.id == N.org_id as one org
        left join App.s.Invites I on I.org_id == N.org_id
            as many invites under N orderby id asc limit 200
        as { id, body, org: { id, name }, invites: { id, email } }
}

class NoteInput {
    body   text           required;
    amount numeric(14, 2) required, min(0);
    status Status?;
}

class WithExtra {
    body     text required;
    nickname text?;
}

class MemberInput {
    role   Role?;
    secret text?;
}

class ServerInput {
    role     Role?;
    added_by bigint?;
}

class WithTransient {
    body  text required;
    debug text? transient;
}
