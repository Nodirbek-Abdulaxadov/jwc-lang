-- ops: 2 create_table org.notes
-- ops: 4 add_constraint org.notes.fk_notes__org_id
-- ops: 5 create_index org.ix_notes__org_id
-- ops: 7 comment_on org.notes
-- ops: 7 comment_on org.notes.body

namespace c;
database App : Postgres;
schema org of App;

table Orgs of App.org {
    id bigint primary key identity;
}

--- Free-form notes on an org.
table Notes of App.org {
    id      bigint primary key identity;
    org_id  bigint;
    --- Markdown.
    body    text;

    foreign key (org_id) references App.org.Orgs (id) on delete cascade;
    index on (org_id);
}
