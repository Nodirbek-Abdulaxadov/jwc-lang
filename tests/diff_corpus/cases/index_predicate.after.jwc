-- ops: 9 drop_index org.uq_orgs__slug__9661dc66

namespace c;
database App : Postgres;
schema org of App;

table Orgs of App.org {
    id         bigint primary key identity;
    slug       varchar(40);
    retired_at timestamptz?;

    unique (slug) where retired_at != null : "faol slug bitta";
}
