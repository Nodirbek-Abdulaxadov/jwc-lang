-- ops: 2 add_column org.orgs.updated_at
-- ops: 6 create_function org.tg_orgs__touch
-- ops: 6 create_trigger org.orgs.tg_orgs__touch

namespace c;
database App : Postgres;
schema org of App;

table Orgs of App.org {
    id         bigint primary key identity;
    updated_at timestamptz default now() on update now();
}
