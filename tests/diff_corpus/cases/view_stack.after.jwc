-- ops: 0 drop_view org.org_top
-- ops: 0 drop_view org.org_summary
-- ops: 2 alter_column_type org.orgs.name varchar(80) -> varchar(200)
-- ops: 8 create_view org.org_summary
-- ops: 8 create_view org.org_top

namespace c;
database App : Postgres;
schema org of App;

table Orgs of App.org {
    id   bigint primary key identity;
    slug varchar(40);
    name varchar(200)?;
}

view OrgSummary of App.org {
    select O from App.org.Orgs as { id, slug };
}

view OrgTop of App.org {
    select S from App.org.OrgSummary as { id, slug };
}
