-- ops: 2 add_column org.orgs.display_name
-- ops: 9 drop_column org.orgs.name
-- diag: E1103

namespace c;
database App : Postgres;
schema org of App;

enum Plan of App.org { free, pro }

table Orgs of App.org {
    id   bigint primary key identity;
    slug varchar(40) unique;
    plan Plan;
    display_name varchar(80)? was "nickname";
}
