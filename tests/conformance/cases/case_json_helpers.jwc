// Conformance: json_parse + json_stringify across the value model.
//
// case_json covers the basic shape; this case pins the round-trip
// rule (json_stringify -> json_parse -> field access yields the
// original values), the mixed-type array serialization order, and
// the null serializer — three corners that are easy to break when
// touching the JSON path during the Phase 1 value-model rework.
function main() {
    // json_parse on flat object — field access by name
    let s = "{\"id\":42,\"name\":\"ada\"}";
    let obj = json_parse(s);
    print(obj.id);
    print(obj.name);

    // json_parse on an array of ints — indexing helpers
    let arr = json_parse("[10,20,30]");
    print(length(arr));
    print(first(arr));
    print(last(arr));

    // json_stringify -> json_parse round-trip on an object literal.
    // Every field reachable on the original payload must read back the
    // same value after a stringify/parse cycle.
    let payload = { ok: true, n: 7, msg: "hello" };
    let serialized = json_stringify(payload);
    let parsed = json_parse(serialized);
    print(parsed.ok);
    print(parsed.n);
    print(parsed.msg);

    // json_stringify of arrays of mixed types — null becomes the JSON
    // null literal, not the string "null".
    print(json_stringify([1, "x", true, null]));

    // top-level null
    print(json_stringify(null));
}
