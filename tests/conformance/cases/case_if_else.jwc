// Conformance: if / else if / else.
function classify(n: int): string {
    if (n < 0) {
        return "neg";
    } else if (n == 0) {
        return "zero";
    } else if (n < 10) {
        return "small";
    } else {
        return "big";
    }
}

function main() {
    print(classify(-3));
    print(classify(0));
    print(classify(5));
    print(classify(100));

    let x = 7;
    if (x > 0) {
        print("pos");
    } else {
        print("nonpos");
    }
    if (!(x == 0)) {
        print("nonzero");
    }
}
