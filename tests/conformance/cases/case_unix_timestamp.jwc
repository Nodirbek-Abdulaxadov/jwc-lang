// CONFORMANCE: interpreter-only
// `unix_timestamp()` is native-AOT-deferred — interpreter-only for now.
// Smoke-checks that the current Unix seconds fall inside a plausible
// window so a regression in the time builtin surfaces immediately.
function main() {
    let now = unix_timestamp();
    if (now < 1704067200) {
        print("too-low");
    } else if (now > 4102444800) {
        print("too-high");
    } else {
        print("within-range");
    }
}
