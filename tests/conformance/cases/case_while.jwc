// Conformance: while loops, including early break.
function main() {
    let n = 0;
    while (n < 5) {
        print(n);
        n = n + 1;
    }

    let acc = 1;
    let i = 1;
    while (i <= 5) {
        acc = acc * i;
        i = i + 1;
    }
    print(acc);

    let k = 0;
    while (true) {
        if (k == 3) {
            break;
        }
        print("k=" + k);
        k = k + 1;
    }
    print("done");
}
