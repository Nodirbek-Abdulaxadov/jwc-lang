// Conformance: `catch (e: Error)` is the catch-all super-kind — every
// runtime error matches it, exactly like a bare `catch (e)`. This is a
// regression guard for Sprint 3's typed-catch dispatch: tightening the
// classifier or the parser must not accidentally narrow the `Error`
// supertype's coverage.
//
// We provoke a generic runtime error via division by zero, which the
// classifier in `runner::mod.rs::classify_jwc_error` returns as
// `"Error"` (no specific subsystem signature on the chain). The typed
// `catch (e: Error)` must fire and print the caught message.
function divide(a: int, b: int): int {
    return a / b;
}

function main() {
    try {
        let _bad = divide(7, 0);
        print("never reached");
    } catch (e: Error) {
        print("caught: " + e.message);
    }

    // Second shape: throwing from a deeper call frame must still classify
    // as `"Error"` and still match `catch (e: Error)`. This guards
    // against future changes that might miss errors raised below the
    // top-level try block.
    try {
        let _bad = divide(divide(1, 1), divide(1, 0));
        print("never reached");
    } catch (e: Error) {
        print("nested caught");
    }
}
