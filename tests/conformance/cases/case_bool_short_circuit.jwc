// Conformance: boolean `and` / `or` short-circuit semantics.
// `false and X` must not require X to be true; `true or X` must skip X.
function side_true(): bool {
    print("called");
    return true;
}

function main() {
    // `and` short-circuit: false short-circuits, no "called" should print.
    if (false and side_true()) {
        print("unreachable-1");
    } else {
        print("and-skipped");
    }

    // `or` short-circuit: true short-circuits, no "called" should print.
    if (true or side_true()) {
        print("or-skipped");
    }

    // `and` non-short-circuit branch: function IS called, prints "called".
    if (true and side_true()) {
        print("and-took");
    }

    // `or` non-short-circuit branch: function IS called, prints "called".
    if (false or side_true()) {
        print("or-took");
    }

    print(true and false);
    print(true or false);
    print(false and true);
    print(false or false);
}
