// Conformance: string built-ins — length, upper, lower, trim, contains,
// starts_with, ends_with, replace, split.
function main() {
    print(length("hello"));
    print(length(""));
    print(upper("jwc"));
    print(lower("JWC"));
    print(trim("   spaced   "));
    print(contains("backend", "end"));
    print(contains("backend", "zzz"));
    print(starts_with("jwc-lang", "jwc"));
    print(ends_with("jwc-lang", "lang"));
    print(replace("a-b-c", "-", "/"));
    print(split("a,b,c", ","));
    print(join(split("a,b,c", ","), "|"));
    print(first(["x", "y", "z"]));
    print(last(["x", "y", "z"]));
}
