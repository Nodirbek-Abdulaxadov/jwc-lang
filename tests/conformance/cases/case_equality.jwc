// Conformance: equality across types — `==` and `!=` plus ordering.
function main() {
    print(1 == 1);
    print(1 == 2);
    print(1 != 2);
    print("a" == "a");
    print("a" == "b");
    print("a" != "b");
    print(true == true);
    print(true == false);
    print(null == null);

    // numeric cross-type equality (int vs float with same numeric value)
    print(1 == 1.0);
    print(2.5 == 2.5);

    // ordering operators
    print(1 < 2);
    print(2 <= 2);
    print(3 > 2);
    print(3 >= 3);
    print(1 < 2.5);
    print(2.5 <= 2.5);
}
