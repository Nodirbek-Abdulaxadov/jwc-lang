// CONFORMANCE: interpreter-only
// Smoke-test that now() / unix_timestamp() / uuid() execute and return
// non-empty strings of plausible length. We CANNOT assert the actual
// timestamp/UUID values (non-deterministic), so we collapse to boolean
// checks for stable stdout. Marked interpreter-only because the native
// AOT whitelist (`builtins::native_builtin_names`) does not include
// `unix_timestamp` yet — when it lands, drop the marker line.
function main() {
    let ts = now();
    print(length(ts) > 10);
    let u = uuid();
    print(length(u) == 36);
    let secs = unix_timestamp();
    print(secs > 0);
}
