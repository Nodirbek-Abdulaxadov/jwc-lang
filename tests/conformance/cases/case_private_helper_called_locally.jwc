// CONFORMANCE: interpreter-only
// E021 / visibility: a `private` function is callable from a `public`
// function in the SAME namespace; main() then reaches the public entry
// from root via the qualified name. This pins the validator's "same
// namespace → always OK" branch and the cross-namespace `public` →
// reachable branch in one stdout-matching case.

private function root_helper(x: int): int {
    return x + 1;
}

function main() {
    let r = root_helper(41);
    print(r);
}
