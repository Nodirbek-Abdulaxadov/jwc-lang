// Conformance: console.write does NOT land in the print buffer.
//
// IMPORTANT — the golden file below intentionally contains ONLY the `print`
// lines. `print` appends to `Vm::output`, which is what the harness
// compares; `console.write` goes straight to the process stdout and is
// invisible to it. That asymmetry is the feature: it is what makes
// `console.write` safe to call inside a route handler, where a
// fall-through `print` would become the HTTP response body.
//
// Do not "fix" this fixture by adding the console.write text.
function main() {
    console.write("bu golden faylda yo'q\n");
    print("bu bor");
    console.error("bu ham yo'q\n");
    print("bu ham bor");
}
