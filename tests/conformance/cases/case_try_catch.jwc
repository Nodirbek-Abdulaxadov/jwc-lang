// Conformance: try / catch — both bare catch and typed catch dispatch.
function divide(a: int, b: int): int {
    return a / b;
}

function main() {
    // Bare catch: any error caught.
    try {
        let bad = divide(1, 0);
        print("never");
    } catch (e) {
        print("caught: " + e.message);
    }

    // Typed catch: filter by Error type. division-by-zero classifies
    // as a generic Error so this branch fires.
    try {
        let bad = divide(2, 0);
    } catch (e: Error) {
        print("typed: caught");
    }
}
