// Conformance: integer and float arithmetic — + - * / %.
function main() {
    print(2 + 3);
    print(10 - 4);
    print(6 * 7);
    print(20 / 6);
    print(20 % 6);
    print(2.5 + 1.25);
    print(10.0 - 0.5);
    print(2.0 * 3.5);
    print(7.0 / 2.0);
    print(-3 + 8);
    print(2 + 3 * 4);
    print((2 + 3) * 4);
    print(7 / 2);
    print(7.0 / 2);
}
