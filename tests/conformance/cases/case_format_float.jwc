// Conformance: JWC float formatting (`format_float` in runner/native).
// Strips trailing zeros after the decimal point; whole floats render
// without a `.0`; negative-zero renders as `0`.
function main() {
    print(1.0);
    print(1.5);
    print(0.1 + 0.2);
    print(-0.0);
    print(2.5 * 2);
    print(7.0 / 2.0);
    print(100.0);
    print(0.001);
    print(-3.14);
}
