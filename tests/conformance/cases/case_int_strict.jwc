// Conformance: int() trims, and raises on input that isn't a number.
//
// The old behaviour answered 0 for anything unparseable, which made
// `int("abc")` and `int("0")` indistinguishable — a value read from
// console.read() or a query param became a plausible-looking zero instead
// of an error. A single trailing space was enough to trigger it.
function main() {
    print(int(" 42 "));
    print(int("-3"));
    print(int(3.7));
    print(int(true));
    print(int(null) == null);
    try {
        print(int("abc"));
    } catch (e: ValidationError) {
        print("caught");
    }
}
