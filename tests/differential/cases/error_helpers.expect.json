{
  "requests": [
    {
      "name": "badRequest with an object body keeps the object",
      "method": "GET",
      "path": "/bad-obj",
      "expect": {
        "status": 400,
        "json": { "got": "x" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "badRequest with a string wraps it in error",
      "method": "GET",
      "path": "/bad-str",
      "expect": {
        "status": 400,
        "json": { "error": "plain text" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "internalError with an object body keeps the object",
      "method": "GET",
      "path": "/ise-obj",
      "expect": {
        "status": 500,
        "json": { "got": "x" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "internalError with a string wraps it in error",
      "method": "GET",
      "path": "/ise-str",
      "expect": {
        "status": 500,
        "json": { "error": "boom" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "notFound wraps its message",
      "method": "GET",
      "path": "/notfound",
      "expect": {
        "status": 404,
        "json": { "error": "gone" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "unauthorized wraps its message",
      "method": "GET",
      "path": "/unauth",
      "expect": {
        "status": 401,
        "json": { "error": "nope" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "forbidden wraps its message",
      "method": "GET",
      "path": "/forbidden",
      "expect": {
        "status": 403,
        "json": { "error": "no" },
        "headers": { "content-type": "application/json" }
      }
    },
    {
      "name": "badRequest with no argument uses the default message",
      "method": "GET",
      "path": "/bad-none",
      "expect": { "status": 400, "json": { "error": "Bad Request" } }
    },
    {
      "name": "notFound with no argument uses the default message",
      "method": "GET",
      "path": "/notfound-none",
      "expect": { "status": 404, "json": { "error": "Not Found" } }
    },
    {
      "name": "internalError with no argument uses the default message",
      "method": "GET",
      "path": "/ise-none",
      "expect": { "status": 500, "json": { "error": "Internal Server Error" } }
    }
  ]
}
