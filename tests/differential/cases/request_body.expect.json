{
  "requests": [
    {
      "name": "raw object body reaches the handler",
      "method": "POST",
      "path": "/size",
      "body": "{\"a\":1,\"b\":2}",
      "expect": { "status": 200, "json": { "size": 2 } }
    },
    {
      "name": "raw array body reaches the handler",
      "method": "POST",
      "path": "/size",
      "body": "[1,2,3,4,5]",
      "expect": { "status": 200, "json": { "size": 5 } }
    },
    {
      "name": "no body yields the literal string null",
      "method": "GET",
      "path": "/empty",
      "expect": { "status": 200, "json": { "missing": true } }
    }
  ]
}
