// Regression cover for the write half of the `RawJson` field-access defect in
// TODO.md, found on 0.8.7 building a CRUD demo.
//
// Read-modify-write is how every REST update handler is written:
//
//     let existing = select Todo from AppDb.Todo where Todo.id == @id first;
//     existing.title = req.title;
//     update existing in AppDb.Todo;
//
// A row from `select ... first` is `V::RawJson`; `jwc_set_field` matched only
// Object and Record and panicked on everything else, so that assignment blew
// up on every request under a native build while `jwc run` handled it fine.
// TODO.md reports it on 0.8.7 as a worker-thread panic that dropped the
// connection; on 0.9.x the panic is caught and answers HTTP 500, which is what
// this case sees without the fix. Either way the handler never runs.
//
// The read half was fixed earlier; this pins the write half. `select ... first`
// needs Postgres, but the defect is one match arm — `V::RawJson(s) | V::Str(s)`
// — and `request_body()` hands back exactly such a JSON-bearing `V::Str`, so
// this reaches it without a database. (`json_parse` does not: it returns an
// already-parsed Object, which took the working arm all along.)

route POST "/rmw" {
    let row = request_body();
    // Overwrite an existing key, then add one the shape never had — the two
    // branches materialise differently.
    row.title = "after";
    row.extra = "added";
    return json({
        id: row.id,
        title: row.title,
        done: row.done,
        extra: row.extra
    });
}

function main() {
    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
