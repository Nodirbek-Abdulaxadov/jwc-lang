{
  "requests": [
    {
      "name": "302 carries the Location header",
      "method": "GET",
      "path": "/go",
      "expect": {
        "status": 302,
        "headers": { "location": "/target" }
      }
    },
    {
      "name": "the redirect target still serves normally",
      "method": "GET",
      "path": "/target",
      "expect": { "status": 200, "json": { "arrived": true } }
    }
  ]
}
