// Regression cover for the two `validate body` defects in TODO.md, both found
// in the field on 0.8.7 against a deployed jwc-shortener.
//
//   A. `pattern(...)` was not enforced against a present, non-matching value
//      natively. It fired when the field was absent and `minLength` worked,
//      so the rule looked live — but `javascript:alert(1)` sailed through and
//      got stored and later re-emitted as a `Location:` header. Production is
//      the `--native` build, so this was a live phishing relay.
//
//   B. A native validation failure answered `HTTP 200` carrying a body that
//      said `"status":400`, in the pre-0.7.0 envelope shape (`fields`, no
//      `code`). Browsers saw `res.ok == true`; load tests counted rejections
//      as successful writes.
//
// Both need the status line *and* the body shape asserted, on both backends,
// which is why they belong here rather than in `native_parity.rs`.

route POST "/links" {
    validate body {
        url: required, minLength(8), maxLength(2048), pattern(r"^https?://");
    }
    return json({ created: true });
}

function main() {
    let port_env = env("PORT");
    let port = 8080;
    if (port_env != "") {
        port = int(port_env);
    }
    serve(port);
}
