--- Aggregates over a bare join. `count` is an int on the wire; `sum` and
--- `avg` widen and come back as strings, because that is what their JWC
--- type says (types.md §6.3).
namespace aggregates;

database App : Postgres;
schema s of App;

enum OrderStatus of App.s { open, paid, void }

table Customers of App.s {
    id     bigint primary key identity;
    name   varchar(120);
    region varchar(20)?;
}

table Orders of App.s {
    id          bigint primary key identity;
    customer_id bigint;
    status      OrderStatus default OrderStatus.open;
    amount      numeric(14, 2);
    items       int;

    foreign key (customer_id) references App.s.Customers (id);
}

view CustomerTotals of App.s {
    select C from App.s.Customers
        left join App.s.Orders O on O.customer_id == C.id as group
        group by C.id, C.name
        as {
            customer_id: id,
            name,
            order_count: count(O.id),
            paid_count:  count(O.id where O.status == OrderStatus.paid),
            paid_total:  sum(O.amount where O.status == OrderStatus.paid),
            item_total:  sum(O.items),
            avg_amount:  avg(O.amount),
            first_order: min(O.id),
            last_order:  max(O.id)
        }
}

--- `having` reads an aggregate, so the literal it is compared against is
--- cast to what the aggregate comes back as, not to the column's type.
view BusyCustomers of App.s {
    select C from App.s.Customers
        left join App.s.Orders O on O.customer_id == C.id as group
        group by C.id
        having count(O.id) > 2
        as { customer_id: id, order_count: count(O.id) }
        orderby id asc
}

--- Two bare joins fan out, so a plain `count` over either one counts the
--- other's rows too. `count.distinct` is the answer, and W0502 is the
--- warning that points at it.
table Notes of App.s {
    id          bigint primary key identity;
    customer_id bigint;
    body        text;

    foreign key (customer_id) references App.s.Customers (id);
}

view CustomerActivity of App.s {
    select C from App.s.Customers
        left join App.s.Orders O on O.customer_id == C.id as group
        left join App.s.Notes N on N.customer_id == C.id as group
        group by C.id
        as {
            customer_id: id,
            orders: count.distinct(O.id),
            notes:  count.distinct(N.id)
        }
}
