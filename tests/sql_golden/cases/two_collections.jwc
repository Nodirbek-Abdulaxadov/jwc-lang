--- Two collections projected side by side. Under `json_agg` over a plain
--- join this is the classic wrong answer: each collection multiplies the
--- other's rows, so three tags and two notes report six of each. Two
--- independent laterals do not interact.
namespace two_collections;

database App : Postgres;
schema s of App;

table Orgs of App.s {
    id   bigint primary key identity;
    name varchar(120);
}

table Notes of App.s {
    id         bigint primary key identity;
    org_id     bigint;
    body       text;
    created_at timestamptz default now();

    foreign key (org_id) references App.s.Orgs (id);
}

table Tags of App.s {
    id     bigint primary key identity;
    org_id bigint;
    label  varchar(40);

    foreign key (org_id) references App.s.Orgs (id);
}

view OrgBoard of App.s {
    select O from App.s.Orgs
        left join App.s.Notes N on N.org_id == O.id
            as many notes orderby created_at desc limit 20
        left join App.s.Tags T on T.org_id == O.id
            as many tags orderby label asc
        as {
            id,
            name,
            notes: { id, body },
            tags: { id, label },
        }
}
