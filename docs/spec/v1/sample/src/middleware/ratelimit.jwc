namespace middleware.ratelimit;

import redis;

--- Keyed on the declared route pattern, not the concrete path: one bucket
--- per endpoint, not one per id (routing.md §5.4).
middleware RateLimit {
    let ip = request.client_ip();
    let route = request.route();
    let key = "rl:" + $route + ":" + string.of($ip);

    let allowed = redis.rate_limit($key, 100, 60);

    if (!$allowed) {
        throw TooManyRequests("juda ko'p so'rov");
    }
}

middleware StrictRateLimit {
    let ip = request.client_ip();
    let key = "rl:strict:" + string.of($ip);

    let allowed = redis.rate_limit($key, 5, 300);

    if (!$allowed) {
        throw TooManyRequests("juda ko'p urinish, keyinroq qayting");
    }
}

--- Reads the body before the handler does. Same buffer, so the handler's
--- `request.body() as WebhookPayment` sees exactly these bytes
--- (routing.md §5.1).
middleware VerifySignature {
    let signature = request.header("X-Signature") or throw Unauthorized("imzo yo'q");

    let payload = request.raw_body();
    let secret = env("STRIPE_WEBHOOK_SECRET") or throw Unauthorized("server sozlanmagan");

    let valid = hash.hmac_verify($payload, $signature, $secret);

    if (!$valid) {
        throw Unauthorized("imzo yaroqsiz");
    }
}
