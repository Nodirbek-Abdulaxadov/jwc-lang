namespace routes.orgs;

import dto.org;
import middleware.audit;
import middleware.auth;
import services.org;


routes "/api/v1/orgs" use RequireAuth, Audit {

    route POST "" {
        let req = request.body() as OrgCreate;
        let org = OrgService.create($req, context.account_id);

        return created(json($org)) with { "Location": "/api/v1/orgs/" + string.of($org.id) };
    }
}

routes "/api/v1/orgs/{org_id: bigint}" use RequireAuth, RequireOrgMember, Audit {

    route GET "" {
        let org = OrgService.detail(@org_id);

        return json($org);
    }

    route PATCH "" use RequireOrgAdmin {
        let req = request.body() as OrgEdit;
        let org = OrgService.update(@org_id, $req);

        return json($org);
    }

    route DELETE "" use RequireOrgAdmin {
        OrgService.remove(@org_id, context.role);

        return noContent();
    }
}

routes "/api/v1/orgs/{org_id: bigint}/members" use RequireAuth, RequireOrgMember, Audit {

    route GET "" {
        let members = OrgService.members(@org_id);

        return json($members);
    }

    route PATCH "{account_id: bigint}" use RequireOrgAdmin {
        let req    = request.body() as MemberEdit;
        let member = OrgService.set_role(@org_id, @account_id, $req);

        return json($member);
    }

    route DELETE "{account_id: bigint}" use RequireOrgAdmin {
        OrgService.remove_member(@org_id, @account_id);

        return noContent();
    }
}

routes "/api/v1/orgs/{org_id: bigint}/invites"
    use RequireAuth, RequireOrgMember, RequireOrgAdmin, Audit {

    route GET "" {
        let invites = OrgService.invites(@org_id);

        return json($invites);
    }

    route POST "" {
        let req    = request.body() as InviteCreate;
        let invite = OrgService.invite(@org_id, $req, context.account_id);

        return created(json($invite));
    }

    route DELETE "{invite_id: bigint}" {
        OrgService.revoke_invite(@org_id, @invite_id);

        return noContent();
    }
}
