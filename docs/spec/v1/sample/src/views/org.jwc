namespace views.org;

import app;
import db.auth;
import db.org;

--- One org with its members, each member carrying its account.
--- `account` attaches to `members` because its `on` clause names only
--- `Members` besides the joined table (queries.md §4.4).
view OrgWithMembers of App.org {
    select O from App.org.Orgs
        left join App.org.Members M on M.org_id == O.id as many members orderby joined_at asc
        left join App.auth.Accounts A on A.id == M.account_id as one account
        as {
            id,
            slug,
            name,
            created_at,
            members: {
                role,
                joined_at,
                account: { id, email, display_name }
            }
        }
}

--- The membership gate reads `role` off this view, which is legal because
--- a view is a projection and therefore a Record (types.md §5.3).
view MemberAccess of App.org {
    select M from App.org.Members
        left join App.org.Orgs O on O.id == M.org_id as one org
        as {
            org_id,
            account_id,
            role,
            org: { id, slug, name }
        }
}
