namespace app;


database App : Postgres {
    init() {
        pool_size         = int(env("DB_POOL") ?? "20");
        statement_timeout = "10s";
        connect_timeout   = "5s";
        tls               = env("DB_TLS") == "1";
    }
}

schema auth    of App;
schema org     of App;
schema billing of App;
schema audit   of App;


server {
    max_body_bytes  = 262144;
    request_timeout = "30s";
    max_page_size   = 200;
    cursor_secret   = env("CURSOR_SECRET");
    trusted_proxies = ["10.0.0.0/8"];

    cors {
        origins     = ["https://app.example.com"];
        methods     = ["GET", "POST", "PATCH", "DELETE"];
        headers     = ["authorization", "content-type"];
        credentials = true;
    }
}


--- Provider declined the charge. Not a client mistake and not our fault,
--- so it needs its own status and its own arm.
error PaymentDeclined(code: text) = 402 : "to'lov rad etildi";


-- Every other error type this app raises carries a default status, so it
-- needs no arm here (errors.md §4.3). This handler exists for the one case
-- that wants a non-default body.
errorHandler (e) {
    catch PaymentDeclined (err) {
        return statusCode(402, { error: $err.message, code: $err.code });
    }
    catch (err) {
        return internalError();
    }
}


function main() {
    serve(int(env("PORT") ?? "8080"));
}
