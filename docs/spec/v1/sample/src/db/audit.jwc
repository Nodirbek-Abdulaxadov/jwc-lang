namespace db.audit;

import app;


table Events of App.audit {
    id         bigint primary key identity;
    org_id     bigint?;
    actor_id   bigint?;
    action     varchar(60);
    entity     varchar(60);
    entity_id  bigint?;
    payload    jsonb?;
    ip         inet?;
    created_at timestamptz default now();

    foreign key (org_id)   references App.org.Orgs (id)     on delete set null;
    foreign key (actor_id) references App.auth.Accounts (id) on delete set null;

    index on (org_id, created_at);
    index on (entity, entity_id);
}
