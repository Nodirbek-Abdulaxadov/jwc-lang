namespace db.org;

import app;
import db.auth;

enum MemberRole of App.org { owner, admin, member, viewer }

--- Tenant. Every billing and audit row hangs off one of these.
table Orgs of App.org {
    id         bigint primary key identity;
    --- URL-safe handle. Immutable after creation.
    slug       varchar(40) unique : "bu slug band", pattern(r"^[a-z0-9-]{3,40}$") : "slug faqat kichik harf, raqam va tire";
    name       varchar(120) minLength(2) : "nom kamida 2 ta belgi bo'lsin";
    created_at timestamptz default now();
}

table Members of App.org {
    org_id     bigint;
    account_id bigint;
    role       MemberRole default MemberRole.member;
    joined_at  timestamptz default now();

    primary key (org_id, account_id);
    foreign key (org_id) references App.org.Orgs (id) on delete cascade;
    foreign key (account_id) references App.auth.Accounts (id) on delete cascade;

    index on (account_id);
}

table Invites of App.org {
    id          bigint primary key identity;
    org_id      bigint;
    email       varchar(255) pattern(r"^[^@]+@[^@]+\.[^@]+$") : "email manzili yaroqsiz";
    role        MemberRole default MemberRole.member;
    token_hash  varchar(64) private, unique : "bu taklifnoma allaqachon yaratilgan";
    invited_by  bigint server;
    expires_at  timestamptz;
    accepted_at timestamptz?;
    created_at  timestamptz default now();

    foreign key (org_id) references App.org.Orgs (id) on delete cascade;
    foreign key (invited_by) references App.auth.Accounts (id);
    unique (org_id, email) where accepted_at == null : "bu emailga taklifnoma allaqachon yuborilgan";

    index on (expires_at);
}
