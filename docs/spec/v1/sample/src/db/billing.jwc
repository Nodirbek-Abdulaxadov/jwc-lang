namespace db.billing;

import app;

enum BillingInterval of App.billing { monthly, yearly }

enum SubscriptionStatus of App.billing { trialing, active, past_due, canceled }

enum InvoiceStatus of App.billing { draft, open, paid, void }

enum PaymentStatus of App.billing { pending, succeeded, failed, refunded }

--- Money is `numeric`, never an integer count of cents (types.md §2.1).
--- `price` is per `interval`.
table Plans of App.billing {
    id         bigint primary key identity;
    code       varchar(40) unique, pattern(r"^[a-z0-9_]+$");
    name       varchar(80);
    price      numeric(14, 2) min(0);
    currency   varchar(3) default "USD" pattern(r"^[A-Z]{3}$");
    interval   BillingInterval default BillingInterval.monthly;
    features   jsonb?;
    active     boolean default true;
    created_at timestamptz default now();

    index on (active, code);
}

table Subscriptions of App.billing {
    id                   bigint primary key identity;
    org_id               bigint;
    plan_id              bigint;
    status               SubscriptionStatus default SubscriptionStatus.trialing;
    current_period_start timestamptz;
    current_period_end   timestamptz;
    cancel_at            timestamptz?;
    canceled_at          timestamptz?;
    created_at           timestamptz default now();
    updated_at           timestamptz default now() on update now();

    foreign key (org_id) references App.org.Orgs (id) on delete cascade;
    foreign key (plan_id) references App.billing.Plans (id);
    check (current_period_end > current_period_start) : "davr oxiri boshidan keyin bo'lishi kerak";
    check (status == SubscriptionStatus.canceled or canceled_at == null) : "canceled_at faqat bekor qilingan obunada";
    unique (org_id) where status != SubscriptionStatus.canceled : "bu tashkilotda faol obuna allaqachon bor";

    index on (status, current_period_end);
}

--- Monotonic counters. `update … first` emits FOR UPDATE, which is what
--- makes this safe under concurrency (writes.md §4). Sequences are
--- DEFERRED-17.
table Counters of App.billing {
    name  varchar(40) primary key;
    value bigint default 0;
}

table Invoices of App.billing {
    id              bigint primary key identity;
    org_id          bigint;
    subscription_id bigint?;
    number          varchar(20) unique : "bu hisob raqami band";
    amount          numeric(14, 2) min(0);
    currency        varchar(3) default "USD";
    status          InvoiceStatus default InvoiceStatus.draft;
    issued_at       timestamptz?;
    due_at          timestamptz?;
    paid_at         timestamptz?;
    created_at      timestamptz default now();

    foreign key (org_id) references App.org.Orgs (id);
    foreign key (subscription_id) references App.billing.Subscriptions (id) on delete set null;
    check (status == InvoiceStatus.paid or paid_at == null) : "paid_at faqat to'langan hisobda";

    index on (org_id, status);
    index on (org_id, issued_at desc, id desc);
    index on (due_at) where status == InvoiceStatus.open;
}

table InvoiceLines of App.billing {
    id          bigint primary key identity;
    invoice_id  bigint;
    description varchar(200) minLength(1);
    quantity    int min(1);
    unit_price  numeric(14, 2) min(0);

    foreign key (invoice_id) references App.billing.Invoices (id) on delete cascade;

    index on (invoice_id);
}

table Payments of App.billing {
    id           bigint primary key identity;
    invoice_id   bigint;
    provider     varchar(20);
    --- The provider's idempotency key. `on conflict do nothing` on this
    --- constraint is what makes webhook redelivery safe (writes.md §2.3).
    provider_ref varchar(120) unique : "bu to'lov allaqachon qayd etilgan";
    amount       numeric(14, 2) min(0);
    status       PaymentStatus default PaymentStatus.pending;
    failure_code varchar(60)?;
    created_at   timestamptz default now();

    foreign key (invoice_id) references App.billing.Invoices (id);

    index on (invoice_id, status);
}
