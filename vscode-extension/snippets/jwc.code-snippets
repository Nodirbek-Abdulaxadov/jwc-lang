{
  "Route GET": {
    "prefix": "route-get",
    "body": [
      "route GET \"${1:api/resource}\" {",
      "\ttry {",
      "\t\t${2:// handler}",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "HTTP GET route"
  },

  "Route GET by ID": {
    "prefix": "route-get-id",
    "body": [
      "route GET \"${1:api/resource}/{id}\" {",
      "\ttry {",
      "\t\tlet id = params.id;",
      "\t\tlet item = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @id first;",
      "\t\tif (item) {",
      "\t\t\treturn json(item);",
      "\t\t}",
      "\t\treturn notFound();",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "HTTP GET by ID route"
  },

  "Route POST": {
    "prefix": "route-post",
    "body": [
      "route POST \"${1:api/resource}\" {",
      "\ttry {",
      "\t\tlet data = body();",
      "\t\tlet item = new ${2:Entity}();",
      "\t\t${3:// set fields}",
      "\t\tinsert item into ${4:db}.${5:Table};",
      "\t\treturn created(item);",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "HTTP POST route"
  },

  "Route PUT": {
    "prefix": "route-put",
    "body": [
      "route PUT \"${1:api/resource}/{id}\" {",
      "\ttry {",
      "\t\tlet id = params.id;",
      "\t\tlet existing = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @id first;",
      "\t\tif (existing) {",
      "\t\t\tlet data = body();",
      "\t\t\t${5:// update fields}",
      "\t\t\tupdate existing in ${3:db}.${4:Table};",
      "\t\t\treturn json(existing);",
      "\t\t}",
      "\t\treturn notFound();",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "HTTP PUT route"
  },

  "Route DELETE": {
    "prefix": "route-delete",
    "body": [
      "route DELETE \"${1:api/resource}/{id}\" {",
      "\ttry {",
      "\t\tlet id = params.id;",
      "\t\tlet item = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @id first;",
      "\t\tif (item) {",
      "\t\t\tdelete item from ${3:db}.${4:Table};",
      "\t\t\treturn noContent();",
      "\t\t}",
      "\t\treturn notFound();",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "HTTP DELETE route"
  },

  "Entity": {
    "prefix": "entity",
    "body": [
      "entity ${1:EntityName} of ${2:AppDb} {",
      "\tid int pk autoincrement;",
      "\t${3:field} ${4:varchar(255)};",
      "}"
    ],
    "description": "JWC entity with autoincrement int PK"
  },

  "Entity with UUID PK": {
    "prefix": "entity-uuid",
    "body": [
      "entity ${1:EntityName} of ${2:AppDb} {",
      "\tid uuid pk;",
      "\t${3:name} varchar(255);",
      "}"
    ],
    "description": "JWC entity with UUID primary key"
  },

  "Route WS": {
    "prefix": "route-ws",
    "body": [
      "route WS \"${1:/ws/path}\" {",
      "\twhile (true) {",
      "\t\tlet msg = ws_recv();",
      "\t\tif (msg == null) { break; }",
      "\t\tws_send(msg);",
      "\t}",
      "}"
    ],
    "description": "WebSocket route"
  },

  "Dome": {
    "prefix": "dome",
    "body": [
      "dome ${1:Service} {",
      "\tfunction ${2:method}(${3:params}) {",
      "\t\t${4:// body}",
      "\t}",
      "}"
    ],
    "description": "Dome (static-class) declaration"
  },

  "Transaction": {
    "prefix": "transaction",
    "body": [
      "transaction {",
      "\t${1:// db statements run atomically}",
      "}"
    ],
    "description": "Transaction block"
  },

  "Middleware": {
    "prefix": "middleware",
    "body": [
      "middleware ${1:Name} {",
      "\t${2:// runs before the route handler}",
      "}"
    ],
    "description": "Middleware declaration"
  },

  "Setup main": {
    "prefix": "main-setup",
    "body": [
      "dbcontext ${1:AppDb} : Postgres;",
      "",
      "function main() {",
      "\tsetConnectionString();",
      "}"
    ],
    "description": "main() with dbcontext + env-based connection string"
  },

  "DbContext": {
    "prefix": "dbcontext",
    "body": [
      "dbcontext ${1:AppDbContext} : ${2:Postgres};"
    ],
    "description": "Database context declaration"
  },

  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:params}) {",
      "\t${3:// body}",
      "}"
    ],
    "description": "JWC function declaration"
  },

  "Async Function": {
    "prefix": "afn",
    "body": [
      "async function ${1:name}(${2:params}) {",
      "\t${3:// body}",
      "}"
    ],
    "description": "JWC async function declaration"
  },

  "Select All": {
    "prefix": "sel-all",
    "body": [
      "let ${1:items} = select ${2:Entity} from ${3:db}.${4:Table};"
    ],
    "description": "Select all records from a table"
  },

  "Select by ID": {
    "prefix": "sel-id",
    "body": [
      "let ${1:item} = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @${5:id} first;"
    ],
    "description": "Select a single record by ID"
  },

  "Select with where": {
    "prefix": "sel-where",
    "body": [
      "let ${1:items} = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.${5:field} == @${6:value};"
    ],
    "description": "Select records with a where clause"
  },

  "Insert": {
    "prefix": "db-insert",
    "body": [
      "let ${1:item} = new ${2:Entity}();",
      "${1:item}.${3:field} = ${4:value};",
      "insert ${1:item} into ${5:db}.${6:Table};"
    ],
    "description": "Create and insert a new entity"
  },

  "Update": {
    "prefix": "db-update",
    "body": [
      "${1:item}.${2:field} = ${3:value};",
      "update ${1:item} in ${4:db}.${5:Table};"
    ],
    "description": "Update an entity"
  },

  "Delete": {
    "prefix": "db-delete",
    "body": [
      "delete ${1:item} from ${2:db}.${3:Table};"
    ],
    "description": "Delete an entity"
  },

  "If Null Check": {
    "prefix": "ifn",
    "body": [
      "if (${1:value} == null) {",
      "\treturn notFound();",
      "}"
    ],
    "description": "Null check with notFound response"
  },

  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:// code}",
      "} catch (error) {",
      "\treturn internalError(error.message);",
      "}"
    ],
    "description": "Try-catch block"
  },

  "Validate Body": {
    "prefix": "validate",
    "body": [
      "validate body {",
      "\t${1:field}: required, ${2:minLength(1)};",
      "}"
    ],
    "description": "Body validation block"
  },

  "Main function": {
    "prefix": "main",
    "body": [
      "function main() {",
      "\t${1:// entry point}",
      "}"
    ],
    "description": "Main entry point function"
  },

  "Full CRUD controller": {
    "prefix": "crud",
    "body": [
      "// GET all ${1:items}",
      "route GET \"api/${1:items}\" {",
      "\ttry {",
      "\t\tlet items = select ${2:Entity} from ${3:db}.${4:Table};",
      "\t\treturn json(items);",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}",
      "",
      "// GET by id",
      "route GET \"api/${1:items}/{id}\" {",
      "\ttry {",
      "\t\tlet id = params.id;",
      "\t\tlet item = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @id first;",
      "\t\tif (item) {",
      "\t\t\treturn json(item);",
      "\t\t}",
      "\t\treturn notFound();",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}",
      "",
      "// POST create",
      "route POST \"api/${1:items}\" {",
      "\ttry {",
      "\t\tlet data = body();",
      "\t\tlet item = new ${2:Entity}();",
      "\t\t${5:// item.field = data.field;}",
      "\t\tinsert item into ${3:db}.${4:Table};",
      "\t\treturn created(item);",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}",
      "",
      "// DELETE",
      "route DELETE \"api/${1:items}/{id}\" {",
      "\ttry {",
      "\t\tlet id = params.id;",
      "\t\tlet item = select ${2:Entity} from ${3:db}.${4:Table} where ${2:Entity}.id == @id first;",
      "\t\tif (item) {",
      "\t\t\tdelete item from ${3:db}.${4:Table};",
      "\t\t\treturn noContent();",
      "\t\t}",
      "\t\treturn notFound();",
      "\t} catch (error) {",
      "\t\treturn internalError(error.message);",
      "\t}",
      "}"
    ],
    "description": "Full CRUD routes for an entity"
  },

  "Namespace declaration": {
    "prefix": "namespace",
    "body": ["namespace ${1:my_pkg};", ""],
    "description": "File-scoped namespace declaration"
  },

  "Import a package namespace": {
    "prefix": "import",
    "body": ["import ${1:greet};"],
    "description": "Import another namespace's public members"
  },

  "Public function": {
    "prefix": "pub-fn",
    "body": [
      "public function ${1:name}(${2:params}): ${3:type} {",
      "\t${4:// body}",
      "}"
    ],
    "description": "Public (exported) function"
  },

  "Private function": {
    "prefix": "priv-fn",
    "body": [
      "private function ${1:name}(${2:params}): ${3:type} {",
      "\t${4:// body}",
      "}"
    ],
    "description": "Explicit private function (same as no modifier)"
  },

  "Public middleware": {
    "prefix": "pub-middleware",
    "body": [
      "public middleware ${1:Name} {",
      "\t${2:// return null to continue, return any value to short-circuit}",
      "\treturn null;",
      "}"
    ],
    "description": "Library-exported middleware"
  },

  "Mount a library": {
    "prefix": "mount",
    "body": ["mount ${1:greet}${2: at \"/${3:prefix}\"};"],
    "description": "Activate a library's routes (optionally under a prefix)"
  },

  "Group with prefix + middleware": {
    "prefix": "group",
    "body": [
      "group \"${1:/api}\" use ${2:Mw1}${3:, Mw2} {",
      "\t${4:// route / mount / nested group}",
      "}"
    ],
    "description": "Wrap routes and mounts with shared prefix + middleware chain"
  },

  "Group prefix only": {
    "prefix": "group-prefix",
    "body": [
      "group \"${1:/api}\" {",
      "\t${2:// route / mount / nested group}",
      "}"
    ],
    "description": "Group with prefix, no middleware"
  },

  "Group middleware only": {
    "prefix": "group-use",
    "body": [
      "group use ${1:Mw1}${2:, Mw2} {",
      "\t${3:// route / mount / nested group}",
      "}"
    ],
    "description": "Group with middleware, no prefix"
  }
}
