{
  "name": "jwc-lang",
  "displayName": "JWC Language",
  "description": "JWC (Just Web Code) language support — syntax highlighting, snippets, and LSP-powered diagnostics",
  "version": "0.4.0",
  "publisher": "jwc-extension",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "icon": "icon.png",
  "keywords": [
    "jwc",
    "just web code",
    "backend",
    "web",
    "database",
    "postgres"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Nodirbek-Abdulaxadov/jwc-lang"
  },
  "bugs": {
    "url": "https://github.com/Nodirbek-Abdulaxadov/jwc-lang/issues"
  },
  "homepage": "https://jwc.1kb.uz",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:jwc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jwc",
        "aliases": [
          "JWC",
          "jwc"
        ],
        "extensions": [
          ".jwc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "jwcproj",
        "aliases": [
          "JWC Project"
        ],
        "filenames": [
          "jwcproj.json"
        ],
        "extensions": [
          ".jwcproj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jwc",
        "scopeName": "source.jwc",
        "path": "./syntaxes/jwc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jwc",
        "path": "./snippets/jwc.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "jwc.restartServer",
        "title": "JWC: Restart Language Server"
      },
      {
        "command": "jwc.showOutput",
        "title": "JWC: Show Language Server Output"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "JWC",
      "properties": {
        "jwc.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the jwc-lsp executable. Leave empty to look up `jwc-lsp` on PATH."
        },
        "jwc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the LSP traffic between VS Code and the JWC language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --format=cjs --outfile=out/extension.js --minify",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.0"
  }
}
