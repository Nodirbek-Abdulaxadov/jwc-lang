{
  "name": "jwc-lang",
  "displayName": "JWC Language",
  "description": "JWC (Just Web Code) language support \u2014 syntax highlighting, snippets, and LSP-powered diagnostics for the JWC backend language.",
  "version": "0.9.903",
  "publisher": "jwc-extension",
  "license": "MIT",
  "author": {
    "name": "Nodirbek Abdulaxadov"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#052e2a",
    "theme": "dark"
  },
  "keywords": [
    "jwc",
    "just web code",
    "backend",
    "web",
    "database",
    "postgres",
    "lsp",
    "language server",
    "http",
    "routes",
    "entities",
    "sql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/just-web-code/jwc-lang.git"
  },
  "bugs": {
    "url": "https://github.com/just-web-code/jwc-lang/issues"
  },
  "homepage": "https://jwc.1kb.uz",
  "qna": "https://github.com/just-web-code/jwc-lang/discussions",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jwc",
        "aliases": [
          "JWC",
          "jwc"
        ],
        "extensions": [
          ".jwc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "jwcproj",
        "aliases": [
          "JWC Project"
        ],
        "filenames": [
          "jwcproj.json"
        ],
        "extensions": [
          ".jwcproj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jwc",
        "scopeName": "source.jwc",
        "path": "./syntaxes/jwc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jwc",
        "path": "./snippets/jwc.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "jwc.restartServer",
        "title": "JWC: Restart Language Server"
      },
      {
        "command": "jwc.showOutput",
        "title": "JWC: Show Language Server Output"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "JWC",
      "properties": {
        "jwc.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `jwc` executable, which serves the language server as `jwc lsp`. Leave empty to look up `jwc` on PATH or under ~/.jwc/bin. A path to a standalone `jwc-lsp` is still accepted."
        },
        "jwc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the LSP traffic between the editor and the JWC language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --format=cjs --outfile=out/extension.js --minify",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "ovsx": "^0.10.1",
    "typescript": "^5.4.0"
  }
}
